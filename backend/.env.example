# Application
PORT=3002

# CORS
CORS_ORIGIN=http://localhost:3000

# Database (configure when needed)
DATABASE_URL=postgresql://cailyx:cailyx_dev@localhost:5436/cailyx?schema=public

# JWT (configure when needed)

# ============================================================
# Fetcher module
# ============================================================
FETCHER_TIMEOUT_MS=30000
FETCHER_RETRY_COUNT=3
FETCHER_RETRY_BACKOFF_MS=1000
FETCHER_RATE_LIMIT_PER_DOMAIN_MS=3000
FETCHER_RATE_LIMIT_GLOBAL_PER_SEC=10

# ============================================================
# Technical Audit module
# ============================================================

# Google PageSpeed Insights API key
# Get it from: https://console.cloud.google.com
# 1. Create a project (or use existing)
# 2. Enable "PageSpeed Insights API"
# 3. Go to APIs & Services > Credentials > Create Credentials > API Key
# 4. Restrict the key to PSI API only
# Free tier: 25,000 requests/day
PSI_API_KEY=

# Redis — REQUIRED. The pipeline job queue (technical audit, SEO audit,
# presence discovery, AEO audit) runs on BullMQ/Redis; without it, none of
# those runs can be queued. Also used for caching and recurring scheduling.
# Local dev: docker compose up -d (from Cailyx root) -> Redis on port 6380
# Production: point to your production Redis instance
REDIS_URL=redis://localhost:6380
# ============================================================
# Technical Audit — Severity thresholds (P2 #13, configurable)
# ============================================================
TA_JS_DEPENDENCY_PERCENT=70
TA_JS_CONTENT_LOSS_FAIL=30
TA_LCP_GOOD_MS=2500
TA_LCP_NEEDS_IMPROVEMENT_MS=4000
TA_CLS_GOOD=0.1
TA_CLS_NEEDS_IMPROVEMENT=0.25
TA_INP_GOOD_MS=200
TA_INP_NEEDS_IMPROVEMENT_MS=500

# Max cost per audit run in USD (P2 #15)
TA_MAX_COST_PER_RUN=5.00

# Auth — operator JWT (set a real random secret in production)
JWT_SECRET=replace-with-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Measurement — surface adapters (keys required for real runs)
#ANTHROPIC_API_KEY=your-key
#PERPLEXITY_API_KEY=your-key
MEASUREMENT_CLAUDE_MODEL=claude-opus-5
MEASUREMENT_PERPLEXITY_MODEL=sonar
MEASUREMENT_MAX_COST_PER_RUN=5.00
#MEASUREMENT_ALLOW_MOCK=1  # test-only deterministic adapter — never set in prod

# ============================================================
# Swarm layer — synthetic-buyer research agents
# ============================================================

# Persona (Agent #1) — deterministic generator; LLM refinement reuses ANTHROPIC_API_KEY
PERSONA_MAX_PER_PROJECT=100        # hard cap on personas per project (fan-out guard)
PERSONA_MAX_COST_PER_GENERATE=1.00 # USD budget for the LLM refinement pass of one generate() call
PERSONA_LLM_MODEL=claude-opus-5

# Journey (Agent #2) — branching search journeys through the surface adapters
# Master switch: journeys/campaigns may ONLY touch a live AI surface (spend real
# money) when this is exactly "1". Unset/anything else = mock adapter only.
SWARM_ALLOW_LIVE=0
JOURNEY_MAX_COST_PER_RUN=2.00      # USD cap for one journey execution (remaining steps → skipped)
JOURNEY_LLM_MODEL=claude-opus-5    # used only when a plan/campaign is created with useLlm:true

# Internal-Link (Agent #8) — crawls the client's OWN site via FetcherService
INTERNAL_LINK_MAX_PAGES=50
INTERNAL_LINK_LLM_MODEL=claude-opus-5   # anchor-copy refinement only; reuses ANTHROPIC_API_KEY
#INTERNAL_LINK_ALLOW_FIXTURE=1          # offline smoke harness — enables fixture:// crawl roots

# Council (Agent #10) — multi-agent intervention debate (deterministic by default)
COUNCIL_LLM_MODEL=claude-opus-5      # used only with useLlm:true; reuses ANTHROPIC_API_KEY
COUNCIL_MAX_COST_PER_RUN=1.00

# SERP Intelligence (Agent #3) — LICENSED SERP data via DataForSEO (no scraping)
# Also used by keyword-research (wave-6 step 4, DataForSEO Keywords Data) —
# same account, same SWARM_ALLOW_LIVE gate, no separate credentials needed.
# Live capture needs SWARM_ALLOW_LIVE=1 AND these credentials:
#DATAFORSEO_LOGIN=your-dataforseo-login
#DATAFORSEO_PASSWORD=your-dataforseo-password
SERP_MAX_COST_PER_CAPTURE=5.00
#SERP_ALLOW_FIXTURE=1   # offline smoke harness — enables the canned-SERP provider
# keyword-research makes at most two DataForSEO calls per run (seed volumes +
# related-keyword expansion), each already bounded by a 200/20 keyword-count
# DTO cap — this is the dollar ceiling an audit found had no counterpart to
# SERP_MAX_COST_PER_CAPTURE above. Checked between the two calls; the related-
# keyword expansion is skipped (not the whole run failed) once reached.
KEYWORD_RESEARCH_MAX_COST_PER_RUN=5.00

# Authority (Agent #6) — legitimate-mention discovery (SERP listicles + AI citations + optional LLM)
AUTHORITY_LLM_MODEL=claude-opus-5    # method=llm / useLlm only; reuses ANTHROPIC_API_KEY
AUTHORITY_MAX_COST_PER_SCAN=1.50

# ─── Technical audit ────────────────────────────────────────────────────────
# Google PageSpeed Insights. Without it the Lighthouse/CWV check fails; every
# other check still runs. Free tier: 25,000 req/day.
PSI_API_KEY=

# LLM commentary on each audit run (OpenRouter). Optional — with no key the
# audit is unchanged and `narrative` is simply null.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Set to "false" to disable the narrative without removing the key.
AUDIT_NARRATIVE=true

# Agent-readiness check. Spawns `npx is-agentic <domain> --json`, which needs
# npm network egress. NOTE: is-agentic publishes a PUBLIC report page at
# is-agentic.com/scan/<domain>. Set to "false" to disable the scan entirely.
AGENT_READINESS_CLI=true
AGENT_READINESS_TIMEOUT_MS=180000

# Site-wide page crawl. "Every page in the sitemap" is unbounded, so a run is
# capped and pages are taken newest-<lastmod>-first.
TA_PAGE_CRAWL_BUDGET=150
TA_PAGE_CRAWL_CONCURRENCY=6
# A sitemap whose newest <lastmod> is older than this counts as unmaintained.
TA_SITEMAP_STALE_DAYS=90

# Recurring audits. "cron" runs them in-process (no Redis). Set to "bullmq" to
# hand recurring runs to the queue instead — never arm both.
SCHEDULING_BACKEND=cron

# ── Google Search Console + Analytics (modules/google) ───────────────────────
# 3-legged OAuth. Leave blank and the connect flow returns a clean 503; drop in
# a client id + secret from a Google Cloud project with the "Google Search
# Console API" and "Google Analytics Admin API" + "Google Analytics Data API"
# enabled, then add GOOGLE_OAUTH_REDIRECT_URI (below) to that OAuth client's
# authorised redirect URIs. Restart — nothing else changes.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match an authorised redirect URI on the OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3002/api/integrations/google/callback
# Where the callback sends the browser after tokens are stored.
GOOGLE_OAUTH_SUCCESS_REDIRECT=http://localhost:3000/v2
# 32-byte key for AES-256-GCM token-at-rest encryption (64 hex chars, or
# base64 of 32 bytes). Optional in dev — a key is derived from JWT_SECRET with
# a warning. REQUIRED in production. Generate: openssl rand -hex 32
GOOGLE_TOKEN_ENC_KEY=

# ── SEO audit (modules/seo-audit) ───────────────────────────────────────────
# Reads Search Console. Caps the number of URL Inspection API calls per run
# (Google's quota is 2000/day, 600/min). The audit picks the highest-traffic
# ranking URLs up to this budget.
SEO_INSPECT_BUDGET=40

# ============================================================
# AEO Audit module — answer-engine visibility (ChatGPT first)
# Analysis + decisions: docs/analysis/aeo-audit.md
# ============================================================

# --- Answer-engine surfaces: ChatGPT, Perplexity, Gemini (decision D1-B) ----
#
# SEARCH happens in a headless browser, driving each vendor's CONSUMER PRODUCT
# with a session YOU supply. An API answer is not what a buyer sees, and this
# audit is about what buyers see. (ANALYSIS — context synthesis, prompt phrasing,
# stance judging — goes through OpenRouter instead; see the block below.)
#
# Automating these products is against their Terms of Use (OpenAI, Perplexity and
# Google alike). The risk — account suspension, IP blocks — sits with whoever
# supplies the session. Point them only at accounts you control. NEVER a client's.
#
# The adapters do NOT solve CAPTCHAs, spoof fingerprints, or handle passwords:
# on a challenge or block they fail the observation with a typed reason and stop.
#
# Cloro (cloro.dev) — the default way to measure ChatGPT / Perplexity / Gemini /
# Google AI Overview / Google AI Mode: it queries the CONSUMER products on our
# behalf via API, same motivation as the browser surfaces below ("an API answer
# is not what a buyer sees") without the ToS exposure of automating a session
# ourselves. Select with surfaces cloro-chatgpt / cloro-perplexity / cloro-gemini
# / cloro-ai-overview / cloro-ai-mode. A failed cloro-* surface automatically
# retries once on its *-browser equivalent below, but only if that is enabled.
CLORO_API_KEY=
# Price per credit, used only to compute a reported costUsd — the actual free-
# tier spend is $0. 0.0004 is the Hobby-plan rate; update if you're on a
# different plan.
CLORO_CREDIT_USD=0.0004
# Simultaneous Cloro tasks. 1 is the free tier's limit and the safe default —
# raise it only to what your plan actually allows, or Cloro starts rejecting
# tasks mid-run.
CLORO_MAX_CONCURRENCY=1

# One master switch, then one session file per engine. An engine with no session
# fails closed and is reported as "not measured" — it never drags an average down.
AEO_ALLOW_BROWSER_SURFACE=0

# Create each session file once by signing in manually:
#   const ctx = await (await chromium.launch({headless:false})).newContext();
#   await (await ctx.newPage()).goto('https://chatgpt.com/');   // sign in, then:
#   await ctx.storageState({ path: '/abs/path/chatgpt-session.json' });
#AEO_CHATGPT_SESSION_PATH=/abs/path/chatgpt-session.json
#AEO_PERPLEXITY_SESSION_PATH=/abs/path/perplexity-session.json
#AEO_GEMINI_SESSION_PATH=/abs/path/gemini-session.json

# Which engines an audit measures when none are named in the request.
# Comma-separated, from: chatgpt-browser, perplexity-browser, gemini-browser,
# cloro-chatgpt, cloro-perplexity, cloro-gemini, cloro-ai-overview, cloro-ai-mode, mock.
AEO_SURFACES=chatgpt-browser

# 0 shows the browser window — use this on the first live run, and whenever an
# engine reports "selector-drift", to see what the page is actually doing.
AEO_BROWSER_HEADLESS=1

# Per-engine overrides (defaults shown). The gap is politeness, not evasion —
# hammering an engine is both rude and the fastest route to a block.
AEO_CHATGPT_URL=https://chatgpt.com/
AEO_CHATGPT_TIMEOUT_MS=120000
AEO_CHATGPT_MIN_GAP_MS=8000
#AEO_PERPLEXITY_URL=https://www.perplexity.ai/
#AEO_PERPLEXITY_TIMEOUT_MS=120000
#AEO_PERPLEXITY_MIN_GAP_MS=8000
#AEO_GEMINI_URL=https://gemini.google.com/app
#AEO_GEMINI_TIMEOUT_MS=120000
#AEO_GEMINI_MIN_GAP_MS=8000

# --- Matrix + cost -----------------------------------------------------------
# scorecard=25 | standard=100 | full=300 prompts. Calls = prompts x runCount x
# ENGINES, and runCount has a hard floor of 5 (n>=5, no exceptions). Three engines
# at the standard tier is 1,500 questions — budget the time, not just the money.
AEO_MATRIX_TIER=standard
# USD ceiling per audit. Exceeding it stops the run and records the reason.
AEO_MAX_COST_PER_AUDIT=10.00
AEO_CONTEXT_MAX_PAGES=12

# --- LLM analysis passes (context synthesis, matrix phrasing, stance judging) --
#
# Provider order: OPENROUTER_API_KEY (preferred) -> ANTHROPIC_API_KEY (fallback).
#
# With neither key set every pass degrades honestly: context falls back to
# deterministic extraction, the matrix keeps its template phrasing, and the
# stance pass returns 503 rather than inventing verdicts. Counted metrics
# (mention rate, citation rate, share of voice) never depended on a model.
#
# Default model was chosen by benchmarking candidates on the module's REAL
# stance task (absent / led / placed-behind / warned-about), not on price:
#   qwen3-30b-a3b-instruct-2507  4/4  1.5s   $0.048/$0.193 per Mtok  <- default
#   openai/gpt-oss-120b          4/4  7.7s   $0.037/$0.170  (5x slower)
#   google/gemini-2.5-flash-lite 3/4  1.1s   $0.100/$0.400  (failed "absent")
#   openai/gpt-5-nano            0/4  16s    $0.050/$0.400  (truncates JSON)
# Re-run that comparison before changing this — "absent" is the case that must
# not regress, since getting it wrong turns invisibility into a false mention.
AEO_LLM_MODEL=deepseek/deepseek-v4.1-flash
AEO_LLM_TIMEOUT_MS=60000
# Sent as OpenRouter's HTTP-Referer attribution header.
AEO_LLM_REFERER=https://cailyx.local
# Used only on the Anthropic fallback path.
AEO_STANCE_JUDGE_MODEL=claude-opus-5

# digital-presence's own LLM caller (presence.llm.service.ts) — brand-voice
# synthesis from Apify captions (POST .../presence/brand-voice). Same
# provider order and honest-degradation discipline as AEO_LLM_* above: no
# key configured -> extraction stays "insufficient-data", never a guessed voice.
PRESENCE_LLM_MODEL=deepseek/deepseek-v4.1-flash
PRESENCE_LLM_TIMEOUT_MS=60000
# Used only on the Anthropic fallback path.
PRESENCE_LLM_ANTHROPIC_MODEL=claude-opus-5

# Google SERP is served by DataForSEO (DATAFORSEO_LOGIN / DATAFORSEO_PASSWORD),
# the same funded account behind serp-intelligence and keyword-research. It was
# Serper.dev — a second vendor at a higher per-query price for a search this
# account already covers. No key of its own is needed here.
#
# Not configured, or SWARM_ALLOW_LIVE unset -> the sweep skips with a stated
# reason; the free site crawl is unaffected. Opt-in per run (`searchWeb: true`),
# so a default scan and the whole smoke harness stay at zero spend.
#
# Credit control, in order of effect:
#   1. responses cache 7 days — a `site:` result does not move hour to hour
#   2. this cap bounds total queries per sweep (platforms x name variants)
#   3. depth is fixed at 10 — DataForSEO bills per 10 results, 20 costs double
#   4. only platforms still missing after the crawl are searched at all
PRESENCE_SERP_MAX_QUERIES=20

# Business Data (wave-6 D2) — Google My Business profile (hours, categories,
# rating) + Google/Trustpilot/Yelp review counts. Same vendor + auth
# convention as SERP Intelligence above: reuses DATAFORSEO_LOGIN/_PASSWORD and
# the SWARM_ALLOW_LIVE=1 master switch. Absent -> POST .../presence/business-
# profile returns a 503 naming exactly what is missing; nothing is invented in
# its place. NOT set in this environment today.
# Default market for the business-profile lookup when the project has none on
# record. A single generic fallback, not a full market-resolution pass (D8 in
# wave-6-audit-pipeline.md is a separate, AEO-scoped decision).
PRESENCE_BUSINESS_LOCATION=United States

# Social activity (wave-6 D7) — Apify actors for posting cadence, followers,
# engagement (never printed, never logged). Configuring the key is NOT
# enough to spend anything: every
# run also requires `confirmSpend: true` on the request body — a default/
# automatic scan must never bill the account's $5/month usage credit by
# accident, the same contract `searchWeb` already keeps for the Google sweep.
#APIFY_API_KEY=
# platform:role -> actorId, JSON. Overrides/extends the built-in defaults from
# D7's actor table; a malformed value is logged and ignored (falls back to the
# built-in map) rather than failing the whole module.
#APIFY_ACTORS={"linkedin:company":"harvestapi/linkedin-company"}
# Platforms pulled when a request does not name its own. D7's default set —
# youtube/tiktok are supported but off by default (env-driven if a client's
# vertical needs them).
APIFY_PLATFORMS=linkedin,instagram,facebook,twitter
# How many recent posts to pull per platform per run. D7's cost table is
# priced against 20.
APIFY_POSTS_PER_PLATFORM=20

# ============================================================
# Delivery module + clients module — Plunk transactional email
# ============================================================
# Plunk (useplunk.com) issues two keys — use the SECRET key here, never the
# public one. The secret key authenticates server-side sends
# (https://api.useplunk.com/v1/send); the public key is only for client-side
# event tracking, which nothing in this backend does. (Never printed, never
# logged.)
#PLUNK_SECRET_KEY=
# Not currently read by any send call (Plunk falls back to the project's own
# verified sender when omitted) — documented here for when a caller-visible
# "From" identity is wired in.
#PLUNK_SENDER_EMAIL=
# Only relevant to a future client-side integration (e.g. a marketing-site
# `plunk.track()` call) — the backend never sends with this key.
#PLUNK_PUBLIC_KEY=

# `delivery` module only — Stripe Checkout links per tier (option A: a
# ledger keyed off these URLs, not a full Stripe SDK integration; see
# delivery/README.md). Absent -> the checkout-click endpoints 503.
#STRIPE_CHECKOUT_URL_FULL=
#STRIPE_CHECKOUT_URL_MONITORING=
