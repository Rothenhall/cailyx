# Application
PORT=3002

# CORS
CORS_ORIGIN=http://localhost:3000

# Database (configure when needed)
DATABASE_URL=postgresql://cailyx:cailyx_dev@localhost:5436/cailyx?schema=public

# JWT (configure when needed)

# ============================================================
# Fetcher module
# ============================================================
FETCHER_TIMEOUT_MS=30000
FETCHER_RETRY_COUNT=3
FETCHER_RETRY_BACKOFF_MS=1000
FETCHER_RATE_LIMIT_PER_DOMAIN_MS=3000
FETCHER_RATE_LIMIT_GLOBAL_PER_SEC=10

# ============================================================
# Technical Audit module
# ============================================================

# Google PageSpeed Insights API key
# Get it from: https://console.cloud.google.com
# 1. Create a project (or use existing)
# 2. Enable "PageSpeed Insights API"
# 3. Go to APIs & Services > Credentials > Create Credentials > API Key
# 4. Restrict the key to PSI API only
# Free tier: 25,000 requests/day
PSI_API_KEY=

# Redis (for caching + job queue + scheduling)
# Local dev: docker compose up -d (from Cailyx root) -> Redis on port 6380
# Production: point to your production Redis instance
REDIS_URL=redis://localhost:6380
# ============================================================
# Technical Audit — Severity thresholds (P2 #13, configurable)
# ============================================================
TA_JS_DEPENDENCY_PERCENT=70
TA_JS_CONTENT_LOSS_FAIL=30
TA_LCP_GOOD_MS=2500
TA_LCP_NEEDS_IMPROVEMENT_MS=4000
TA_CLS_GOOD=0.1
TA_CLS_NEEDS_IMPROVEMENT=0.25
TA_INP_GOOD_MS=200
TA_INP_NEEDS_IMPROVEMENT_MS=500

# Max cost per audit run in USD (P2 #15)
TA_MAX_COST_PER_RUN=5.00

# Auth — operator JWT (set a real random secret in production)
JWT_SECRET=replace-with-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Measurement — surface adapters (keys required for real runs)
#ANTHROPIC_API_KEY=your-key
#PERPLEXITY_API_KEY=your-key
MEASUREMENT_CLAUDE_MODEL=claude-opus-5
MEASUREMENT_PERPLEXITY_MODEL=sonar
MEASUREMENT_MAX_COST_PER_RUN=5.00
#MEASUREMENT_ALLOW_MOCK=1  # test-only deterministic adapter — never set in prod
