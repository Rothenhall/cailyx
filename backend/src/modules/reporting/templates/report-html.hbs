<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {{#if document.noindex}}<meta name="robots" content="noindex, nofollow">{{/if}}
  <title>{{document.cover.title}} — AI Visibility Diagnostic</title>
  <style>
    :root{
      --canvas:#f7f3ea; --paper:#fbf9f3; --ink:#1a1712;
      --ink-60:#5c5648; --line:#ddd5c4;
      --accent:#a85c30; --accent-deep:#8a4a26;
      --good:#5f6a42; --warn:#b79a6b; --bad:#c0392b;
      --font: "Inter", ui-sans-serif, system-ui, sans-serif;
    }
    *{box-sizing:border-box}
    body{margin:0; background:var(--canvas); color:#1a1712; font-family:var(--font); line-height:1.6; -webkit-print-color-adjust:exact}
    .wrap{max-width:860px; margin:0 auto; padding:40px 24px}
    header{border-bottom:2px solid var(--accent); padding-bottom:16px; margin-bottom:32px}
    .eyebrow{font-size:12px; letter-spacing:.14em; text-transform:uppercase; color:var(--accent-deep); margin:0 0 6px}
    h1{font-size:28px; margin:0 0 4px; font-weight:500}
    .url{color:var(--ink-60); font-size:14px}
    .band{display:inline-block; padding:2px 12px; border-radius:12px; font-size:13px; font-weight:600; text-transform:uppercase; letter-spacing:.06em; margin-left:8px}
    .band-recommended{background:#e5ecdb; color:var(--good)}
    .band-present{background:#f4ecd8; color:#8a6d1f}
    .band-faint{background:#f7e4cb; color:var(--accent-deep)}
    .band-invisible{background:#f5d5d1; color:var(--bad)}
    .score-hero{display:flex; gap:24px; align-items:center; background:var(--paper); border:1px solid var(--line); border-radius:8px; padding:24px; margin-bottom:28px}
    .dial{width:120px; height:120px; border-radius:50%; display:flex; flex-direction:column; align-items:center; justify-content:center; flex-shrink:0}
    .dial-num{font-size:36px; font-weight:700; line-height:1}
    .dial-cap{font-size:11px; color:var(--ink-60); text-transform:uppercase; letter-spacing:.1em}
    .summary{white-space:pre-line; font-size:15px}
    h2{font-size:18px; border-bottom:1px solid var(--line); padding-bottom:6px; margin:32px 0 12px}
    .sub-scores{display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:12px; margin-bottom:8px}
    .sub{background:var(--paper); border:1px solid var(--line); border-radius:6px; padding:12px}
    .sub .dim{font-size:12px; text-transform:uppercase; letter-spacing:.08em; color:var(--ink-60)}
    .sub .val{font-size:22px; font-weight:700; margin:4px 0}
    .sub .bar{height:5px; background:var(--line); border-radius:3px; overflow:hidden; margin-top:6px}
    .sub .bar span{display:block; height:100%; background:var(--accent)}
    .sub .ev{font-size:11px; color:var(--ink-60); margin-top:6px; white-space:pre-line}
    table{width:100%; border-collapse:collapse; font-size:14px; margin-bottom:12px}
    th,td{text-align:left; padding:8px 10px; border-bottom:1px solid var(--line); vertical-align:top}
    th{font-size:12px; text-transform:uppercase; letter-spacing:.06em; color:var(--ink-60)}
    /* Value tones come from the shared document model, so a status is coloured
       by the same decision in the HTML page and in the PDF. */
    .tone-good{color:var(--good); font-weight:600}
    .tone-bad{color:var(--bad); font-weight:600}
    .tone-warn{color:var(--accent-deep); font-weight:600}
    .tone-muted{color:var(--ink-60)}
    .tone-accent{color:var(--accent-deep); font-weight:600}
    .tone-default{color:var(--ink)}
    .note{font-size:13px; color:var(--ink-60)}
    .partial{color:var(--accent-deep)}
    .index{margin:0 0 12px; padding-left:20px}
    .index li{font-size:14px}
    .index .missing{color:var(--ink-60)}
    .pill{display:inline-block; background:var(--paper); border:1px solid var(--line); border-radius:10px; padding:1px 9px; font-size:12px; margin:2px 4px 2px 0}
    .pill-gap{border-color:var(--bad); color:var(--bad)}
    .fix{font-size:13px; color:var(--ink-60)}
    pre.repro{background:#201c15; color:#e8dfc8; padding:12px; border-radius:6px; font-size:12px; overflow-x:auto}
    details{margin-bottom:8px}
    summary{cursor:pointer; font-size:13px; color:var(--accent-deep)}
    footer{margin-top:40px; padding-top:16px; border-top:1px solid var(--line); font-size:12px; color:var(--ink-60)}
    @media print{
      .wrap{padding:0}
      .score-hero{break-inside:avoid}
    }
  </style>
</head>
<body>
<div class="wrap">
  <header>
    <p class="eyebrow">{{document.cover.orgName}} — AI Visibility Diagnostic</p>
    <h1>{{document.cover.title}}
      <span class="band band-{{document.cover.band}}">{{document.cover.band}}</span>
    </h1>
    <div class="url">{{document.cover.targetUrl}}</div>
  </header>

  <div class="score-hero">
    <div class="dial">
      <div class="dial-num">{{document.score.total}}</div>
      <div class="dial-cap">of 100</div>
    </div>
    <div class="summary">{{document.executiveSummary}}</div>
  </div>

  {{#if document.cover.releaseLine}}
  <p class="note">{{document.cover.releaseLine}}</p>
  {{/if}}

  {{#if document.sectionIndex}}
  <h2>Contents</h2>
  <ol class="index">
    {{#each document.sectionIndex}}
    <li><a href="#{{anchor}}">{{title}}</a>{{#unless present}} <span class="missing">— not included in this report</span>{{/unless}}</li>
    {{/each}}
  </ol>
  {{/if}}

  {{! ── Score breakdown (every view) ───────────────────────────── }}
  {{#if_eq document.decisions.scoreBreakdown.mode "body"}}
  <h2 id="section-scoreBreakdown">Score breakdown</h2>
  <p class="note">{{document.score.provenanceNote}}</p>
  <div class="sub-scores">
    {{#each document.score.subScores}}
    <div class="sub">
      <div class="dim">{{dimension}} · {{weightLabel}}</div>
      <div class="val">{{valueLabel}}</div>
      <div class="bar"><span style="width:{{barPercent}}%"></span></div>
      <div class="ev">Contribution: {{contributionLabel}}</div>
      <div class="ev">{{#each evidence}}- {{this}}
{{/each}}</div>
      {{#if partialNote}}<div class="ev partial">{{partialNote}}</div>{{/if}}
    </div>
    {{/each}}
  </div>
  <p class="note">{{document.score.bandNote}}</p>
  {{/if_eq}}

  {{! ── Findings ──────────────────────────────────────────────── }}
  {{#if_eq document.decisions.findings.mode "omit"}}{{else}}
  <h2 id="section-findings">Findings</h2>
  {{#if_eq document.decisions.findingsTable.mode "note"}}
  <p class="note">{{document.decisions.findingsTable.note}}</p>
  {{/if_eq}}
  {{#if_eq document.decisions.findingsTable.mode "body"}}
  <table>
    <thead><tr><th>Check</th><th>Status</th><th>Severity</th><th>Confidence</th></tr></thead>
    <tbody>
    {{#each document.findings}}
      <tr>
        <td><strong>{{label}}</strong><div class="fix">{{recommendedFix}}</div>
          {{#if reproduction}}
          <details><summary>Reproduce</summary>
            {{#each reproduction}}
            <pre class="repro">{{command}}  # {{expectedResult}}  (bot: {{bot}})</pre>
            {{/each}}
          </details>
          {{/if}}
        </td>
        <td class="tone-{{statusTone}}">{{status}}</td>
        <td class="tone-{{severityTone}}">{{severity}}</td>
        <td>{{confidence}}</td>
      </tr>
    {{/each}}
    </tbody>
  </table>
  {{/if_eq}}
  {{/if_eq}}

  {{! ── Roadmap ───────────────────────────────────────────────── }}
  {{#if_eq document.decisions.roadmap.mode "omit"}}{{else}}
  <h2 id="section-roadmap">Roadmap</h2>
  {{#if_eq document.decisions.roadmapTable.mode "note"}}
  <p class="note">{{document.decisions.roadmapTable.note}}</p>
  {{/if_eq}}
  {{#if_eq document.decisions.roadmapTable.mode "body"}}
  <table>
    <thead><tr><th>Action</th><th>Dimension</th><th>Item</th><th>Priority</th><th>Status</th></tr></thead>
    <tbody>
    {{#each document.roadmap}}
      <tr>
        <td>{{action}}</td>
        <td>{{dimension}}</td>
        <td><strong>{{title}}</strong><div class="fix">{{description}}</div></td>
        <td class="{{#unless prioritySet}}tone-muted{{/unless}}">{{priorityLabel}}</td>
        <td class="tone-{{statusTone}}">{{status}}</td>
      </tr>
    {{/each}}
    </tbody>
  </table>
  {{/if_eq}}
  {{/if_eq}}

  {{! ── Social & directory presence ───────────────────────────── }}
  {{#if_eq document.decisions.presence.mode "omit"}}{{else}}
  <h2 id="section-presence">Social &amp; Directory Presence</h2>
  {{#if_eq document.decisions.presence.mode "note"}}
  <p class="note">{{document.decisions.presence.note}}</p>
  {{/if_eq}}
  {{#if_eq document.decisions.presence.mode "body"}}
  <div class="sub-scores">
    {{#each document.presence.metrics}}
    <div class="sub">
      <div class="dim">{{label}}</div>
      <div class="val{{#unless measured}} tone-muted{{/unless}}">{{value}}</div>
      {{#if unit}}<div class="ev">{{unit}}</div>{{/if}}
    </div>
    {{/each}}
  </div>
  {{#if document.presence.lastRunNote}}<p class="note">{{document.presence.lastRunNote}}</p>{{/if}}
  {{#if_eq document.decisions.presenceAccounts.mode "note"}}
  <p class="note">{{document.decisions.presenceAccounts.note}}</p>
  {{/if_eq}}
  {{#if_eq document.decisions.presenceAccounts.mode "body"}}
  <table>
    <thead><tr><th>Platform</th><th>Status</th><th>Handle</th><th>Note</th></tr></thead>
    <tbody>
    {{#each document.presence.accounts}}
      <tr>
        <td><strong>{{label}}</strong><div class="fix">{{group}}</div></td>
        <td class="tone-{{stateTone}}">{{state}}{{#if nameMismatch}} <span class="tone-accent">· name mismatch</span>{{/if}}</td>
        <td>{{handleLabel}}</td>
        <td class="fix">{{note}}</td>
      </tr>
    {{/each}}
    </tbody>
  </table>
  {{/if_eq}}
  {{#if_eq document.decisions.presenceGaps.mode "note"}}
  <p class="note">{{document.decisions.presenceGaps.note}}</p>
  {{/if_eq}}
  {{#if_eq document.decisions.presenceGaps.mode "body"}}
  <p>Expected but not found:
    {{#each document.presence.gaps}}<span class="pill pill-gap">{{this}}</span>{{/each}}
  </p>
  {{/if_eq}}
  {{/if_eq}}
  {{/if_eq}}

  {{! ── Competitor landscape ──────────────────────────────────── }}
  {{#if_eq document.decisions.competitors.mode "omit"}}{{else}}
  <h2 id="section-competitors">Competitor Landscape</h2>
  {{#if_eq document.decisions.competitors.mode "note"}}
  <p class="note">{{document.decisions.competitors.note}}</p>
  {{/if_eq}}
  {{#if_eq document.decisions.competitors.mode "body"}}
  <p class="fix">Your homepage SEO score: <strong>{{document.competitors.clientSeoLabel}}</strong>{{#if document.competitors.clientIssues}} — issues: {{#each document.competitors.clientIssues}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{/if}}</p>
  {{#if_eq document.decisions.competitorsOnly.mode "body"}}
  <p>Platforms where a tracked competitor has a presence and you don't:
    {{#each document.competitors.competitorsOnly}}<span class="pill pill-gap">{{this}}</span>{{/each}}
  </p>
  {{/if_eq}}
  {{#if_eq document.decisions.competitorsTable.mode "note"}}
  <p class="note">{{document.decisions.competitorsTable.note}}</p>
  {{/if_eq}}
  {{#if_eq document.decisions.competitorsTable.mode "body"}}
  <table>
    <thead><tr><th>Competitor</th><th>SEO score</th><th>Top issues</th><th>Found on</th></tr></thead>
    <tbody>
    {{#each document.competitors.rows}}
      <tr>
        <td><strong>{{name}}</strong><div class="fix">{{domain}}</div></td>
        <td>{{seoScoreLabel}}</td>
        <td class="fix">{{seoIssues}}</td>
        <td>{{#each presencePlatforms}}<span class="pill">{{this}}</span>{{/each}}</td>
      </tr>
    {{/each}}
    </tbody>
  </table>
  {{/if_eq}}
  <p class="note">{{document.competitors.provenanceNote}}</p>
  {{/if_eq}}
  {{/if_eq}}

  {{! ── Prioritized growth roadmap ────────────────────────────── }}
  {{#if_eq document.decisions.growthPlan.mode "omit"}}{{else}}
  <h2 id="section-growthPlan">Prioritized Growth Roadmap</h2>
  {{#if_eq document.decisions.growthPlan.mode "note"}}
  <p class="note">{{document.decisions.growthPlan.note}}</p>
  {{/if_eq}}
  {{#if_eq document.decisions.growthPlan.mode "body"}}
  {{#if_eq document.decisions.growthPlanActionPlan.mode "note"}}
  <p class="note">{{document.decisions.growthPlanActionPlan.note}}</p>
  {{/if_eq}}
  {{#if_eq document.decisions.growthPlanActionPlan.mode "body"}}
  <table>
    <thead><tr><th>Priority</th><th>Recommended Action</th><th>Quick wins</th><th>Major projects</th></tr></thead>
    <tbody>
    {{#each document.growthPlan.actionPlan}}
      <tr>
        <td>{{priorityRank}}</td>
        <td><strong>{{title}}</strong><div class="fix">{{summary}}</div></td>
        <td>{{quickWinCount}}</td>
        <td>{{majorProjectCount}}</td>
      </tr>
    {{/each}}
    </tbody>
  </table>
  {{/if_eq}}
  {{#if document.growthPlan.notCovered}}
  <p class="note">No open gap in: {{#each document.growthPlan.notCovered}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}.</p>
  {{/if}}
  {{#if document.growthPlan.actionPlanUpdatedAt}}
  <p class="note">Action plan built {{document.growthPlan.actionPlanUpdatedAt}}.</p>
  {{/if}}

  {{#if_eq document.decisions.growthPlanFindingsCopy.mode "body"}}
  <h3>Issue + Evidence (detailed)</h3>
  {{#each document.growthPlan.findingsCopy}}
  <div class="ev">
    <strong>{{title}}</strong>{{#if thinRun}} <span class="tone-accent">(thin evidence)</span>{{/if}}
    <p>{{whatExecutive}}</p>
    <p><em>Why:</em> {{whyExecutive}}</p>
    <p><em>Fix (implementation guidance):</em> {{fixExecutive}}</p>
    {{#if disclosedGap}}<p class="note">Disclosed gap: {{disclosedGap}}</p>{{/if}}
  </div>
  {{/each}}
  {{/if_eq}}

  {{#if document.growthPlan.assetsNote}}<p class="note">{{document.growthPlan.assetsNote}}</p>{{/if}}
  {{/if_eq}}
  {{/if_eq}}

  {{! ── Backlinks ─────────────────────────────────────────────── }}
  {{#if_eq document.decisions.backlinks.mode "omit"}}{{else}}
  <h2 id="section-backlinks">Backlinks</h2>
  {{#if_eq document.decisions.backlinks.mode "note"}}
  <p class="note">{{document.decisions.backlinks.note}}</p>
  {{/if_eq}}
  {{#if_eq document.decisions.backlinks.mode "body"}}
  {{#if document.backlinks.statusNote}}
  <p class="note tone-{{document.backlinks.statusTone}}">{{document.backlinks.statusNote}}</p>
  {{/if}}
  {{#if_eq document.decisions.backlinksMetrics.mode "body"}}
  <div class="sub-scores">
    {{#each document.backlinks.metrics}}
    <div class="sub">
      <div class="dim">{{label}}</div>
      <div class="val{{#unless measured}} tone-muted{{/unless}}">{{value}}</div>
      {{#if unit}}<div class="ev">{{unit}}</div>{{/if}}
    </div>
    {{/each}}
  </div>
  {{/if_eq}}
  {{#if_eq document.decisions.backlinksTop.mode "body"}}
  <table>
    <thead><tr><th>Source</th><th>Anchor</th><th>Follow</th><th>Domain Rank</th><th>First Seen</th></tr></thead>
    <tbody>
    {{#each document.backlinks.top}}
      <tr>
        <td>{{urlFrom}}</td>
        <td>{{anchorLabel}}</td>
        <td class="tone-{{followTone}}">{{followLabel}}</td>
        <td>{{domainRankLabel}}</td>
        <td>{{firstSeenLabel}}</td>
      </tr>
    {{/each}}
    </tbody>
  </table>
  {{/if_eq}}
  <p class="note">{{document.backlinks.provenanceNote}}</p>
  {{/if_eq}}
  {{/if_eq}}

  <footer>
    {{#each document.footer.lines}}{{this}}<br>{{/each}}
  </footer>
</div>
</body>
</html>
