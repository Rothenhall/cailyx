{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoots": [
    "src"
  ],
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules/reporting/assets/**/*",
        "outDir": "dist"
      }
    ],
    "watchAssets": true
  }
}
