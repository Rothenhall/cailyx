// Cailyx Prisma Schema
// Database: Supabase Postgres — the same database production (Railway) uses.
// SQLite (prisma/dev.db) is retired as of 2026-09-16; every environment now
// shares this one datasource. See prisma/schema.production.prisma's header
// for why a second, mechanically-identical file still exists (Railway's
// backend build/start commands still point at it explicitly — kept in sync
// by hand rather than repointing that deploy without asking first).

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  // Read from the environment rather than hardcoded, so a scratch database can
  // be pointed at without editing this file — which is what makes it possible
  // to verify against a copy of real data without writing to the real file.
  // `.env` sets the development default.
  url      = env("DATABASE_URL")
}

// ─── Technical Audit ───────────────────────────────────────────

model TechnicalAudit {
  id          String   @id
  projectId   String
  targetUrl   String
  triggeredBy String   @default("manual")
  createdAt   DateTime @default(now())

  /// 0-100 composite of every check that ran. Null when no check scored.
  score           Int?
  /// The run this one is diffed against — null for a project's first audit.
  previousAuditId String?
  /// JSON AuditDelta[]: what moved since previousAuditId, and by how much.
  deltas          String?
  /// Where the sitemap was actually found (may differ from targetUrl/sitemap.xml).
  sitemapUrl      String?
  /// How many sitemap URLs were fetched into AuditPage for this run.
  pagesCrawled    Int     @default(0)
  /// JSON AuditObservability: cost, latency, probe + cache counts for the run.
  observability   String?

  /// LLM commentary on this run vs the previous one. Written after scoring and
  /// never fed back into `score` — the composite stays deterministic.
  narrative      String?
  /// Which model wrote `narrative`, so a change in voice is traceable.
  narrativeModel String?
  narrativeAt    DateTime?

  findings     AuditFinding[]
  pageMetadata PageMetadata?
  pages        AuditPage[]

  @@index([projectId])
  @@index([createdAt])
  @@index([projectId, createdAt])
}

/// One row per sitemap URL fetched during a run. This is the table that makes
/// the audit site-wide rather than homepage-only: the per-page SEO and JSON-LD
/// results live here, and run-over-run page deltas are computed by joining two
/// audits on `url`.
model AuditPage {
  id      String    @id @default(cuid())
  auditId String
  url     String
  /// HTTP status of the page fetch. 0 when the fetch threw.
  status  Int       @default(0)
  /// <lastmod> as declared by the sitemap, if any.
  lastmod DateTime?

  title            String?
  titleLength      Int?
  metaDescription  String?
  metaDescLength   Int?
  h1Count          Int?
  canonical        String?
  wordCount        Int?
  /// Content images on the page. Decorative ones (alt="", aria-hidden,
  /// role="presentation") are excluded from the count, so the denominator is
  /// images that were *supposed* to describe something.
  imageCount       Int?
  /// Of `imageCount`, how many have no `alt` attribute at all. An empty
  /// alt="" is a valid decorative marker and is NOT counted as missing.
  imagesMissingAlt Int?
  /// Fingerprint of the page's body copy, used to find duplicate pages within
  /// one run. Never compared across runs — a site-wide copy change would make
  /// every page look newly duplicated.
  contentHash      String?

  /// JSON string[]: @type values found in JSON-LD blocks on the page.
  jsonLdTypes String?
  /// Did every JSON-LD block parse as valid JSON?
  jsonLdValid Boolean @default(false)
  jsonLdCount Int     @default(0)

  /// JSON string[]: stable issue codes (title-too-long, no-json-ld, …).
  issues String?
  /// 0-100 per-page score, from the same deterministic rubric for every page.
  score  Int?

  checkedAt DateTime @default(now())

  audit TechnicalAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, url])
  @@index([auditId])
  @@index([url])
  @@index([score])
}

model AuditFinding {
  id                   String  @id @default(cuid())
  auditId              String
  type                 String
  status               String
  severity             String
  confidence           String
  detail               String
  recommendedFix       String
  reproductionCommands String?

  audit TechnicalAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([type])
  @@index([status])
}

model ScheduleConfig {
  id        String    @id @default(cuid())
  projectId String    @unique
  cadence   String    @default("manual-only")
  nextRunAt DateTime?
  active    Boolean   @default(false)

  /// Resolved once at schedule time from the project's own domain, so a
  /// cadence can be set before any manual audit exists.
  targetUrl String?
  lastRunAt DateTime?
  /// Set when a scheduled run throws, so a silently dead schedule is visible.
  lastError String?

  /// Recurring SEO audit (Search Console) — same one-row-per-project store,
  /// its own cadence because SEO changes slowly and GSC data lags.
  seoCadence   String    @default("manual-only")
  seoNextRunAt DateTime?
  seoActive    Boolean   @default(false)
  seoLastRunAt DateTime?
  seoLastError String?

  /// C7 (`docs/analysis/client-portal.md` §19) — automatic measurement+scoring
  /// refresh, derived from the client's plan tier by `refresh-cadence`
  /// (never operator-set, unlike `cadence`/`seoCadence` above). Its own
  /// column set, same pattern as `seo*` above, so it cannot collide with
  /// technical-audit's or monitoring's cadence sharing the generic
  /// `cadence` column (see monitoring/README.md "Known limitation").
  refreshCadence   String    @default("manual-only")
  refreshNextRunAt DateTime?
  refreshActive    Boolean   @default(false)
  refreshLastRunAt DateTime?
  refreshLastError String?

  @@index([projectId])
  @@index([active, nextRunAt])
  @@index([seoActive, seoNextRunAt])
  @@index([refreshActive, refreshNextRunAt])
}

model PageMetadata {
  id              String   @id @default(cuid())
  auditId         String   @unique
  title           String?
  metaDescription String?
  headings        String?
  positioningCopy String?
  capturedAt      DateTime @default(now())

  audit TechnicalAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

model FetchLog {
  id         String   @id @default(cuid())
  runId      String?
  calledBy   String
  method     String
  url        String
  userAgent  String?
  httpStatus Int
  latencyMs  Int
  cost       Float    @default(0)
  cached     Boolean  @default(false)
  retryCount Int      @default(0)
  timestamp  DateTime @default(now())

  @@index([runId])
  @@index([calledBy])
  @@index([timestamp])
}

// ─── Entity Audit ──────────────────────────────────────────────

model EntityAudit {
  id        String   @id @default(cuid())
  projectId String
  createdAt DateTime @default(now())
  entities  Entity[]

  @@index([projectId])
}

model Entity {
  id            String   @id @default(cuid())
  entityAuditId String
  name          String
  descriptor    String?
  type          String   @default("brand")
  createdAt     DateTime @default(now())

  entityAudit     EntityAudit      @relation(fields: [entityAuditId], references: [id], onDelete: Cascade)
  schemaChecks    SchemaCheck[]
  platformRecords PlatformRecord[]
  modelDiffs      ModelDiff[]

  @@index([entityAuditId])
}

model SchemaCheck {
  id                 String   @id @default(cuid())
  entityId           String
  schemaType         String?
  fieldsPresent      String?
  fieldsMissing      String?
  sameAsCount        Int      @default(0)
  sameAsUrls         String?
  sameAsVerification String?
  checkedAt          DateTime @default(now())
  status             String   @default("pass")

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
}

model PlatformRecord {
  id                 String   @id @default(cuid())
  entityId           String
  platform           String
  recordedName       String?
  recordedDescriptor String?
  sourceUrl          String?
  consistencyStatus  String   @default("not-checked")
  createdAt          DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
}

model ModelDiff {
  id         String   @id @default(cuid())
  entityId   String
  prompt     String
  provider   String
  model      String?
  rawAnswer  String?
  citations  String?
  divergence String?
  status     String   @default("not-run")
  costUsd    Float    @default(0)
  latencyMs  Int      @default(0)
  createdAt  DateTime @default(now())
  checkedAt  DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([provider])
  @@index([status])
}

// ─── Gap Analysis (SOP-5) ─────────────────────────────────────

model GapAnalysis {
  id        String   @id @default(cuid())
  projectId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gaps      Gap[]

  @@index([projectId])
}

model Gap {
  id                    String   @id @default(cuid())
  gapAnalysisId         String
  sourceType            String
  sourceId              String
  dimension             String
  dimensionAutoAssigned Boolean  @default(true)
  action                String
  actionAutoAssigned    Boolean  @default(true)
  /// issue | gap | opportunity | strength | risk — the SWOT-style read stage
  /// 8 asks for, orthogonal to dimension/action. See gap-analysis.types.ts.
  category              String   @default("issue")
  categoryAutoAssigned  Boolean  @default(true)
  /// One of the nine stage-9 recommendation buckets (gap-analysis.types.ts
  /// RecommendationCategory), or null for a strength — nothing to act on.
  recommendationCategory String?
  /// 1-5, disclosed band from CLASSIFICATION_RULES. Null on every strength.
  impactScore           Int?
  /// 1-5, disclosed band from CLASSIFICATION_RULES. Null on every strength.
  effortScore           Int?
  /// Governs impactScore/effortScore/quadrant refresh on re-sync. Deliberately
  /// its OWN flag, not folded into categoryAutoAssigned: an operator override
  /// of one axis says nothing about the other, and coupling them meant a
  /// category-only override silently froze impact/effort forever (and vice
  /// versa) — a bug an audit caught after the fact.
  scoreAutoAssigned     Boolean  @default(true)
  /// quick-win | major-project | fill-in | thankless-task — derived from
  /// impactScore × effortScore, never stored independently of them.
  quadrant              String?
  demandPotential       Int?
  credibilityImpact     Int?
  citationLikelihood    Int?
  priorityScore         Int?
  status                String   @default("open")
  title                 String
  description           String
  /// Governs title/description/severity refresh on re-sync. Also its own
  /// flag: it used to ride on dimension/action/category's flags, so a
  /// title-only or description-only override never actually survived the
  /// next sync() — the same class of bug as scoreAutoAssigned above.
  copyAutoAssigned      Boolean  @default(true)
  severity              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  gapAnalysis GapAnalysis @relation(fields: [gapAnalysisId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId])
  @@index([gapAnalysisId])
  @@index([dimension])
  @@index([action])
  @@index([category])
  @@index([status])
  @@index([priorityScore])
  @@index([quadrant])
}

// ─── Strategy (stage 9: "Strategy & Recommendations") ──────────────────────
// Reads gap-analysis's consolidated, categorised, impact/effort-scored gaps
// and groups them into the nine recommendation buckets the flowchart draws,
// sequenced into one action plan. Owns "what do we tell the client to do",
// never re-derives "what did we find" — that stays gap-analysis's job.

model ActionPlan {
  id        String   @id @default(cuid())
  projectId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recommendations Recommendation[]

  @@index([projectId])
}

model Recommendation {
  id           String   @id @default(cuid())
  actionPlanId String
  /// One of the nine RecommendationCategory values — seo-improvements |
  /// content-strategy | social-strategy | reputation-strategy |
  /// search-aeo-strategy | conversion-optimization | technology-improvements
  /// | advertising-opportunities | market-expansion.
  category     String
  title        String
  summary      String
  /// JSON string[] — the Gap ids this recommendation bundles. The plan
  /// points at gap-analysis's own rows rather than copying their text, so a
  /// re-sync's updated evidence is never stale here.
  gapIds       String   @default("[]")
  quickWinCount      Int @default(0)
  majorProjectCount  Int @default(0)
  fillInCount        Int @default(0)
  thanklessTaskCount Int @default(0)
  /// 1 = act on first. Ranked across the WHOLE plan, not just within a
  /// category, so "do this first" has one unambiguous answer.
  priorityRank Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  actionPlan ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)

  @@unique([actionPlanId, category])
  @@index([actionPlanId])
  @@index([priorityRank])
}

// ─── Projects (backbone entity) ───────────────────────────────

model Project {
  id          String   @id @default(cuid())
  name        String
  domain      String
  category    String?
  clientName  String?
  status      String   @default("diagnostic") // scorecard | diagnostic | sprint | retainer | archived
  notes       String?
  userId      String? // owning operator (nullable: pre-auth rows);
  competitors String? // JSON array of {name, domain} — seeded by intake, used by share-of-voice
  /// The Client this project belongs to. Nullable: pre-`clients`-module rows,
  /// and operator-only exploratory projects with no client attached yet.
  clientId    String?
  /// pending | running | completed | failed — the "Day-1 pipeline" orchestrated
  /// by the `clients` module (technical-audit -> digital-presence ->
  /// tech-stack -> gap-analysis sync -> strategy build -> report). Untouched
  /// (stays "pending") for projects created outside that orchestrator.
  ///
  /// PIPELINE-INTERNAL — NOT the client-facing engagement Phase/Milestone model.
  /// `onboardingStatus`/`onboardingStep` describe the one-time Day-1 bootstrapping
  /// run only (plumbing). The future client-facing engagement/timeline concept
  /// (`Phase`/`Milestone`/`Approval`, `docs/analysis/client-portal.md` §10, Phase C3
  /// in `docs/PLAN.md` §11.3 — not yet designed or built) is a SEPARATE, ongoing
  /// concept and must get its own field(s)/model when it's built. Do not repurpose
  /// or overload these two fields for it — conflating "which Day-1 stage is
  /// running" with "which client-facing engagement Phase this project is in" is
  /// exactly the ambiguity `docs/PLAN.md` §11.0's cleanup pass exists to prevent.
  /// (Separately: also do not confuse this with `onboardingWizardState` below,
  /// which is the per-project client-facing onboarding-WIZARD gate, C1/§16 — a
  /// third, independent concept from both of these.)
  onboardingStatus String  @default("pending")
  /// Human-readable name of whichever stage is currently running/failed —
  /// e.g. "technical-audit", "gap-analysis". Null once completed. Same
  /// pipeline-internal scope note as `onboardingStatus` above.
  onboardingStep   String?
  onboardingError  String?
  /// C1 (`docs/analysis/client-portal.md` §16, `docs/PLAN.md` §11.1) — state of
  /// the per-project client-facing onboarding WIZARD gate (confirm details ->
  /// connect GSC -> connect GA4 -> done), distinct from `onboardingStatus` above
  /// (the Day-1 bootstrapping pipeline) and from the not-yet-built engagement
  /// Phase/Milestone model (C3). One value of:
  ///   not-started | confirming-details | connecting-gsc | connecting-ga4 | done | waived
  /// Scoped to `Project`, not `Client` — client-portal.md §16: a client with
  /// several projects/brands onboards each one separately. `waived` is set only by
  /// the admin "waive Google-connect" action (§15) and must stay visibly distinct
  /// from `done` in every DTO/response that surfaces it — never collapsed into a
  /// boolean "is onboarded". The wizard UI that actually transitions through these
  /// states is Phase C2 (not built in C1) — C1 only builds this column plus a
  /// service method to read/write it.
  onboardingWizardState String @default("not-started")
  /// G06 — the engagement funding work on this project.
  engagementId String?
  /// G06 — IANA timezone for this project's due dates, inherited from the
  /// engagement at creation. Due dates never resolve against a browser clock.
  timezone     String  @default("UTC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client? @relation(fields: [clientId], references: [id])

  @@unique([domain])
  @@index([status])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// clients — lean admin/client-portal layer (2026-09-13). NOT the full
// docs/analysis/client-portal.md plan (that doc's Engagement/Milestone/
// Approval/Escalation machinery and Postgres-migration prerequisite are
// deliberately deferred) — this is exactly the scope the operator asked for:
// admin can create/manage clients and see their projects' status; a client
// logs in to see their own project status, their reports, and a message
// thread with the operator. Nothing more.
// ---------------------------------------------------------------------------

model Client {
  id           String   @id @default(cuid())
  name         String
  contactName  String?
  contactEmail String?
  /// active | paused | churned | suspended — set by the admin, not derived.
  /// C5 (`docs/analysis/client-portal.md` §5/§23/§30): "suspended" is written
  /// only by `ClientsService.suspendClient` (an explicit admin action, or the
  /// payment-failure grace-period sweep acting as the "system" actor) — never
  /// by the generic `PATCH /clients/:clientId`, which still accepts any
  /// string here for backward compatibility but is not how suspension is
  /// meant to be triggered going forward. Suspending revokes every Google
  /// connection reachable through this client's projects (§23) and is
  /// reversed only by `reactivateClient`, which does NOT restore Google
  /// access — the client reconnects from scratch (accepted tradeoff, §23).
  status       String   @default("active")
  /// Operator id (User.id, type=operator) who owns this client. Informal
  /// reference, not a relation: an owner leaving must never cascade-touch
  /// the client's own data.
  ownerUserId  String?
  notes        String?
  /// starter | growth | scale | enterprise — set by the admin (generic
  /// `PATCH /clients/:clientId`), not derived from billing. Drives the
  /// `refresh-cadence` module's automatic measurement/scoring refresh
  /// cadence (C7, `docs/analysis/client-portal.md` §19): starter=weekly,
  /// growth/scale=daily, enterprise=daily (true real-time is explicitly
  /// deferred — `docs/PLAN.md` "Real-time monitoring... is future"). No
  /// `billing.Offer`/`Entitlement` encodes a tier today, so this is its own
  /// field rather than derived from the billing ledger — see refresh-cadence
  /// module README for the full reasoning.
  planTier     String   @default("starter")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects Project[]
  users    User[]
  messages ClientMessage[]

  @@index([status])
}

/// A single message thread per client — "leave messages", not a ticketing
/// system with SLAs/priorities/assignees. Append-only; both operator and
/// client type users can post and read.
model ClientMessage {
  id           String   @id @default(cuid())
  clientId     String
  /// Optional: scope a message to one of the client's projects. Null = a
  /// client-wide message (e.g. "when's the next audit?").
  projectId    String?
  authorUserId String
  /// operator | client — denormalized off the author's User.type at post
  /// time, so rendering the thread never needs a join, and the label a
  /// client sees for their own message never changes if their login is
  /// later deleted and recreated.
  authorType   String
  body         String
  /// G08 — an internal note is a separate server-side channel, never a UI
  /// toggle on a client-visible message. Client-scoped reads exclude these.
  internal    Boolean  @default(false)
  createdAt    DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([projectId])
}

// ─── Self-report attribution ──────────────────────────────────
// "How did you find us?" answered by the buyer, not inferred. AI referrals
// mostly land as Direct in analytics and agentic browsers are indistinguishable
// from Chrome at the HTTP layer, so asking is the only signal that survives.
// Written by a public endpoint — deliberately stores no IP.

model AttributionResponse {
  id           String   @id @default(cuid())
  projectId    String
  source       String // chatgpt | claude | perplexity | gemini | copilot | other-ai | search | social | referral | other
  prompt       String? // what they asked the assistant, if they said
  note         String?
  contactEmail String?
  page         String? // the page the form was submitted from
  createdAt    DateTime @default(now())

  @@index([projectId])
  @@index([source])
  @@index([createdAt])
}

// ─── Reporting ────────────────────────────────────────────────

model Report {
  id               String   @id @default(cuid())
  projectId        String
  slug             String   @unique
  title            String
  targetUrl        String
  visibility       String   @default("private") // private | public
  executiveSummary String
  scoreTotal       Int
  scoreBand        String
  subScores        String
  findingsSnapshot String
  roadmapSnapshot  String
  /// JSON GrowthPlanDto — stage 9's ranked ActionPlan (strategy module) +
  /// stage 8's LLM-authored what/why/fix copy (findings module), snapshotted
  /// at generation time same as the other *Snapshot fields. Null on reports
  /// generated before this field existed, or when neither source had run yet
  /// for the project — never backfilled with invented data.
  growthPlanSnapshot String?
  /// JSON BacklinksSummaryDto — the project's latest DataForSEO backlinks
  /// snapshot at generation time, same frozen-at-publish discipline as the
  /// other *Snapshot fields. Null when `POST .../backlinks/refresh` had
  /// never been run for this project yet.
  backlinksSnapshot String?
  /// JSON PresenceInventory — social/directory accounts, verification state,
  /// and expected-platform gaps at generation time. Null when digital-presence
  /// discovery has never run for this project.
  presenceSnapshot String?
  /// JSON GapResult — tech/schema/presence diffs against tracked competitors
  /// plus each rival's SEO score, at generation time. Null when the project
  /// has no tracked competitors yet.
  competitorsSnapshot String?
  branding         String?
  /// G05 — editorial state of the report as a whole. `visibility` above stays
  /// what it always was (public link on/off) and is deliberately NOT reused as
  /// a QA state: a private report can still be released to its client.
  /// draft | in-review | approved | released | withdrawn
  status           String   @default("draft")
  /// G05 — ReportRevision.revision currently shown to the client. Null until
  /// a revision is released.
  releasedRevision Int?
  releasedAt       DateTime?
  releasedBy       String?
  /// G13 — the window and cohort this report covers.
  periodId         String?
  cohortId         String?
  /// G13 — pinned source manifest, making the snapshot reproducible.
  manifestId       String?
  /// G20 — branding/template version in force at release.
  templateId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([projectId])
  @@index([slug])
  @@index([visibility])
  @@index([projectId, status])
}

// ─── Query Set (SOP-1, PRD FR-5) ──────────────────────────────

model QuerySet {
  id          String         @id @default(cuid())
  projectId   String
  version     Int            @default(1)
  persona     String // problem-aware | solution-aware | product-aware | most-aware
  label       String?
  status      String         @default("draft") // draft | active | archived
  source      String         @default("manual") // manual | sales-questions | support-tickets
  createdAt   DateTime       @default(now())
  activatedAt DateTime?
  items       QuerySetItem[]

  @@unique([projectId, version, persona])
  @@index([projectId])
  @@index([status])
}

model QuerySetItem {
  id          String   @id @default(cuid())
  querySetId  String
  prompt      String
  funnelStage String // problem-aware | solution-aware | product-aware | most-aware
  // AEO matrix provenance (nullable — only set for source="aeo-matrix" sets).
  dimension   String? // service-discovery | category-best-of | competitor-alternatives | …
  meta        String? // JSON {service?, competitor?, personaRole?, register?, geo?, template}
  createdAt   DateTime @default(now())

  querySet QuerySet @relation(fields: [querySetId], references: [id], onDelete: Cascade)

  @@index([querySetId])
  @@index([funnelStage])
  @@index([dimension])
  @@index([querySetId, dimension])
}

// ─── Auth (Wave 0) ────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  // admin | delivery-lead | content | technical | outreach | sales — meaningless
  // (left at its default, unused) when type = "client".
  role         String   @default("technical")
  /// operator | client. Reuses this same table/JWT/refresh machinery for both —
  /// deliberate, per docs/analysis/client-portal.md's own recommendation: the
  /// hashing, rotation and revocation are already built and tested, so a
  /// parallel ClientUser table would just be a second copy of that.
  type         String   @default("operator")
  /// Set only when type = "client" — which Client this login belongs to.
  /// RolesGuard blocks a client-type user from every route not explicitly
  /// marked @ClientPortal(), so a null clientId on an operator row is never
  /// load-bearing for access control.
  clientId     String?
  /// G01 — forces the first-login password replacement flow (AU04). Set when
  /// an operator issues assisted credentials; cleared once the user sets their own.
  mustChangePassword Boolean @default(false)
  /// G01 — a disabled user keeps their rows (audit trail) but cannot sign in.
  disabledAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  client        Client?  @relation(fields: [clientId], references: [id])

  @@index([role])
  @@index([type])
  @@index([clientId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha-256 of the refresh token — raw token never stored
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Google integrations (Search Console + Analytics, 3-legged OAuth) ──
// One authorisation per operator per service. Access + refresh tokens are
// stored AES-256-GCM encrypted (modules/google/crypto.util.ts); the raw
// values never leave GoogleConnectionService. A project is then mapped to a
// specific GSC site / GA4 property via GoogleProjectResource.

model GoogleConnection {
  id           String   @id @default(cuid())
  userId       String
  service      String // "search-console" | "analytics"
  googleEmail  String? // the Google account that granted access
  scope        String   @default("") // granted scopes, space-joined
  accessToken  String // encrypted — "ivB64.tagB64.ctB64"
  refreshToken String // encrypted
  expiresAt    DateTime // access-token expiry
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastError    String?

  resources GoogleProjectResource[]

  @@unique([userId, service])
  @@index([userId])
}

model GoogleProjectResource {
  id            String    @id @default(cuid())
  projectId     String
  service       String // "search-console" | "analytics"
  connectionId  String
  resourceId    String // GSC siteUrl, or GA4 "properties/123456789"
  resourceLabel String?
  lastSyncAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  connection GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([projectId, service])
  @@index([connectionId])
}

// ─── Website (P12) — unified page identity, Google data extensions, insights ──
// §7.3/§7.4: a shared normalized page identity per project (never discards the
// original source URLs it was built from); stored Google fact snapshots at
// each source's own grain (GSC page/query/date, GA landing-session) so the
// Website overview reads from storage and never triggers a live/paid call on
// GET; stored insight snapshots that reference exact source extracts + rule
// version, so a rule's wording/thresholds are reproducible after the fact.

model WebsitePageIdentity {
  id           String   @id @default(cuid())
  projectId    String
  /// Normalized identity key — lowercased scheme+host, case-preserved path,
  /// tracking params stripped only per the configured rule, trailing slash
  /// normalized. NOT the same as any single raw source URL.
  canonicalUrl String
  host         String
  path         String
  /// JSON string[] — every raw URL variant this identity was built from
  /// (GSC `page` keys, GA `landingPage` values, technical-audit AuditPage.url,
  /// page-analysis url). Never discarded, so a join is always traceable back.
  sourceUrls   String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([projectId, canonicalUrl])
  @@index([projectId])
}

model GoogleDataSnapshot {
  id           String   @id @default(cuid())
  projectId    String
  /// "search-console" | "analytics"
  service      String
  /// "page-query-date" (GSC) | "landing-session" (GA) | "channel" (GA)
  kind         String
  /// Source's own clock, disclosed rather than relabeled: GSC dates are
  /// Pacific; GA dates are the GA4 property's configured timezone.
  windowStart  String
  windowEnd    String
  timezoneNote String
  /// JSON — rows at the source's own aggregation grain, never pre-joined.
  rows         String
  rowCount     Int      @default(0)
  /// false when the API's own pagination/rowLimit indicates more rows exist
  /// than were fetched — §7.3's "does not guarantee every row" honesty.
  complete     Boolean  @default(true)
  fetchedAt    DateTime @default(now())

  @@index([projectId, service, kind])
}

model WebsiteInsightSnapshot {
  id             String    @id @default(cuid())
  projectId      String
  pageIdentityId String?
  /// One of §7.5's 7 rule ids.
  ruleId         String
  ruleVersion    Int       @default(1)
  severity       String
  message        String
  limitations    String    @default("")
  actionTarget   String    @default("")
  /// JSON string[] — exact source extract ids/keys the rule fired on.
  sourceIds      String    @default("[]")
  /// JSON — the fact inputs the rule evaluated, for after-the-fact audit.
  factsJson      String    @default("{}")
  validFrom      DateTime  @default(now())
  validUntil     DateTime?
  createdAt      DateTime  @default(now())

  @@index([projectId, ruleId])
  @@index([pageIdentityId])
}

// ─── SEO audit (Search Console data + fixes) ──────────────────────────
// The technical audit's sibling: it reads Google Search Console (Search
// Analytics + URL Inspection), then attaches a fix — and, where it can, a
// ready-to-apply artifact — to every issue. Search Console shows the data;
// this turns it into work.

model SeoAudit {
  id          String   @id
  projectId   String
  siteUrl     String // the mapped GSC property
  triggeredBy String   @default("manual")
  createdAt   DateTime @default(now())
  windowDays  Int      @default(28)

  /// 0-100 composite. Null when Search Console returned nothing.
  score           Int?
  previousAuditId String?
  /// JSON AuditDelta[] vs previousAuditId.
  deltas          String?

  /// Window totals, denormalised for fast list / trend rendering.
  clicks       Int   @default(0)
  impressions  Int   @default(0)
  ctr          Float @default(0)
  position     Float @default(0)
  /// Queries ranking on page 1 (position <= 10) and in the top 3, so the
  /// "how many keywords are we winning" line is a single column read.
  page1Queries Int   @default(0)
  top3Queries  Int   @default(0)

  /// JSON: { prev: {clicks,impressions,ctr,position} | null, timeseries: [{date,clicks,impressions,ctr,position}] }
  metrics        String?
  pagesInspected Int     @default(0)
  /// JSON: { totalCostUsd, totalLatencyMs, inspectCalls, saCalls }
  observability  String?

  narrative      String?
  narrativeModel String?
  narrativeAt    DateTime?

  findings SeoFinding[]
  queries  SeoQuery[]
  pages    SeoPage[]

  @@index([projectId])
  @@index([projectId, createdAt])
  @@index([createdAt])
}

/// One row per query, with window metrics, run-over-run movement, and the
/// opportunity codes the rubric flagged (striking-distance, ctr-gap, …).
model SeoQuery {
  id          String @id @default(cuid())
  auditId     String
  query       String
  clicks      Int    @default(0)
  impressions Int    @default(0)
  ctr         Float  @default(0)
  position    Float  @default(0)

  positionDelta    Float?
  impressionsDelta Int?
  clicksDelta      Int?

  /// The page currently ranking highest for this query.
  topPage       String?
  /// JSON string[]: opportunity codes.
  opportunities String?

  audit SeoAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, query])
  @@index([auditId])
}

/// One row per inspected URL: its Search Analytics metrics plus the URL
/// Inspection verdict (index status, chosen canonical, coverage reason) and
/// the classified issues with fixes.
model SeoPage {
  id          String @id @default(cuid())
  auditId     String
  url         String
  clicks      Int    @default(0)
  impressions Int    @default(0)
  ctr         Float  @default(0)
  position    Float  @default(0)

  coverageState   String? // "Submitted and indexed", "Crawled - currently not indexed", …
  indexVerdict    String? // PASS | PARTIAL | FAIL | NEUTRAL
  indexingState   String? // INDEXING_ALLOWED | BLOCKED_BY_META_TAG | BLOCKED_BY_HTTP_HEADER | BLOCKED_BY_ROBOTS_TXT
  robotsTxtState  String?
  pageFetchState  String?
  googleCanonical String?
  userCanonical   String?
  lastCrawlTime   DateTime?

  /// JSON: [{ code, severity, detail, fix, fixArtifact? }]
  issues      String?
  /// JSON string[]: rich-result types Google detected (BreadcrumbList, …).
  richResults String?
  /// JSON: [{ type, issues: [{ severity, message }] }]
  richIssues  String?

  audit SeoAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, url])
  @@index([auditId])
  @@index([url])
}

/// A grouped, actionable issue across the run — the "fix these" layer.
model SeoFinding {
  id             String  @id @default(cuid())
  auditId        String
  type           String // indexing | canonical | noindex | robots | redirect | soft-404 | breadcrumb | rich-result | ctr-gap | striking-distance | ranking-drop | cannibalization | sitemap | crawl
  status         String // fail | warn | pass
  severity       String // critical | high | medium | low
  title          String
  detail         String
  recommendedFix String
  /// JSON string[]: the URLs / queries this finding covers.
  affected       String?
  count          Int     @default(1)
  /// JSON: a ready-to-apply artifact (canonical tag, BreadcrumbList JSON-LD,
  /// meta-description text). Null when there is nothing to hand over.
  fixArtifact    String?
  /// Can Cailyx act on this from here (e.g. ping the sitemap)? action key or null.
  action         String?

  audit SeoAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([type])
  @@index([status])
}

// ─── Measurement (Wave 1, PRD §6.6-6.7, SOP-2) ────────────────

model MeasurementRun {
  id                String    @id @default(cuid())
  projectId         String
  querySetId        String
  surface           String // claude | perplexity | mock
  geo               String    @default("US")
  runCount          Int       @default(5) // n>=5 enforced in code — never lower
  status            String    @default("pending") // pending | running | completed | failed
  totalRequests     Int       @default(0)
  completedRequests Int       @default(0)
  failedRequests    Int       @default(0)
  costTotal         Float     @default(0)
  error             String?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())

  observations Observation[]

  @@index([projectId])
  @@index([querySetId])
  @@index([status])
}

model Observation {
  id               String   @id @default(cuid())
  runId            String
  itemId           String
  runNumber        Int // 1..n of the repeat this observation is
  prompt           String // copied at execution time (query-set immutability keeps this stable)
  mentioned        Boolean  @default(false)
  cited            Boolean  @default(false)
  citedUrl         String?
  position         Int? // rank of the subject's citation among cited URLs, 1-based
  competitors      String   @default("[]") // JSON array of competitor names seen alongside
  characterization String? // v1: "present" | "absent" (judge-diff later)
  rawAnswer        String
  costUsd          Float    @default(0)
  latencyMs        Int?
  model            String?
  createdAt        DateTime @default(now())

  run MeasurementRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([itemId])
}

// ─── Wave 2: scoring, claims, findings ───────────────────────────

// Versioned scoring rubric (PRD §8). Weights sum to 100; bands map totals.
// Active row is what scoring uses; all rows immutable once a run references them.
model ScoreRubric {
  id        String   @id @default(cuid())
  version   Int      @unique
  weights   String // JSON: {machineAccess, entityClarity, shortlistPresence, extractability, authority}
  bands     String // JSON: [{max, band}] ascending, fallback last
  active    Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())

  scoreRuns ScoreRun[]
}

// One scoring pass over a project (FR-8.1-8.4). Sub-scores carry evidence;
// missing evidence sources mark the dimension partial, never silently zero.
model ScoreRun {
  id            String   @id @default(cuid())
  projectId     String
  rubricVersion Int
  total         Int
  band          String
  status        String   @default("complete") // complete | partial
  subScores     String // JSON: [{dimension, weight, value, contribution, evidence[], partial, partialReason?}]
  createdAt     DateTime @default(now())

  rubric ScoreRubric @relation(fields: [rubricVersion], references: [version])

  @@index([projectId])
  @@index([projectId, createdAt])
}

// ─── P14: the Cailyx digital-performance score family (§5.2–§5.5) ───────────
// A SEPARATE score family from the five-dimension ScoreRubric/ScoreRun roll-up
// above. §5.2: "The existing score answers a narrower AI/search-readiness
// question. The requested Cailyx score covers broader digital performance.
// These are not interchangeable." Nothing in this family reads, rewrites or
// relabels a ScoreRun row or a ScoreRubric version — old reports keep their old
// score name and methodology, and no historical record is rewritten.
//
// Analysis: docs/analysis/digital-performance-score.md (the §5.4 metric design
// gate). Weights/thresholds live in ScoreMethodology.config so a later approved
// change is a NEW methodology version, not a code rewrite.

/// One versioned methodology for a score family: the bucket set, weights,
/// per-metric thresholds, minimum samples and maximum source ages, held as
/// configuration. §5.4 requires thresholds to be configurable per metric
/// version — in particular social cadence, where "a B2B business must not be
/// penalized for not posting daily on TikTok".
model ScoreMethodology {
  id      String @id @default(cuid())
  /// digital-performance
  family  String
  version Int
  label   String
  /// JSON ScoreMethodologyConfig:
  /// { rounding, buckets: [{ key, label, weight, detailPath, metricVersion,
  ///   maxAgeDays, minSample, scope, thresholds }] }
  config String
  /// Which version the next run uses. NOT a claim that the weights are
  /// approved: §22 D01 ("Score buckets and weighting") is still an open
  /// product decision, so `active` only selects a version, it does not
  /// validate it.
  active Boolean @default(false)
  note    String?
  createdAt DateTime @default(now())

  // No back-relation to ScoreFamilyRun: a run is keyed by (family, version),
  // and a relation on `version` alone would be ambiguous across families. The
  // pairing is enforced in the service, which refuses to write a run whose
  // (family, methodologyVersion) has no methodology row.
  @@unique([family, version])
  @@index([family, active])
}

/// One run of a score family. Immutable once written (P14 exit gate: "immutable
/// runs") — the service has no update or delete path for this table, and
/// `fingerprint` lets a reader prove a stored run was not rewritten.
///
/// `total` is NULL whenever any applicable bucket is unmeasured or invalid
/// (§5.3 rule 4: "return overall incomplete with no numeric total"). There is
/// deliberately no partial-total column: a partial sum that a reader could
/// mistake for a total is exactly the silent score inflation the rule exists to
/// prevent. `weightedPointsTotal` is nulled for the same reason.
model ScoreFamilyRun {
  id                 String @id @default(cuid())
  projectId          String
  family             String @default("digital-performance")
  methodologyVersion Int
  /// complete | incomplete
  status             String
  /// 0-100, rounded half-up from weightedPointsTotal / applicableWeightTotal —
  /// the ONLY rounding step in the calculation. NULL when incomplete.
  total Int?
  band  String?
  /// Sum of the weights of buckets recorded as applicable. An input to the
  /// calculation, not a score.
  applicableWeightTotal Int
  /// Sum of weight × value over MEASURED buckets. NULL when incomplete, so no
  /// reader can present a partial sum as a total.
  weightedPointsTotal Int?
  /// Weighted evidence coverage 0-100: the share of applicable weight that was
  /// actually measured. Coverage — NOT statistical confidence and NOT business
  /// performance (§5.3 rule 6).
  evidenceCoverage Int
  /// §5.5: sha256 over (family, methodologyVersion, applicability decisions,
  /// scope definitions). Two runs may be compared only when these keys match.
  comparisonKey String
  /// 1-based; incremented whenever the comparison key changes, so old and new
  /// scores land in different segments and are never averaged together.
  segmentIndex Int
  /// new-segment | comparable | scoring-changed
  comparisonState String
  previousRunId   String?
  /// sha256 of the canonical stored payload.
  fingerprint String
  /// JSON ScoreRunScope — market set, source definitions and window DEFINITIONS
  /// this run measured against. Concrete window dates live per bucket: the
  /// comparison key must not change merely because a day passed.
  scope String
  /// JSON — the applicability decisions in force for this run, snapshotted so a
  /// later decision cannot silently reinterpret an old run.
  applicabilitySnapshot String @default("{}")
  createdAt DateTime @default(now())

  buckets ScoreBucketRun[]

  @@index([projectId, createdAt])
  @@index([projectId, family, createdAt])
  @@index([projectId, family, comparisonKey])
}

/// One bucket's stored detail inside a run — every field §5.3 requires a bucket
/// to carry: key, label, weight, applicability, value or absent state,
/// measurement window, methodology version, metric inputs, thresholds, source
/// references, source ages, missing reasons and effective contribution.
model ScoreBucketRun {
  id    String @id @default(cuid())
  runId String
  key   String
  label String
  /// The weight this run was actually calculated with, stored per row so an old
  /// run keeps its own weights after a methodology change.
  weight Int
  /// applicable | not-applicable. "Not relevant" is a recorded decision with a
  /// reason (§5.3 rule 1), never inferred from missing data.
  applicability       String
  applicabilityReason String?
  /// measured | not-measured | not-applicable | outdated | failed
  state String
  /// 0-100 bucket value. NULL unless state = measured — an absent value always
  /// carries a state and a reason, never a 0 standing in for "unknown".
  value Int?
  /// weight × value, exact and unrounded. 0 when not measured.
  weightedPoints Int @default(0)
  /// The weight this bucket contributes to the denominator: its weight when
  /// applicable, 0 only when explicitly not-applicable. A bucket that is merely
  /// unmeasured keeps its full effective weight — that is what makes the run
  /// incomplete instead of redistributing its weight away.
  effectiveWeight Int @default(0)
  /// weightedPoints / applicableWeightTotal — the bucket's exact share of the
  /// 0-100 total, unrounded by design (only the final total is rounded).
  contribution Float @default(0)
  /// The measurement window actually used for this bucket.
  windowStart DateTime?
  windowEnd   DateTime?
  methodologyVersion Int
  /// e.g. "website-health/1" — the formula version, so a formula change is
  /// visible rather than silently reinterpreted.
  metricVersion String
  /// JSON MetricInput[] — numerator, denominator, units, rounding and any
  /// submetric excluded from the bucket mean, per submetric.
  metricInputs String @default("[]")
  /// JSON — the thresholds actually applied (from the methodology version).
  thresholds String @default("{}")
  /// JSON SourceRef[] — { kind, ref, observedAt, ageDays } per source read.
  sources String @default("[]")
  maxAgeDays Int
  minSample  Int
  /// JSON string[] — plain-English reasons the bucket is not measured.
  missingReasons String @default("[]")
  /// JSON string[] — disclosures that are neither missing data nor a score:
  /// the scope actually measured, what the metric deliberately does NOT claim,
  /// and any known limitation of this metric version.
  notes String @default("[]")
  /// Client-safe detail destination with the period preserved (§5.5).
  detailPath  String?
  detailQuery String?
  createdAt   DateTime @default(now())

  run ScoreFamilyRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, key])
  @@index([key, state])
}

/// §5.3 rule 1 — an explicit, recorded decision that a bucket is not relevant
/// to this project. Mirrors PresenceApplicabilityOverride's shape (§11.2): the
/// absence of a row means "applicable", and a bucket that simply could not be
/// measured stays applicable and `not-measured`. Those are different things and
/// only an explicit not-applicable decision redistributes weight.
model ScoreApplicabilityDecision {
  id        String @id @default(cuid())
  projectId String
  bucketKey String
  /// applicable | not-applicable
  decision  String
  /// Required by the service for a not-applicable decision — "not relevant" is
  /// a decision with a reason, not an absence of data.
  reason     String
  actorEmail String?
  /// Methodology version the decision was taken against, so a later bucket-set
  /// change reads as "this decision predates the current buckets" rather than
  /// being silently reinterpreted.
  methodologyVersion Int
  createdAt    DateTime  @default(now())
  /// Null while this row is the latest for (projectId, bucketKey). Superseding
  /// writes a new row rather than deleting history.
  supersededAt DateTime?

  @@index([projectId, bucketKey])
  @@index([projectId, supersededAt])
}

// A factual statement tracked through claims discipline (FR-9.4): provenance,
// A/B/C grade, and banned-phrase check status — blocked at approval, never
// silently let through.
model Claim {
  id          String   @id @default(cuid())
  projectId   String
  statement   String
  sourceUrl   String?
  sourceName  String?
  grade       String? // A (own n>=5 measurement) | B (>=2 independent sources) | C (single source)
  gradeReason String?
  checkResult String   @default("pending") // pending | passed | banned-phrase | ungraded-number | single-run-rate
  checkJson   String   @default("{}") // JSON detail of the last discipline check
  status      String   @default("draft") // draft | approved | blocked
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

// A finding with generated what/why/fix copy in two registers (FR-9.3),
// claims-discipline filtered. thinRun flags honest thin evidence (FR-9.1).
model Finding {
  id            String   @id @default(cuid())
  projectId     String
  gapId         String? // source gap-analysis row
  title         String
  whatExecutive String?
  whatTechnical String?
  whyExecutive  String?
  whyTechnical  String?
  fixExecutive  String?
  fixTechnical  String?
  thinRun       Boolean  @default(false)
  disclosedGap  String? // when thinRun, what the copy says about missing evidence
  createdAt     DateTime @default(now())

  @@index([projectId])
}

// ─── Wave 3: crawler-monitor, monitoring ─────────────────────────

// One AI-crawler hit from ingested server logs (SOP-3/4.5).
// Bot classification happens at ingest from a static registry (userAgent-based).
model CrawlerHit {
  id        String   @id @default(cuid())
  projectId String
  hitAt     DateTime
  url       String
  userAgent String
  ipAddress String?
  botVendor String // anthropic | openai | perplexity | google | bing | other
  botName   String // canonical bot name (GPTBot, Claudebot, ...)
  botType   String // training | search | citation-engine | unknown
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([projectId, hitAt])
}

// A monitoring alert raised by a delta/regression check (FR-12.3).
model Alert {
  id        String   @id @default(cuid())
  projectId String
  kind      String // score-drop | mention-drop | scheduled-run-failed
  severity  String   @default("warning") // info | warning | critical
  message   String
  payload   String   @default("{}") // JSON: before/after values, run ids
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([projectId, createdAt])
}

// ─── Wave 4: page-analysis, mention-tracking, sleeper-refresh, data-asset ───

// One SOP-6 analysis of a URL's copy structure for answer-engine extractability.
// Scores come only from the deterministic pipeline (reproducible); LLM notes,
// when requested, are stored separately and never feed the score.
model PageAnalysis {
  id                String    @id @default(cuid())
  projectId         String
  url               String
  title             String?
  wordCount         Int       @default(0)
  blufScore         Int       @default(0) // 0-30: answer in the first 40-60 words
  questionH2Score   Int       @default(0) // 0-25: share of question-shaped H2s
  formatScore       Int       @default(0) // 0-25: tables / numbered steps / definition blocks
  claimsScore       Int       @default(0) // 0-20: extractable "number + noun + time + source" claims
  structureScore    Int       @default(0) // sum of the four subscores (0-100)
  blufText          String? // first paragraph copy when BLUF is present
  headingStructure  String    @default("[]") // JSON: [{level, text, questionShaped, standalone, standaloneReason}]
  extractableClaims String    @default("[]") // JSON: [{text, hasNumber, hasTimeframe, hasSource}]
  formatFindings    String    @default("{}") // JSON: {tables, orderedLists, definitionBlocks}
  llmNotes          String? // optional Claude refinement (standalone verdicts, BLUF rewrite) — never part of structureScore
  fetchedAt         DateTime?
  status            String    @default("complete") // complete | fetch-failed
  createdAt         DateTime  @default(now())

  @@index([projectId])
  @@index([projectId, structureScore])
}

// Per-mention check history for a tracked target (drives decay, SOP-7).
model MentionCheck {
  id           String   @id @default(cuid())
  targetId     String
  checkedAt    DateTime @default(now())
  mentioned    Boolean
  evidence     String? // matched excerpt on the page
  fetchedTitle String?
  httpStatus   Int?

  target MentionTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId])
  @@index([targetId, checkedAt])
}

// A tracked external mention target (SOP-7): listicle candidate, community
// thread, or review platform — manual entry + semi-auto single-fetch checks.
model MentionTarget {
  id        String   @id @default(cuid())
  projectId String
  url       String
  type      String   @default("listicle") // listicle | community | review | other
  label     String? // "Top 10 AI visibility tools" etc.
  status    String   @default("new") // new | contacted | replied | placed | rejected
  notes     String?
  createdAt DateTime @default(now())

  campaign   MentionCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId String?
  checks     MentionCheck[]

  @@index([projectId])
  @@index([projectId, status])
}

// Optional grouping of targets into an outreach campaign (SOP-7).
model MentionCampaign {
  id            String   @id @default(cuid())
  projectId     String
  name          String
  listicleQuery String? // the "best X" query this campaign hunts with
  createdAt     DateTime @default(now())

  targets MentionTarget[]

  @@index([projectId])
}

// A sleeper page (SOP-10): declining traffic + intact backlinks → refresh candidate.
// Traffic evidence comes from manual entry or pasted GSC CSV export (OAuth deferred).
model SleeperPage {
  id                 String    @id @default(cuid())
  projectId          String
  url                String
  label              String?
  trafficDeclinePct  Float? // from GSC export or manual entry
  referringDomains   Int?
  status             String    @default("flagged") // flagged | brief-sent | in-progress | refreshed | abandoned
  dateModifiedBefore String? // visible dateModified on the shipped page
  dateModifiedAfter  String?
  refreshedAt        DateTime?
  notes              String?
  createdAt          DateTime  @default(now())

  @@index([projectId])
  @@index([projectId, status])
}

// An original-data asset (SOP-8, P3) that earns citations by being named
// after the client brand and citing sourceable numbers.
model DataAsset {
  id              String    @id @default(cuid())
  projectId       String
  title           String
  brandAlignment  String    @default("brand-named") // brand-named | subject-matter
  methodologyNote String?
  surveySize      Int?
  status          String    @default("planned") // planned | fielding | published
  publishedAt     DateTime?
  assetUrl        String?
  createdAt       DateTime  @default(now())

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// growth-execution — stage 11, "Marketing & Growth Execution" (12-stage flow)
// ---------------------------------------------------------------------------

/// One recommended growth asset — "Create Recommended Assets", the
/// flowchart's stage-11 leaf. A BRIEF (title + angle + why), not finished
/// long-form copy: full articles/landing pages are a different, much larger
/// product surface than a recommendation a content/ad team acts on. Lifecycle
/// mirrors DataAsset's own planned->fielding->published pattern.
model GrowthAsset {
  id             String    @id @default(cuid())
  projectId      String
  /// article | ad-copy | social-content | email-campaign | landing-page |
  /// structured-data | seo-fix | faq | review-campaign — the flowchart's nine
  /// "Create Recommended Assets" leaves, exactly.
  assetType      String
  title          String
  /// The recommendation itself: angle, key point, what it should cover.
  /// Deterministic template by default; one constrained LLM pass when
  /// useLlm=true (same opt-in-refinement shape as `persona`/`journey`).
  brief          String
  /// The keyword this asset targets, if generated from a priority keyword
  /// (stage 10). Null for gap-sourced assets with no single target keyword.
  targetKeyword  String?
  /// The Gap row this asset addresses, if any — traceability back to stage 8.
  /// Not a foreign key: gaps are pruned/resynced independently, and a
  /// dangling reference here must never delete a recommendation someone may
  /// already be acting on.
  sourceGapId    String?
  /// P07 §12.7 opportunity->content conversion contract: the `Opportunity`
  /// this asset was created from, if any. Not a foreign key for the same
  /// reason as `sourceGapId` — an opportunity may later be pruned/reanalyzed
  /// independently, and a dangling reference here must never delete or break
  /// a brief someone is already acting on. `Opportunity.convert()` is the
  /// only writer.
  sourceOpportunityId String?
  /// C4 (client-portal.md §14/§22): the `ContentRequest` this asset was
  /// created from, if a client submitted the structured "request new
  /// content" form. Not a foreign key — same reasoning as the two ids above:
  /// a pruned/archived request must never cascade-delete or dangling-break a
  /// brief someone is already acting on. Set once, at creation, by
  /// `GrowthExecutionService.createFromClientRequest` only.
  sourceClientRequestId String?
  /// Caller-supplied idempotency key for opportunity-triggered creation only
  /// (null for every other creation path). Unique so a retried "Create
  /// content" click with the same key can never create a second brief —
  /// `OpportunitiesService.convertToContent` checks this before writing.
  idempotencyKey String?   @unique
  status         String    @default("recommended") // recommended | in-progress | published
  /// deterministic (template) | generated-llm — same honesty convention as
  /// Persona.source: a reader must be able to tell which one produced this.
  source         String    @default("deterministic")
  generationModel String?
  /// JSON, shape depends on assetType — ArticleContent {title, metaDescription,
  /// bodyMarkdown} for "article", AdCopyContent {variants:[{headline,
  /// description}]} for "ad-copy". Null for every other asset type and for
  /// article/ad-copy rows created before content generation existed (brief
  /// only) — never backfilled with invented copy.
  content        String?
  publishedAt    DateTime?
  assetUrl       String?
  /// P08 §13.3 workspace filter — the staff member responsible for moving
  /// this piece forward next. Not a foreign key (User rows can be
  /// deactivated without silently orphaning content ownership history);
  /// content-workspace.service.ts validates it against real users on write.
  assigneeId     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([projectId])
  @@index([projectId, assetType])
  @@index([projectId, status])
  @@index([sourceOpportunityId])
  @@index([sourceClientRequestId])
  @@index([assigneeId])
}

/// C4 (client-portal.md §14/§22): a client's structured "request new content"
/// submission. The record exists for the client's own request history and
/// for admin traceability — it is deliberately NOT a triage inbox an operator
/// must convert: `growthAssetId` is set at creation time, in the same
/// transaction, so the request lands directly in `content-workspace` as a
/// real, client-tagged `GrowthAsset` (see `sourceClientRequestId` above).
model ContentRequest {
  id                String   @id @default(cuid())
  projectId         String
  clientId          String
  requestedByUserId String
  /// One of CONTENT_WORKSPACE_ASSET_TYPES (content-workspace.types.ts) —
  /// validated against that list, not redeclared here.
  contentType       String
  /// Free-text target keyword or topic, as the client typed it.
  topic             String
  /// low | normal | high
  priority          String   @default("normal")
  note              String?
  /// The GrowthAsset created from this request. Nullable only for the brief
  /// window between the two writes `ContentRequestsService.create` makes
  /// (create request -> create asset -> link back) — same
  /// create-then-link shape as `Opportunity.linkedGrowthAssetId`; never null
  /// once `create` returns.
  growthAssetId     String?
  createdAt         DateTime @default(now())

  @@index([projectId])
  @@index([clientId])
}

/// C4 (client-portal.md §13/§20): the lightweight prompt add/delete request
/// queue. Deliberately NOT the Approval primitive (§9/§10) — the client
/// requests, an admin acts directly on the real `QuerySet` using its own
/// edit/versioning mechanics (draft -> add/remove -> activate, or fork an
/// active set first), then records the decision here. This table never
/// mutates a QuerySet itself.
model PromptRequest {
  id                String    @id @default(cuid())
  projectId         String
  clientId          String
  requestedByUserId String
  /// add | remove
  action            String
  /// Required for action=add — the proposed prompt text.
  prompt            String?
  /// Optional persona/funnel-stage hint for action=add, so the admin knows
  /// which QuerySet (by persona) to add it to. One of PromptPersona.
  persona           String?
  /// Required for action=remove — the QuerySetItem.id flagged for removal.
  targetItemId      String?
  /// Snapshot of the flagged prompt's text at request time, so the request
  /// still reads even if the item is later removed by the admin action this
  /// request itself triggers.
  targetPromptText  String?
  note              String?
  /// pending | approved | declined
  status            String    @default("pending")
  /// §20 quota snapshot, taken at request time — never recomputed later, so
  /// the admin sees exactly what the client's account looked like when they
  /// asked, even if the count has since changed.
  activePromptCount Int
  /// The plan tier's tracked-prompt limit at request time. Null = unlimited
  /// (Enterprise).
  planPromptLimit   Int?
  /// The plan tier slug used to resolve `planPromptLimit` — recorded for
  /// audit/debugging since tier is derived, not a stored field (§20 note).
  planTier          String
  /// True when `activePromptCount >= planPromptLimit` for an add request —
  /// flagged distinctly as an upsell moment, never a silent failure (§20).
  overQuota         Boolean   @default(false)
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?
  /// The QuerySetItem.id the admin's add action produced, if they record it.
  resultQuerySetItemId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([projectId, status])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// P07 — Keyword gaps / content opportunities (platform_improvement_plan.md
// §12.5-§12.7). Canonical opportunity ("idea") records: Content -> Ideas is
// the one home per §12.5; Competitors/Website/Reports link into a filtered
// view of these rows rather than keeping their own copies.
// ---------------------------------------------------------------------------

/// One canonical content opportunity ("idea"). Origin-tagged, deduplicated by
/// (projectId, topic, market, language, intent, evidenceSourceFamily) per
/// §12.6's last paragraph — re-running analysis UPDATES the matching row's
/// evidence/measuredAt/recommendation rather than creating a duplicate, and
/// never silently un-dismisses a row a human dismissed without a new reason.
model Opportunity {
  id        String @id @default(cuid())
  projectId String

  /// search-gap | ai-question-gap | refresh | client-request | editorial-idea
  /// — §12.5's exact origin list. Only origins with a real, wired source are
  /// ever written: this build wires search-gap (keyword-gap engine, below)
  /// and editorial-idea (explicit manual "Research a search term" /
  /// operator-added ideas). ai-question-gap/refresh/client-request are valid
  /// values the schema supports but nothing in this build populates them —
  /// no placeholder rows are fabricated to fill the enum.
  origin String

  /// Normalized (trim/lowercase/collapsed-whitespace) topic or keyword — the
  /// dedup key's core field. `topicDisplay` keeps the original casing for
  /// rendering.
  topic        String
  topicDisplay String

  /// Target market/language the opportunity was evaluated for. Nullable:
  /// some editorial ideas have no single target market.
  market   String?
  language String?
  /// informational | commercial | navigational | transactional | unspecified
  /// — coarse search intent, used only as a dedup-identity field per §12.6;
  /// never inferred beyond what the evidence actually supports.
  intent String @default("unspecified")

  /// Groups WHICH kind of evidence backs this row for dedup purposes, e.g.
  /// "serp-keyword-gap" | "competitor-topic-signal" | "manual-lookup". Two
  /// evidence records of the same family reinforce one Opportunity; a
  /// different family for the same topic is a distinct row (§12.6).
  evidenceSourceFamily String

  reason String

  /// JSON OpportunityEvidence[] (see opportunities.types.ts) — every backing
  /// observation, appended to (not replaced) on each re-run: checked depth,
  /// query/location/device, capture date, competitor name/domain, source ids.
  /// Multiple evidence records may reinforce one idea (§12.6).
  evidence String @default("[]")

  measuredAt DateTime

  /// ranked | unknown | not-observed. A null/failed capture is `unknown`,
  /// never coerced into "not ranking" (§12.6).
  clientPositionStatus String  @default("unknown")
  clientPosition       Int?
  rivalPositionStatus  String  @default("unknown")
  rivalPosition         Int?
  rivalName              String?
  rivalCompetitorId      String?

  /// 0-100 relevance/priority signal, disclosed formula (see
  /// opportunities.service.ts) — a ranking aid, not a promise, same
  /// convention as keyword-research's priorityScore.
  relevance Int @default(0)

  /// unavailable when no demand data exists — never coerced to 0.
  demandVolume      Int?
  demandCpc         Float?
  demandCompetition String?

  suggestedContentType String?
  /// GrowthAsset.id of a pre-existing piece this topic already has, if the
  /// analysis found one by target keyword match. Null = no match found.
  existingContentMatchId String?

  /// new | in-progress | dismissed | converted
  status String @default("new")
  /// Required whenever status is set to "dismissed" — re-running analysis
  /// with unchanged evidence must never silently flip a dismissed row back
  /// to "new" (§12.6). A NEW reason (operator or materially new evidence) is
  /// the only thing allowed to reopen it.
  dismissedReason String?
  dismissedAt     DateTime?

  /// The GrowthAsset created by "Create content" (§12.7), once converted.
  linkedGrowthAssetId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, topic, market, language, intent, evidenceSourceFamily], name: "opportunityIdentity")
  @@index([projectId])
  @@index([projectId, status])
  @@index([projectId, origin])
}

// ---------------------------------------------------------------------------
// Wave 5 — sales & qualification tools (PLAN Phase 4, PRD 6.11/13/17)
// ---------------------------------------------------------------------------

// Rung 0 free diagnostic (PRD 13 Free tier): one persisted run of the real
// pipeline at low depth. Findings are the top-3 named problems; nonObvious is
// the SOP guarantee (the prospect could not know this without us).
model ScorecardRun {
  id          String   @id @default(cuid())
  projectId   String
  score       Float
  band        String // invisible | faint | present | recommended
  topFindings String   @default("[]") // JSON: [{title, why, fix, severity}]
  nonObvious  Boolean  @default(false)
  depth       String   @default("free") // free (n>=3, subset) | operator
  publicToken String   @unique @default(cuid()) // shares the branded report without auth
  createdAt   DateTime @default(now())

  @@index([projectId])
}

// GTM qualification arithmetic (GTM Playbook). One row per project; PUT
// recomputes; every intermediate stage is stored, not just the verdict.
model PipelineMath {
  id            String   @id @default(cuid())
  projectId     String   @unique
  revenueTarget Float
  acv           Float
  winRate       Float // fraction 0..1
  meetingToSql  Float // fraction of meetings that become SQLs
  leadToMeeting Float // fraction of leads that book meetings
  visitorToLead Float // fraction of visitors that become leads
  marketSize    Float? // addressable market (visitors/period)
  stages        String   @default("{}") // JSON: {deals, sqls, meetings, leads, visitors}
  verdict       String   @default("feasible") // feasible | fiction
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
}

// A funnel lead (PRD 6.11 FR-11.2) with CTA click event log (FR-11.3).
model Lead {
  id             String   @id @default(cuid())
  projectId      String
  email          String
  name           String?
  source         String   @default("form") // bulk | api | form | scorecard
  status         String   @default("new") // new | reached | booked | won | lost
  scorecardRunId String? // lead generated by a Rung-0 run
  ctaEvents      String   @default("[]") // JSON: [{type, at, meta}]
  createdAt      DateTime @default(now())

  @@index([projectId])
  @@index([projectId, status])
}

// Stripe Checkout upgrade ledger (FR-11.4). Option A from docs/analysis/wave-5.md:
// links come from env-configured Checkout URLs; clicks + webhook flip status.
model Upgrade {
  id              String    @id @default(cuid())
  projectId       String
  leadId          String?
  tier            String // full | monitoring
  status          String    @default("created") // created | clicked | completed | abandoned
  checkoutUrl     String?
  stripeSessionId String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([projectId])
  @@index([projectId, status])
}

// ---------------------------------------------------------------------------
// Swarm layer — persona / journey / council / internal-link / serp-intelligence
// The synthetic-buyer research layer. Personas are research identities, never
// used to generate real traffic, clicks, or impressions on any live surface.
// ---------------------------------------------------------------------------

// A synthetic buyer persona (Agent #1). One research identity — role, context,
// and what it is trying to find out — that seeds branching search journeys and
// tags measurement observations. Bounded per project (PERSONA_MAX_PER_PROJECT).
model Persona {
  id                String   @id @default(cuid())
  projectId         String
  label             String // human-readable, e.g. "Series-A SaaS founder evaluating options"
  role              String // founder | cmo | head-of-growth | seo-lead | content-lead | demand-gen | saas-operator | product-marketer | agency-owner | rev-ops
  seniority         String   @default("lead") // ic | lead | director | vp | c-level | founder
  companyStage      String   @default("growth") // idea | seed | series-a | growth | enterprise
  awareness         String   @default("problem-aware") // problem-aware | solution-aware | product-aware | most-aware (mirrors QuerySet persona union)
  primaryGoal       String
  researchObjective String // the concrete question THIS persona is chasing — drives journey branching
  painPoints        String   @default("[]") // JSON string[]
  buyingTriggers    String   @default("[]") // JSON string[]
  objections        String   @default("[]") // JSON string[]
  vocabulary        String   @default("[]") // JSON string[] — phrases this persona actually types into a search box
  status            String   @default("draft") // draft | active | archived
  source            String   @default("generated") // generated (deterministic) | generated-llm | manual
  generationModel   String? // model id when source = generated-llm
  seed              String? // deterministic generator seed (projectId:index) — reproducibility
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  journeys Journey[]

  @@index([projectId])
  @@index([projectId, status])
  @@index([role])
}

// A branching multi-step search journey for one persona (Agent #2). The plan is
// a tree of JourneySteps; execution walks it against a surface adapter (the
// deterministic `mock` adapter unless SWARM_ALLOW_LIVE=1). Journeys are API
// calls to AI surfaces / licensed SERP data only — never a browser driven as a
// fake human, and never traffic/clicks/impressions on a live surface.
model Journey {
  id             String    @id @default(cuid())
  projectId      String
  personaId      String
  campaignId     String?
  label          String
  objective      String // copied from persona.researchObjective at plan time
  surface        String    @default("mock") // mock | claude | perplexity
  geo            String    @default("US")
  maxDepth       Int       @default(4)
  maxBranches    Int       @default(2)
  planSource     String    @default("deterministic") // deterministic | llm
  planModel      String?
  status         String    @default("planned") // planned | running | completed | partial | failed
  stepCount      Int       @default(0)
  executedSteps  Int       @default(0)
  mentionedSteps Int       @default(0)
  citedSteps     Int       @default(0)
  costUsd        Float     @default(0)
  note           String? // cost-governor stop reason, etc.
  error          String?
  plannedAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  persona  Persona          @relation(fields: [personaId], references: [id], onDelete: Cascade)
  campaign JourneyCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  steps    JourneyStep[]

  @@index([projectId])
  @@index([projectId, status])
  @@index([personaId])
  @@index([campaignId])
}

// One node in a journey tree. parentId = null is the root query; children are
// the follow-ups a persona would realistically ask next.
model JourneyStep {
  id        String  @id @default(cuid())
  journeyId String
  parentId  String?
  depth     Int     @default(0)
  ordinal   Int     @default(0) // order among siblings
  kind      String  @default("query") // query | refinement | branch | comparison | objection
  awareness String  @default("problem-aware")
  query     String
  rationale String // why this persona asks this next
  status    String  @default("pending") // pending | done | failed | skipped

  // execution result (null until executed)
  answerText      String?
  citations       String    @default("[]") // JSON string[]
  mentioned       Boolean   @default(false)
  cited           Boolean   @default(false)
  citedUrl        String?
  position        Int?
  competitorsSeen String    @default("[]") // JSON string[]
  costUsd         Float     @default(0)
  latencyMs       Int?
  model           String?
  executedAt      DateTime?
  createdAt       DateTime  @default(now())

  journey  Journey       @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  parent   JourneyStep?  @relation("JourneyStepTree", fields: [parentId], references: [id], onDelete: Cascade)
  children JourneyStep[] @relation("JourneyStepTree")

  @@index([journeyId])
  @@index([journeyId, depth])
  @@index([parentId])
}

// Fan-out governor: plan + execute N journeys across many personas under ONE
// USD budget. Execution stops the moment spentUsd >= budgetUsd. This is the
// single knob that bounds a "50-100 agents -> thousands of journeys" run.
model JourneyCampaign {
  id               String    @id @default(cuid())
  projectId        String
  name             String
  surface          String    @default("mock")
  geo              String    @default("US")
  planSource       String    @default("deterministic") // deterministic | llm
  journeyTarget    Int       @default(10) // how many journeys to plan
  maxDepth         Int       @default(4)
  maxBranches      Int       @default(2)
  personaRoles     String    @default("[]") // JSON string[] filter; empty = any active persona
  budgetUsd        Float     @default(5.0)
  spentUsd         Float     @default(0)
  status           String    @default("planned") // planned | running | completed | partial | failed
  journeysPlanned  Int       @default(0)
  journeysExecuted Int       @default(0)
  note             String?
  createdAt        DateTime  @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?

  journeys Journey[]

  @@index([projectId])
  @@index([projectId, status])
}

// Internal-Link topical-architecture analysis (Agent #8). One run crawls a
// bounded set of the client's OWN pages, builds the internal link graph, and
// emits "add link A -> B" recommendations from topical overlap + inbound
// deficit. Client-site analysis only — no third-party crawling.
model LinkGraph {
  id                  String    @id @default(cuid())
  projectId           String
  rootUrl             String
  maxPages            Int       @default(50)
  maxDepth            Int       @default(3)
  source              String    @default("http") // http | fixture
  status              String    @default("crawling") // crawling | analyzing | complete | failed
  pagesCrawled        Int       @default(0)
  edgeCount           Int       @default(0)
  orphanCount         Int       @default(0)
  recommendationCount Int       @default(0)
  recSource           String    @default("deterministic") // deterministic | llm
  recModel            String?
  error               String?
  createdAt           DateTime  @default(now())
  finishedAt          DateTime?

  nodes           LinkNode[]
  edges           LinkEdge[]
  recommendations LinkRecommendation[]

  @@index([projectId])
  @@index([projectId, status])
}

model LinkNode {
  id            String    @id @default(cuid())
  graphId       String
  url           String
  path          String
  title         String?
  h1            String?
  wordCount     Int       @default(0)
  topicKeywords String    @default("[]") // JSON string[] — top TF terms
  depth         Int       @default(0) // clicks from root
  httpStatus    Int       @default(0)
  inboundCount  Int       @default(0)
  outboundCount Int       @default(0)
  isOrphan      Boolean   @default(false)
  fetchedAt     DateTime?

  graph LinkGraph @relation(fields: [graphId], references: [id], onDelete: Cascade)

  @@unique([graphId, path])
  @@index([graphId])
  @@index([graphId, isOrphan])
}

model LinkEdge {
  id         String  @id @default(cuid())
  graphId    String
  fromPath   String
  toPath     String
  anchorText String  @default("")
  rel        String?
  context    String? // ~120 chars around the link

  graph LinkGraph @relation(fields: [graphId], references: [id], onDelete: Cascade)

  @@index([graphId])
  @@index([graphId, toPath])
}

model LinkRecommendation {
  id              String @id @default(cuid())
  graphId         String
  fromPath        String
  toPath          String
  suggestedAnchor String
  reason          String
  topicOverlap    Float  @default(0)
  priority        Int    @default(0)
  status          String @default("open") // open | applied | dismissed

  graph LinkGraph @relation(fields: [graphId], references: [id], onDelete: Cascade)

  @@index([graphId])
  @@index([graphId, status])
  @@index([graphId, priority])
}

// Council (Agent #10): several role-agents debate which interventions are most
// likely to improve AI visibility, then a synthesizer ranks them. Reads only
// what other modules already produced (gap-analysis, measurement, journeys,
// link graph, technical/entity audits) — it proposes nothing new to measure.
model CouncilSession {
  id           String    @id @default(cuid())
  projectId    String
  question     String    @default("Which interventions will most improve our AI visibility?")
  rounds       Int       @default(1)
  agentRoles   String    @default("[]") // JSON string[] of role slugs that debated
  source       String    @default("deterministic") // deterministic | llm
  model        String?
  status       String    @default("complete") // running | complete | failed
  evidenceRefs String    @default("{}") // JSON: which artefacts were in scope + their ids
  error        String?
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?

  contributions CouncilContribution[]
  rankings      CouncilRanking[]

  @@index([projectId])
  @@index([projectId, status])
}

// One agent's statement in one round: its stance on each candidate intervention.
model CouncilContribution {
  id        String   @id @default(cuid())
  sessionId String
  round     Int      @default(1)
  agentRole String // technical | content | authority | measurement | narrative | skeptic | synthesizer
  summary   String // the agent's argument this round
  positions String   @default("[]") // JSON: [{interventionKey, vote: for|against|conditional, weight, rationale}]
  createdAt DateTime @default(now())

  session CouncilSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, round])
}

// The synthesized outcome: candidate interventions ranked by the debate.
model CouncilRanking {
  id              String  @id @default(cuid())
  sessionId       String
  rank            Int
  interventionKey String
  title           String
  rationale       String
  consensus       Float   @default(0) // 0..1 agreement across agents
  expectedImpact  Int     @default(0) // 0..100 heuristic
  effort          String  @default("medium") // low | medium | high
  confidence      String  @default("medium") // low | medium | high
  sourceRefs      String  @default("[]") // JSON string[] of artefact refs backing it
  dissent         String? // recorded minority objection, if any

  session CouncilSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, rank])
}

// SERP Intelligence (Agent #3): tracks Google SERP rankings, competitors, SERP
// features, and AI-Overview presence for a set of queries over time.
// Data comes from a LICENSED SERP data API (DataForSEO) — never headless-browser
// scraping of Google, and never generating queries/clicks/impressions as a user.
model SerpTracker {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  locationName String   @default("United States")
  languageCode String   @default("en")
  device       String   @default("desktop") // desktop | mobile
  provider     String   @default("dataforseo") // dataforseo | fixture
  status       String   @default("active") // active | archived
  createdAt    DateTime @default(now())

  queries   SerpQuery[]
  snapshots SerpSnapshot[]

  @@index([projectId])
  @@index([projectId, status])
}

model SerpQuery {
  id        String   @id @default(cuid())
  trackerId String
  keyword   String
  createdAt DateTime @default(now())

  tracker SerpTracker  @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  results SerpResult[]

  @@unique([trackerId, keyword])
  @@index([trackerId])
}

model SerpSnapshot {
  id         String    @id @default(cuid())
  trackerId  String
  provider   String
  status     String    @default("running") // running | complete | partial | failed
  queriesRun Int       @default(0)
  costUsd    Float     @default(0)
  note       String?
  error      String?
  capturedAt DateTime  @default(now())
  finishedAt DateTime?

  tracker SerpTracker  @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  results SerpResult[]

  @@index([trackerId])
  @@index([trackerId, capturedAt])
}

model SerpResult {
  id                        String   @id @default(cuid())
  snapshotId                String
  queryId                   String
  keyword                   String
  subjectRank               Int? // client's best organic rank_absolute, null if not present
  subjectUrl                String?
  aiOverviewPresent         Boolean  @default(false)
  aiOverviewMentionsSubject Boolean  @default(false)
  featuredSnippetDomain     String?
  topDomains                String   @default("[]") // JSON: [{domain, rank}] first page organic
  competitorsSeen           String   @default("[]") // JSON string[] — project competitors in the SERP
  sourceCount               Int      @default(0) // distinct domains cited across features
  rawItemCount              Int      @default(0)
  costUsd                   Float    @default(0)
  capturedAt                DateTime @default(now())
  /// Whether local-pack visibility is even a meaningful question for this
  /// business (gated on the client's inferred business type — see
  /// analyzeLocalPack). false for a non-local business; the fields below are
  /// then all null/empty rather than a false "missing from Maps" finding.
  localPackApplicable       Boolean  @default(true)
  /// Why `localPackApplicable` is what it is, printed verbatim — never a
  /// silent gate.
  localPackReason           String?
  /// null = not applicable, or no local pack appeared for this query at all.
  localPackPresent          Boolean?
  /// 1-based rank within the pack, when present.
  localPackRank             Int?
  /// JSON LocalPackEntry[] — every business the pack showed, win or lose.
  localPackEntries          String   @default("[]")

  snapshot SerpSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  query    SerpQuery    @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([queryId])
}

// Authority discovery (Agent #6): finds legitimate publications, communities,
// podcasts, and directories where the client could EARN a mention/link, and
// promotes chosen ones into the mention-tracking outreach ledger. Discovery +
// drafting only — no automated outreach, posting, or account creation.
model AuthorityScan {
  id              String    @id @default(cuid())
  projectId       String
  category        String
  method          String    @default("combined") // serp | llm | citations | combined
  status          String    @default("running") // running | complete | partial | failed
  listicleQueries String    @default("[]") // JSON string[] used for SERP discovery
  candidateCount  Int       @default(0)
  promotedCount   Int       @default(0)
  costUsd         Float     @default(0)
  model           String?
  note            String?
  error           String?
  createdAt       DateTime  @default(now())
  finishedAt      DateTime?

  candidates AuthorityCandidate[]

  @@index([projectId])
  @@index([projectId, status])
}

model AuthorityCandidate {
  id               String   @id @default(cuid())
  scanId           String
  projectId        String
  domain           String
  url              String
  title            String
  type             String   @default("publication") // listicle | community | podcast | publication | directory | newsletter
  discoveredVia    String // serp:<keyword> | llm | citation:journey | citation:measurement
  rank             Int? // SERP rank when discovered via SERP
  relevance        Float    @default(0) // 0..1 heuristic
  rationale        String
  status           String   @default("new") // new | promoted | dismissed
  promotedTargetId String? // MentionTarget id once promoted
  createdAt        DateTime @default(now())

  scan AuthorityScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, domain])
  @@index([scanId])
  @@index([scanId, status])
  @@index([projectId])
}

// ─── AEO Audit (ChatGPT-first answer-engine visibility) ───────
// Analysis + approved decisions: docs/analysis/aeo-audit.md
// Orchestrates: intake/fetcher (context) → query-set (matrix) →
// measurement (execution, n>=5) → stance judge → verdict.

// Scraped business context for one project: what they do, which services
// they sell, who buys. The backbone of the prompt matrix — every matrix cell
// interpolates a value that was actually found on the client's own site.
model SiteContext {
  id           String   @id @default(cuid())
  projectId    String
  domain       String
  brand        String
  category     String? // short descriptor, e.g. "b2b logistics software"
  vertical     String? // industry the client sells INTO
  description  String?
  geo          String? // primary market, ISO-3166 alpha-2 code, e.g. "IE"
  markets      String   @default("[]") // JSON string[] — service areas the site names, ranked, ISO-3166 alpha-2 codes
  services     String   @default("[]") // JSON string[] — the offerings sold
  icp          String   @default("[]") // JSON string[] — who buys
  valueProps   String   @default("[]") // JSON string[]
  painPoints   String   @default("[]") // JSON string[] — problems the buyer arrives with
  outcomes     String   @default("[]") // JSON string[] — jobs-to-be-done
  competitors  String   @default("[]") // JSON {name,domain}[] — merged with Project.competitors
  pagesFetched Int      @default(0)
  pageUrls     String   @default("[]") // JSON string[] — exactly what was read
  extraction   String   @default("deterministic") // deterministic | llm-synthesized
  llmModel     String?
  costUsd      Float    @default(0)
  createdAt    DateTime @default(now())
  // P03 (§9.3/§9.4) — the staged run that produced this row, when it was built
  // by the staged pipeline rather than the legacy one-shot path. Nullable so
  // every pre-P03 row (and any direct legacy `build()` call) stays valid.
  runId        String?  @unique
  // JSON Record<field, Array<{url,excerpt,observedAt}>> — per-field source
  // citations for every value above, keyed by the same field names as the
  // arrays themselves ("services", "icp", …). "[]" when a field has no
  // citation on file (pre-P03 rows, or a field the pipeline left empty).
  fieldSources String   @default("{}")
  // JSON Record<field, string[]> — every site-context-v2 expanded field's
  // deduped validated values (legalName, headquarters, leadership, ...).
  facts        String   @default("{}")

  // Site-context-v2 (docs/analysis/site-context-v2.md) — identity resolution,
  // completeness/confidence scoring, and the digital-presence merge.
  // company | product-microsite | subsidiary | franchise | regional-site | personal-brand | marketplace-listing | unknown
  identityType       String?
  identityConfidence Float?
  // JSON Record<category, number 0-1> — per-category completeness, weighted per §22.
  completeness        String @default("{}")
  overallCompleteness Float  @default(0)
  // JSON Array<{platform,url,state}> — confirmed PresenceAccount rows for this
  // project at compile time (read-only merge; this module never writes to
  // digital-presence). "[]" when digital-presence has nothing confirmed yet.
  socialProfiles String @default("[]")

  audits         AeoAudit[]
  run            SiteContextRun?              @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([projectId, createdAt])
}

// ─── P03 — staged website-understanding pipeline (plan §9.3/§9.4) ─────────
// One persisted, resumable run through discover → inspect → select →
// extract → reconcile → validate. `status`/`stage` follow the same
// last-completed-stage convention `AeoAudit` already uses, so a crash mid
// run resumes from the last persisted stage rather than restarting —
// re-fetching only pages that were never successfully read, and retrying
// only extraction that actually failed, up to a capped number of attempts.
model SiteContextRun {
  id        String @id @default(cuid())
  projectId String
  domain    String

  // pending | discovering | inspecting | selecting | extracting | reconciling | validating | consolidating | completed | failed
  status String  @default("pending")
  // last stage fully persisted — what a resume reads to know where to continue
  stage  String?
  error  String?

  // Budgets (§9.4): tracked and enforced independently, never traded off
  // against each other. A failed page's retries are capped by
  // maxRetriesPerPage regardless of how much of the other budgets remain.
  maxPages         Int @default(12)
  maxRequests      Int @default(40)
  maxChars         Int @default(24000)
  maxElapsedMs     Int @default(300000)
  maxRetriesPerPage Int @default(2)

  // Actual spend, updated as the run progresses.
  pagesSpent    Int @default(0)
  requestsSpent Int @default(0)
  charsSpent    Int @default(0)
  elapsedMs     Int @default(0)

  refine Boolean @default(true) // whether the extract stage may call the LLM

  // JSON: purpose-category coverage plan produced by the select stage, e.g.
  // {"homepage":{"target":1,"filled":1},"pricing":{"target":1,"filled":0},...}
  coveragePlan String @default("{}")
  // JSON string[] — human-readable notes from reconcile/validate: unresolved
  // conflicts, dropped unsupported assertions, incomplete-discovery disclosures.
  notes        String @default("[]")

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  pages             SiteContextRunPage[]
  facts             SiteContextFact[]
  categorySummaries SiteContextCategorySummary[]
  context           SiteContext?

  @@index([projectId])
  @@index([projectId, createdAt])
}

// One candidate/discovered page within a run — stage 1's persisted candidate
// inventory, enriched in place by stage 2 (metadata) and stage 3 (selection),
// consumed (not re-fetched) by stage 4.
model SiteContextRunPage {
  id              String @id @default(cuid())
  runId           String
  url             String
  discoverySource String // homepage | sitemap | nav | guess

  fetched     Boolean   @default(false)
  statusCode  Int?
  fetchedAt   DateTime?
  // Cached fetched content so stage 4 never re-fetches a page stage 1/2
  // already read. Large text is truncated at capture time (see service).
  html        String?
  text        String?

  // Stage 2 — metadata inspection.
  title           String?
  description     String?
  headings        String  @default("[]") // JSON string[]
  language        String?
  pageType        String? // homepage | service | about | pricing | industries | location | case-study | blog | login | cart | policy | leadership | security | press | careers | partner | other
  contentHash     String?
  duplicateOfUrl  String?
  // JSON Array<{type,fields,raw}> — every JSON-LD block parsed off this page
  // (Organization/LocalBusiness/Product/Service/Offer/Person/PostalAddress/…),
  // kept verbatim as evidence, not truth (site-context-v2 step 9).
  jsonLd          String  @default("[]")

  // Stage 3 — selection.
  selected        Boolean @default(false)
  selectionReason String?
  purposeCategory String? // homepage | service-product | about | pricing | industries | location | case-study | other

  // Stage 4 — extraction.
  extractStatus String  @default("pending") // pending | success | failed | skipped
  extractError  String?
  retryCount    Int     @default(0)

  run SiteContextRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, url])
  @@index([runId])
  @@index([runId, selected])
}

// One extracted, cited assertion. Stage 4 writes these; stage 6 flips
// `validated` after checking the assertion against its own cited page text
// (never against another page's), and an unsupported assertion is excluded
// from the final `SiteContext` row rather than deleted — the record of what
// was proposed and rejected stays on file.
model SiteContextFact {
  id    String @id @default(cuid())
  runId String
  // services | icp | valueProps | painPoints | outcomes | markets | category | vertical |
  // description | brand | geo | legalName | alternateName | foundedYear | headquarters |
  // officeLocation | languages | pricingModel | differentiator | leadership | certification |
  // award | partner | technology | businessModel | contact
  field String
  value String

  sourceUrl   String
  excerpt     String?
  contentHash String?
  observedAt  DateTime @default(now())

  validated      Boolean @default(false)
  validationNote String?

  // explicit | strong_inference | weak_inference | conflicted (site-context-v2 step 13).
  // "explicit" for deterministic/JSON-LD facts and LLM facts the model marked directly stated.
  factType   String @default("explicit")
  // 0-1, computed from factType + page-type authority + cross-source agreement —
  // never the LLM's bare self-report alone (step 13's own rule).
  confidence Float  @default(0.7)

  run SiteContextRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([runId, field])
}

// One category-level consolidation of a run's validated facts (site-context-v2
// step 18): merges duplicates, keeps distinct offerings separate, surfaces
// conflicts and a missing-field list per category rather than one
// undifferentiated reconcile pass over every field at once.
model SiteContextCategorySummary {
  id            String   @id @default(cuid())
  runId         String
  // identity | descriptions | offerings | positioning | customers | geography |
  // organization | credibility | go_to_market | technology
  category      String
  summary       String?
  facts         String   @default("[]") // JSON string[] — canonical facts for this category
  inferences    String   @default("[]") // JSON string[] — supported but not directly stated
  conflicts     String   @default("[]") // JSON string[] — contradictions found within the category
  missingFields String   @default("[]") // JSON string[] — expected fields this category has no evidence for
  confidence    Float    @default(0)
  createdAt     DateTime @default(now())

  run SiteContextRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, category])
  @@index([runId])
}

// One AEO audit: a context + a generated matrix + a measurement run on one
// surface + the stance pass + the rolled-up verdict.
model AeoAudit {
  id           String    @id @default(cuid())
  projectId    String
  contextId    String?
  querySetId   String? // the generated matrix (a QuerySet with source="aeo-matrix")
  runId        String? // MeasurementRun id once execution starts
  // The primary surface (first in `surfaces`). Kept for single-surface callers.
  surface      String    @default("chatgpt-browser") // chatgpt-browser | perplexity-browser | gemini-browser | mock
  // JSON string[] — every surface this audit measures. One AeoSurfaceRun each.
  surfaces     String    @default("[]")
  // JSON string[] — the resolved market(s), ISO-3166 alpha-2 codes (wave-6 D8).
  // Empty until resolved: explicit override resolves at start(), the
  // context-derived default resolves once context loads in resume().
  markets      String    @default("[]")
  tier         String    @default("standard") // scorecard | standard | full
  runCount     Int       @default(5) // n>=5, enforced by measurement
  status       String    @default("pending") // pending | context | matrix | running | judging | completed | failed
  stage        String? // last completed stage, for resumability
  promptCount  Int       @default(0)
  observations Int       @default(0)
  stanceJudged Int       @default(0)
  costUsd      Float     @default(0)
  verdict      String? // JSON AeoVerdict — rates, SOV, per-dimension, stance roll-up
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())

  context     SiteContext?    @relation(fields: [contextId], references: [id], onDelete: SetNull)
  stances     AeoStance[]
  surfaceRuns AeoSurfaceRun[]

  @@index([projectId])
  @@index([status])
  @@index([runId])
}

// One measured surface within an audit. The same prompt matrix is run on each,
// which is what makes "named on Perplexity, invisible on ChatGPT" reportable.
// A surface that fails (blocked, no session, UI drift) records its reason here
// and leaves the others intact — one dead surface must not void the audit.
model AeoSurfaceRun {
  id           String    @id @default(cuid())
  auditId      String
  surface      String // the requested surface, e.g. cloro-chatgpt | chatgpt-browser | mock
  /// ISO-3166 alpha-2 market code this row measures. Null = not yet resolved
  /// (context-derived default, stamped in during resume()'s context stage);
  /// an explicit `markets[]` override on the request resolves this at start().
  market       String?
  runId        String? // MeasurementRun id once execution starts
  status       String    @default("pending") // pending | running | completed | failed | skipped
  observations Int       @default(0)
  stanceJudged Int       @default(0)
  costUsd      Float     @default(0)
  /// Typed failure reason from the adapter (blocked, rate-limited, selector-drift…).
  failureKind  String?
  error        String?
  /// The surface that actually answered, when it differs from `surface` — set
  /// when a failed `cloro-*` surface falls back to its `*-browser` equivalent,
  /// so a fallback run is never reported as a Cloro measurement.
  attemptedVia String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())

  audit AeoAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, surface, market])
  @@index([auditId])
  @@index([runId])
}

// Judged (never counted) competitive stance for one Observation.
// Rates come from measurement's deterministic extraction; this row only says
// HOW the client was positioned. Kept in a separate table so no consumer can
// mistake an LLM opinion for a measured rate.
model AeoStance {
  id              String   @id @default(cuid())
  auditId         String
  observationId   String
  /// Copied so stance rolls up per surface without joining back through the run.
  surface         String?
  dimension       String? // copied from the QuerySetItem for roll-up without a join
  stance          String // recommended-primary | recommended-alternative | mentioned-neutral | mentioned-negative | absent
  rankAmongBrands Int? // 1-based position among brands named in the answer
  brandsNamed     String   @default("[]") // JSON string[] — every brand the answer named, in order
  recommendedOver String   @default("[]") // JSON string[] — competitors the answer put the client ABOVE
  losesTo         String   @default("[]") // JSON string[] — competitors the answer put ABOVE the client
  /// JSON string[] — brands the answer named that were NOT already in
  /// Project.competitors when this was judged. Raw LLM output, never
  /// filtered through knownOnly() — routed to Competitor(status=candidate)
  /// for an operator to confirm, never trusted directly.
  otherNamesSeen  String   @default("[]")
  evidenceQuote   String? // <=280 chars, verbatim from the answer
  rationale       String?
  judgeModel      String
  costUsd         Float    @default(0)
  createdAt       DateTime @default(now())

  audit AeoAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, observationId])
  @@index([auditId])
  @@index([auditId, stance])
  @@index([auditId, surface])
}

// ─── Digital Presence ───────────────────────────────────────────────────────
// Where the client exists on the internet, discovered from their own site and
// corrected by the operator. Analysis: docs/analysis/digital-presence.md.

/// One account/profile the client owns on an external platform.
///
/// `state` carries three values, never two. A profile linked from the client's
/// own footer that we then fail to fetch is NOT a missing account -- Instagram
/// and Facebook serve login walls and LinkedIn returns 999 to datacentre IPs, so
/// `unverified` is the routine, honest outcome for exactly the platforms that
/// matter most. Collapsing it into `missing` would report a working account as
/// absent.
model PresenceAccount {
  id         String    @id @default(cuid())
  projectId  String
  platform   String
  url        String
  handle     String?
  /// json-ld-sameas | page-link | manual | serp. Operator entry outranks both
  /// crawlers and is never overwritten by a re-run.
  source     String
  /// company | personal | unknown. The audit is about the company; a founder's
  /// own LinkedIn or Google Scholar page is recorded but never counted as the
  /// company's reach.
  entity     String    @default("company")
  /// confirmed | unverified | missing
  state      String
  /// Why verification could not be completed. Set only when state=unverified;
  /// the UI prints it verbatim rather than inventing a summary.
  reason     String?
  statusCode Int?
  title      String?
  /// Page the link was found on -- lets an operator check the finding at source.
  /// For a SERP candidate this is the query that produced it, so the finding is
  /// reproducible.
  foundOn    String?
  /// 0-1 handle-vs-brand similarity, set on `candidate` rows only. An ordering
  /// hint for the operator; no code branches on it.
  confidence Float?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  /// Apify social-activity rows attached to this account (wave-6 D7). Optional:
  /// a post is still worth keeping if the account row it belonged to is later
  /// deleted, so the FK clears rather than cascades.
  posts PresencePost[]

  @@unique([projectId, platform, url])
  @@index([projectId])
  @@index([projectId, platform])
}

/// One discovery run over the client's site.
model PresenceDiscovery {
  id           String    @id @default(cuid())
  projectId    String
  /// pending | crawling | verifying | completed | failed
  status       String    @default("pending")
  pagesFetched Int       @default(0)
  found        Int       @default(0)
  confirmed    Int       @default(0)
  unverified   Int       @default(0)
  /// Search suggestions raised, awaiting an operator's yes/no.
  candidates   Int       @default(0)
  /// Billable DataForSEO queries on this run. Cache hits are excluded — they
  /// cost nothing, and counting them would price the next run wrongly.
  serpQueries  Int       @default(0)
  /// Real charge read off DataForSEO's response envelope. Never estimated.
  serpCostUsd  Float     @default(0)
  /// Why the SERP sweep did not run (no key, no brand, budget reached).
  serpSkipped  String?
  /// JSON: per-source counts, so the report can show where each account came from.
  sources      String?
  error        String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([projectId, startedAt])
}

/// P05 §11.2 — the explicit applicability policy, persisted as versioned
/// overrides only. The computed default (business type × delivery model ×
/// local presence × markets) is pure and re-derived on every read; this table
/// exists solely so a staff/client correction survives a rediscovery run
/// instead of being silently recomputed away.
model PresenceApplicabilityOverride {
  id          String    @id @default(cuid())
  projectId   String
  platform    String
  /// relevant | optional | not-relevant | needs-confirmation
  status      String
  reason      String
  /// Rule version the override was made against, so a later engine change is
  /// visible as "this override predates the current rules" rather than silently
  /// reinterpreted.
  ruleVersion String
  actorEmail  String?
  createdAt   DateTime  @default(now())
  /// Null while active. A superseding override does not delete history — it is
  /// simply no longer the latest row for this projectId+platform.
  supersededAt DateTime?

  @@index([projectId, platform])
}

/// P05 §11.4 — "a human said this candidate is not ours." Keyed by normalized
/// URL so the next discovery/SERP run does not keep resurfacing the same
/// rejected candidate. No hard delete: `reconsideredAt` records an authorized
/// undo without destroying the original rejection.
model PresenceRejection {
  id               String    @id @default(cuid())
  projectId        String
  platform         String
  /// Lowercased, tracking-params stripped, trailing slash trimmed — the same
  /// normalization the account dedupe already applies.
  normalizedUrl    String
  reason           String
  actorEmail       String?
  createdAt        DateTime  @default(now())
  reconsideredAt   DateTime?
  reconsideredBy   String?

  @@index([projectId, platform, normalizedUrl])
}

// ─── Tech Stack (wave-6 D3/step 3) ──────────────────────────────────────────
// Deterministic technology fingerprinting over one fetched homepage — no
// vendor, no per-lookup cost. Analysis: docs/analysis/tech-stack.md, decision
// D3 in docs/analysis/wave-6-audit-pipeline.md.

/// One scan of one domain. `domain` may differ from Project.domain — the same
/// scan is reused, unchanged, to profile a competitor's site (wave-6 step 6).
model TechStackScan {
  id        String   @id @default(cuid())
  projectId String
  domain    String
  /// completed | failed. A blocked/unreachable fetch is a reportable outcome
  /// (see `error`), not a thrown error — the row still gets written.
  status    String   @default("completed")
  error     String?
  createdAt DateTime @default(now())

  findings TechFinding[]

  @@index([projectId])
  @@index([projectId, domain, createdAt])
}

/// One detected technology within a scan.
model TechFinding {
  id         String @id @default(cuid())
  scanId     String
  /// analytics | ads | crm | chat | cms | hosting | cdn | ecommerce | tag-manager | ab-testing
  category   String
  name       String
  /// Signature matches are binary today (always 1); reserved for future weighting.
  confidence Float  @default(1)
  /// JSON string[] — the literal matched header value/script URL/HTML snippet, for auditability.
  evidence   String

  scan TechStackScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([scanId, category])
}

// ─── Keyword Research (wave-6 D5/step 4) ────────────────────────────────────
// Search volume, competition/CPC, and related/long-tail expansion for a set of
// operator-supplied seed keywords via DataForSEO Keywords Data (same vendor
// account as serp-intelligence). Analysis: docs/analysis/wave-6-audit-pipeline.md
// §D5. Pulled forward from stage 10 on the operator's instruction; may later
// feed the AEO matrix generator a demand weighting (not built here — stretch).

/// One research run: the seed keywords the operator submitted, plus whatever
/// DataForSEO returned for them. `status` follows the same discipline as
/// `TechStackScan` — a reachable-but-empty or partially-failed vendor call is
/// a reportable outcome, not a thrown error, once past the credential gate.
model KeywordSet {
  id           String    @id @default(cuid())
  projectId    String
  /// JSON string[] — the operator's own seed keywords, verbatim, before
  /// normalization (trim/lowercase/dedupe) for the vendor call.
  seedInput    String
  locationName String?
  languageCode String?
  /// pending | completed | partial | failed. `partial` = seed volumes saved
  /// but the related/long-tail expansion call failed (see `error`).
  status       String    @default("pending")
  /// Set on `partial`/`failed`; null on a clean `completed` run.
  error        String?
  /// Real vendor charge only — DataForSEO's own reported `cost`, the same
  /// discipline as `SerpSnapshot.costUsd`. Never estimated.
  costUsd      Float     @default(0)
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?

  keywords Keyword[]

  @@index([projectId])
  @@index([projectId, createdAt])
}

/// One keyword's volume/competition/CPC row within a KeywordSet — either an
/// operator-supplied seed or a related/long-tail suggestion DataForSEO
/// returned for those seeds.
model Keyword {
  id    String @id @default(cuid())
  setId String

  keyword          String
  searchVolume     Int?
  /// LOW | MEDIUM | HIGH — DataForSEO's Google Ads advertiser-competition
  /// bucket. A demand-pressure proxy, NOT an organic SEO ranking-difficulty
  /// score (DataForSEO Keywords Data has no such metric) — reported as what
  /// it actually is, not relabelled into something it isn't.
  competition      String?
  /// Same metric as `competition`, 0-100. Same caveat.
  competitionIndex Int?
  cpc              Float?
  lowTopOfPageBid  Float?
  highTopOfPageBid Float?
  /// false for the operator's own seed keywords, true for a suggestion
  /// returned by the related-keywords expansion call.
  isRelated        Boolean  @default(false)
  /// Heuristic: 4+ words. Auditable, not vendor-supplied.
  isLongTail       Boolean  @default(false)
  createdAt        DateTime @default(now())

  set KeywordSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, keyword])
  @@index([setId])
  @@index([setId, searchVolume])
}

// ─── Backlinks (DataForSEO Backlinks API, added 2026-09-13) ───────────────
// Same vendor account, same Basic-Auth + SWARM_ALLOW_LIVE convention as
// serp-intelligence/keyword-research — see backlinks/README.md.

/// One pull of a domain's backlink profile — `backlinks/summary/live`
/// (one billed row: $0.024 + $0.000036/row, effectively a fixed ~$0.024-0.03
/// per call) plus a small sample of actual top backlinks from
/// `backlinks/backlinks/live` for evidence, not just aggregate counts.
model BacklinksSummary {
  id     String @id @default(cuid())
  projectId String
  /// The domain/subdomain/page actually queried — normalized from
  /// Project.domain unless the caller overrides it.
  target String

  status String  @default("pending") // completed | partial | failed
  error  String?
  /// Real vendor charge — DataForSEO's own reported `cost`, both calls summed.
  costUsd Float  @default(0)

  rank                 Int?
  backlinks            Int?
  backlinksSpamScore   Int?
  referringDomains     Int?
  referringMainDomains Int?
  referringPages       Int?
  referringIps         Int?
  referringSubnets     Int?
  brokenBacklinks      Int?
  brokenPages          Int?
  firstSeen            DateTime?
  lostDate             DateTime?

  /// JSON Record<string, number> distribution breakdowns, straight off the
  /// vendor response — never re-derived.
  referringLinksTld           String? // JSON
  referringLinksTypes         String? // JSON
  referringLinksAttributes    String? // JSON
  referringLinksPlatformTypes String? // JSON
  referringLinksCountries     String? // JSON

  /// JSON BacklinkSampleItem[] — up to `topBacklinksLimit` individual
  /// backlinks (evidence a report can actually show, not just a count).
  topBacklinks String @default("[]")

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([projectId, createdAt])
}

// ─── Competitors (wave-6 D4/step 6) ────────────────────────────────────────
// Promotes Project.competitors (JSON) into first-class rows, then builds a
// light per-competitor profile: homepage tech-stack scan (reusing
// tech-stack.module.ts unchanged) + schema/JSON-LD read + a reference to
// whatever SERP/AEO presence already exists for that competitor. Decision D4
// (docs/analysis/wave-6-audit-pipeline.md): "light now, structured to deepen
// later" — explicitly NOT a full technical-audit per competitor.

/// One competitor entity for a project. `Project.competitors` (JSON) stays
/// populated and readable on purpose (existing consumers — measurement,
/// aeo-audit, authority, serp-intelligence — keep working unchanged); this
/// table is additive, not a replacement.
model Competitor {
  id        String   @id @default(cuid())
  projectId String
  name      String
  domain    String?
  /// project-json (promoted from Project.competitors) | manual (operator-added
  /// via an explicit body list on /discover) | aeo-answer (name an AI surface
  /// mentioned that wasn't already recorded — see AeoStanceService) |
  /// market-discovery (§12.2 — composed from confirmed services/segments +
  /// target markets, plus names/domains already observed in stored AEO/SERP
  /// evidence; see CompetitorsService.discoverByMarket)
  source    String   @default("project-json")
  /// tracked | candidate. Candidates are never profiled, never shown in
  /// /discover or /gap, and never fed back into the AEO stance prompt as a
  /// "known competitor" — they need an explicit confirm first (D: an
  /// LLM-mentioned name is not yet a trusted competitive claim).
  status    String   @default("tracked")
  /// direct-competitor | adjacent-alternative | not-relevant (§12.2).
  /// Manually/explicitly added competitors default to direct-competitor;
  /// market-discovery candidates are classified by grounded heuristics
  /// (never an invented domain) and can be reclassified by an operator via
  /// PATCH .../candidates/:id/relevance without needing a confirm/reject.
  relevance       String  @default("direct-competitor")
  /// Free-text explanation of why a market-discovery candidate was
  /// suggested (matched service/market/evidence source) — shown to the
  /// operator doing the review; null for project-json/manual/aeo-answer rows.
  discoveryReason String?
  createdAt DateTime @default(now())

  profiles CompetitorProfile[]

  @@unique([projectId, name])
  @@index([projectId])
}

/// Rejection memory (§12.2 third paragraph): a candidate a human explicitly
/// discarded must not keep resurfacing. Keyed on both the lowercased name and
/// (when known) the canonical domain, since a rediscovery pass may find the
/// same rival again under a slightly different name but the same domain, or
/// vice versa. Read by CompetitorsService.listCandidates (filters out any
/// candidate row matching a tombstone — self-heals rows written by other
/// producers, e.g. AeoStanceService) and by discoverByMarket (never re-proposes
/// a match). There is no undo; re-adding is always available as an explicit
/// manual add, which is a deliberate act distinct from a rediscovery loop.
model CompetitorRejection {
  id        String   @id @default(cuid())
  projectId String
  /// Lowercased, trimmed candidate name at rejection time.
  nameKey   String
  /// Canonical registrable domain (via hostOf()) at rejection time, null when
  /// the rejected candidate had no domain on record.
  domainKey String?
  reason    String?
  createdAt DateTime @default(now())

  @@unique([projectId, nameKey])
  @@index([projectId, domainKey])
}

/// A frozen comparison (§12.3): exactly which source observations, extraction
/// version and competitor-set version produced a given GapResult. Written as a
/// new row on every GET .../gap call (an "Update comparison" read from
/// already-stored evidence — never a new paid AEO/SERP/tech run). Never
/// mutated after creation: the `result` JSON keeps the competitor set and
/// figures exactly as computed at that moment, so an older snapshot stays
/// readable even after competitors are added/removed later.
model CompetitorComparisonSnapshot {
  id                    String   @id @default(cuid())
  projectId             String
  /// Hash of the sorted (competitorId:status) pairs considered — lets a
  /// reader tell whether two snapshots were built over the same tracked set.
  competitorSetVersion  String
  /// Bumped only when the comparison's derivation logic changes shape.
  extractionVersion     String   @default("gap-v1")
  /// JSON { techScanIds, profileIds, aeoAuditIds, serpResultSample } — the
  /// exact source observation ids the comparison was derived from.
  sourceObservationIds  String
  /// The full frozen GapResult, JSON-stringified, exactly as returned to the
  /// caller at generation time.
  result                String
  generatedAt           DateTime @default(now())

  @@index([projectId, generatedAt])
}

/// One light profile snapshot for a competitor. A new row per `/discover`
/// call (never overwritten), same convention as TechStackScan/AeoAudit — the
/// latest is whatever the caller wants, history stays inspectable.
model CompetitorProfile {
  id               String   @id @default(cuid())
  competitorId     String
  domain           String? // copied from Competitor.domain at profile time
  /// completed | failed | skipped. `skipped` = no domain on record, so no
  /// homepage could be crawled (AEO/SERP attachment by name still runs).
  status           String   @default("completed")
  error            String?
  /// TechStackScan.id this profile reused — tech-stack already persists
  /// findings, so we reference rather than duplicate them.
  techScanId       String?
  /// JSON string[] — schema.org @type values found on the homepage.
  schemaTypes      String   @default("[]")
  /// JSON SchemaBlock[] — {type, fields} per JSON-LD block found; see fetcher.types.ts.
  schemaRaw        String   @default("[]")
  /// present | absent | unknown. `unknown` = no completed AeoAudit exists yet
  /// for this project at all (nothing to attach, not "no presence").
  aeoStatus        String   @default("unknown")
  /// JSON snapshot of the matched CompetitorStanding (+ share-of-voice), null
  /// when aeoStatus != "present".
  aeoStanding      String?
  /// AeoAudit.id the snapshot was read from, for traceability.
  aeoAuditId       String?
  /// present | absent | unknown. `unknown` = the project has no SERP tracker
  /// at all yet.
  serpStatus       String   @default("unknown")
  /// JSON summary {seenInResults, occurrences, bestRank, sampleKeyword,
  /// capturedAt}, null when serpStatus != "present".
  serpPresence     String?
  /// completed | skipped | failed | unknown. `skipped` = no domain to crawl.
  /// Wave-6 step 6: the rival's own external presence, so the gap report can
  /// say "they are on Instagram and you are not" rather than comparing only
  /// tech stacks.
  presenceStatus   String   @default("unknown")
  /// JSON {platform,label,group,url,handle,state}[] — COMPANY profiles only;
  /// a rival founder's personal LinkedIn is not their company's footprint.
  presenceAccounts String   @default("[]")
  presenceError    String?
  /// completed | skipped | failed | unknown. Stage 7's "Competitor SEO" and
  /// "Competitor Content" columns. Derived from the SAME homepage HTML the
  /// schema read already fetched, so it costs no extra request, and scored by
  /// the SAME `seo-rubric.ts` the client's own pages are scored by -- two
  /// rubrics would make "client 62 vs rival 71" a comparison of nothing.
  seoStatus        String   @default("unknown")
  /// 0-100 from `scorePage()`. Null unless seoStatus = completed. HOMEPAGE
  /// ONLY -- never presented as a site-wide score, which would need the rival's
  /// sitemap crawled.
  seoScore         Int?
  /// JSON PageIssueCode[] -- the rubric's own codes, same vocabulary as AuditPage.issues.
  seoIssues        String   @default("[]")
  /// JSON {wordCount,h1Count,headingLevels,imageCount,imagesMissingAlt,
  /// titleLength,metaDescriptionLength,jsonLdCount,noindex} -- stage 7's
  /// "Competitor Content" read. Homepage only; a content *inventory* needs
  /// their sitemap, which this module does not crawl.
  contentSignals   String?
  seoError         String?
  /// completed | skipped | failed | unknown. Stage 7's "Competitor Reviews".
  /// Reads the AggregateRating a directory listing already publishes about
  /// itself -- no review vendor, no per-lookup cost.
  reviewStatus     String   @default("unknown")
  /// JSON {platform,label,url,rating,ratingCount,scale,found}[] -- one row per
  /// ratable listing discovered. `found: false` is kept, not dropped: "they are
  /// on G2 but publish no rating" and "they are not on G2" are different facts.
  reviewRatings    String   @default("[]")
  reviewError      String?
  /// completed | skipped | failed | unknown. Discoverability-pipeline Stage 4
  /// step 3 (2026-09-22): homepage-only company-context enrichment. Reverses
  /// SPEC.md's D4 "not built" for the light case — extracted from the SAME
  /// homepage HTML + JSON-LD the schema/SEO read already fetched, so it costs
  /// no extra request. NOT the full multi-page Stage-1 site-context crawl
  /// (that would need the rival's sitemap crawled — deliberately out of scope).
  companyContextStatus String @default("unknown")
  /// JSON {brand,description,category,keywords[],socialProfiles[]} — the rival's
  /// own company context read off its homepage. Null when not derivable.
  companyContext   String?
  createdAt        DateTime @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@index([competitorId, createdAt])
}

// ─── Digital Presence — external data (wave-6 step 5) ──────────────────────
// The two gaps `PresenceAssessment.notMeasured` used to name: business-profile
// data and review ratings (DataForSEO, decision D2) and social activity
// (Apify, decision D7). Analysis: docs/analysis/wave-6-audit-pipeline.md.

/// One Google Business Profile snapshot -- DataForSEO Business Data -> Google
/// My Business Info. `rating`/`reviewCount` here are the profile's own
/// aggregate as My Business reports it; `PresenceReview` below records each
/// review PLATFORM's own count separately, since they rarely agree.
///
/// A project accumulates snapshots over time (no unique constraint on
/// `projectId` alone) rather than upserting one row -- the point of a
/// business profile is that hours, categories and rating drift, and a
/// re-pull should not erase what the last one saw.
model PresenceProfile {
  id          String   @id @default(cuid())
  projectId   String
  /// google-my-business today; room for another Business Data profile source
  /// later without a migration.
  source      String   @default("google-my-business")
  name        String?
  /// JSON string[] -- the categories Google lists the business under.
  categories  String?
  /// JSON, stored in whatever shape the provider returns it -- opening hours
  /// per day. Not reshaped here so a display bug can never come from a lossy
  /// re-encoding of the provider's own structure.
  hours       String?
  rating      Float?
  reviewCount Int?
  address     String?
  phone       String?
  website     String?
  /// The full provider response, verbatim. Nothing this module cannot yet
  /// parse is lost -- only unsurfaced until a mapping is added.
  raw         String?
  fetchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([projectId, source, fetchedAt])
}

/// One review-platform snapshot. Rating + count ONLY -- neither adapter that
/// writes this table invents a sentiment score over review text (see
/// wave-6-audit-pipeline.md D2).
model PresenceReview {
  id          String   @id @default(cuid())
  projectId   String
  /// google | trustpilot | yelp | g2 | capterra | glassdoor | yelp | clutch |
  /// crunchbase | producthunt -- any RATABLE_PLATFORMS entry, not a closed enum.
  platform    String
  rating      Float?
  reviewCount Int?
  url         String?
  raw         String?
  /// dataforseo (Business Data API, google/trustpilot/yelp only) |
  /// schema-scrape (AggregateRating read off the listing page itself --
  /// presence.directory-rating.service.ts, the platforms DataForSEO does not
  /// cover). Defaulted for backward compatibility with rows written before
  /// this column existed -- all of which came from DataForSEO.
  source      String   @default("dataforseo")
  fetchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([projectId, platform, fetchedAt])
}

/// One social-activity row from the Apify enrichment (wave-6 D7). A row is
/// either a **profile** snapshot (`kind = "profile"`, `postedAt` null,
/// `followerCount`/`followingCount`/`postCount` set) or one **post**
/// (`kind = "post"`, `postedAt` set, the engagement columns set). Both share
/// this table because they come from the same actor family and answer the
/// same question -- "how active is this account?" -- and splitting them into
/// two tables would only add a join to answer it.
///
/// Every actor family's raw output is normalised into these columns at the
/// adapter boundary (`presence.apify.service.ts`) precisely so this shape
/// never has to change when an actor's own schema does.
model PresencePost {
  id             String    @id @default(cuid())
  projectId      String
  /// The account this enriches, when one is on file. Nullable: a platform can
  /// still be pulled by handle even before/without a confirmed PresenceAccount
  /// row, and losing that account later must not delete its post history.
  accountId      String?
  /// linkedin | instagram | facebook | twitter | youtube | tiktok
  platform       String
  /// profile | post
  kind           String    @default("post")
  postedAt       DateTime?
  url            String?
  /// Short caption/text, kept for context -- this module measures cadence and
  /// engagement, not archives content.
  caption        String?
  likeCount      Int?
  commentCount   Int?
  shareCount     Int?
  viewCount      Int?
  followerCount  Int?
  followingCount Int?
  postCount      Int?
  /// The Apify actor id that produced this row -- actor output drifts, so
  /// knowing which actor made a claim matters for auditing it later.
  actorId        String?
  raw            String?
  fetchedAt      DateTime  @default(now())
  createdAt      DateTime  @default(now())

  account PresenceAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([projectId, platform, fetchedAt])
  @@index([accountId])
}

/// One brand-voice read, synthesised from the captions `PresencePost` already
/// holds (wave-6 D7's Apify pull) -- how the client actually writes, not what
/// they post about. Same two-layer discipline as `SiteContext`:
/// `extraction: "insufficient-data"` when there are too few captions or no LLM
/// provider is configured (never a fabricated voice from nothing), else
/// `"llm-synthesized"` from a constrained-JSON pass grounded in the real text.
model PresenceBrandVoice {
  id            String   @id @default(cuid())
  projectId     String
  domain        String
  /// JSON string[] -- short adjectives ("confident", "playful"), each backed
  /// by a real pattern in the captions.
  tone          String   @default("[]")
  /// JSON string[] -- recurring topics ("product updates", "customer wins").
  themes        String   @default("[]")
  /// JSON string[] -- distinctive repeated words/phrases, this brand's own
  /// language rather than generic marketing copy.
  vocabulary    String   @default("[]")
  /// JSON string[] -- recurring CTA patterns ("Book a call", "Link in bio").
  callToActions String   @default("[]")
  /// 1-2 plain sentences, written for someone about to write copy in the same voice.
  summary       String?
  /// Total captions the synthesis actually read across all platforms.
  postSample    Int      @default(0)
  /// JSON: per-platform tone/themes breakout, ONLY populated when the voice
  /// genuinely differs by platform -- an empty array means one voice covers
  /// everything, not that per-platform analysis was skipped.
  byPlatform    String   @default("[]")
  /// llm-synthesized | insufficient-data
  extraction    String   @default("insufficient-data")
  llmModel      String?
  costUsd       Float    @default(0)
  createdAt     DateTime @default(now())

  @@index([projectId])
  @@index([projectId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════
// design_plan.md Appendix A — G01..G20
//
// Convention note: cross-module references are plain String ids with an
// @@index, not Prisma relations. That matches the existing house style
// (see Client.ownerUserId) and keeps module boundaries from turning into
// a cascade-delete graph across the whole schema.
//
// SQLite has no enums and no arrays: status-ish columns are String with
// the permitted values in a comment, and list/object columns are JSON
// strings defaulting to "[]" / "{}".
// ═══════════════════════════════════════════════════════════════════

// ─── G01 — Identity lifecycle ──────────────────────────────────────

/// Single-use, expiring token for password reset AND invitation acceptance.
/// Only the hash is stored, so a database read cannot be replayed as a login.
model AuthToken {
  id        String    @id @default(cuid())
  /// sha256 of the token handed to the user. Never the raw token.
  tokenHash String    @unique
  /// password-reset | invite | email-verify
  purpose   String
  /// Target user. Null for an invite that has not been accepted into a user yet.
  userId    String?
  /// Invitation target address, so an unaccepted invite still knows its recipient.
  email     String?
  /// JSON — invite scope: { clientId, role, projectIds }. Server-resolved on accept.
  scope     String    @default("{}")
  expiresAt DateTime
  /// Set the moment it is redeemed. A non-null value makes replay fail.
  usedAt    DateTime?
  /// Set when an operator revokes an outstanding invite/reset.
  revokedAt DateTime?
  createdBy String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([email])
  @@index([purpose, expiresAt])
}

/// One issued session, so "sign out everywhere" and immediate revocation are
/// real server state rather than a client-side token delete.
model UserSession {
  id           String    @id @default(cuid())
  userId       String
  /// Correlates to the RefreshToken family issued for this session.
  refreshaudit String?
  userAgent    String?
  ipAddress    String?
  /// Coarse label for the session list UI ("Chrome on macOS").
  deviceLabel  String?
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  /// user-logout | logout-all | admin-revoke | password-change | expired
  revokedvia   String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([userId, revokedAt])
}

// ─── G02 — Client seats, invitations, delegated connections ────────

/// A client-side seat. Distinct from User: a User is a login, a ClientMember
/// is that login's role and project scope within one Client.
model ClientMember {
  id         String    @id @default(cuid())
  clientId   String
  userId     String
  /// client-admin | client-collaborator | client-viewer
  role       String    @default("client-collaborator")
  /// JSON string[] of Project ids. Empty array means "all projects of this
  /// client" — an explicit convention, checked server-side, never inferred.
  projectIds String    @default("[]")
  /// active | suspended
  status     String    @default("active")
  invitedBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  removedAt  DateTime?

  @@unique([clientId, userId])
  @@index([userId])
  @@index([clientId, status])
}

/// Lets a second operator (or a client seat) consume a Google grant somebody
/// else authorized, without ever handing over the refresh token itself.
model ConnectionDelegation {
  id           String    @id @default(cuid())
  /// GoogleConnection.id being delegated.
  connectionId String
  projectId    String
  /// Who may now use it.
  granteeUserId String
  grantedBy    String
  /// read | read-write
  accessLevel  String    @default("read")
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@unique([connectionId, granteeUserId, projectId])
  @@index([projectId])
  @@index([granteeUserId])
}

// ─── G03 — Operator assignment / scoping ───────────────────────────

/// Which operator is assigned to which client or project. G03 enforcement
/// reads this; it is not a display-only field.
model OperatorAssignment {
  id        String    @id @default(cuid())
  userId    String
  /// Exactly one of clientId / projectId is set.
  clientId  String?
  projectId String?
  /// delivery-lead | contributor | reviewer
  role      String    @default("contributor")
  createdBy String?
  createdAt DateTime  @default(now())
  removedAt DateTime?

  @@index([userId, removedAt])
  @@index([clientId])
  @@index([projectId])
}

// ─── G04 — Confirmed intake and business profile ───────────────────

/// Operator/client-confirmed facts about the business. Deliberately versioned
/// and deliberately separate from anything an extractor guessed (SiteContext):
/// content generation must be able to cite a confirmed fact, not a scrape.
model BusinessProfile {
  id          String    @id @default(cuid())
  projectId   String
  /// Monotonic per project. A new confirmation writes a new row.
  version     Int       @default(1)
  brandName   String?
  legalName   String?
  description String?
  /// C2 (`docs/analysis/client-portal.md` §12, `docs/PLAN.md` §11.2) — business
  /// category / type ("SaaS", "local plumbing services", etc). Free text, same
  /// draft/confirm versioning as every other field on this row. Distinct from
  /// `Project.category`, which is an operator/enrichment-set column on the
  /// Project row itself and is NOT part of this versioned, client-confirmable
  /// profile — the two are intentionally not kept in sync automatically.
  category    String?
  /// JSON string[] of services offered.
  services    String    @default("[]")
  /// JSON — ideal customer profile { segments, roles, painPoints }.
  icp         String    @default("{}")
  /// JSON string[] — geographic markets. Legacy flat shape, kept for
  /// backward-compat consumers; `targets` below is the structured P04 model.
  markets     String    @default("[]")
  /// JSON string[] — BCP-47 language tags.
  languages   String    @default("[]")
  /// JSON — MarketTarget[] (plan §10.1): structured
  /// { country, region, city, language, priority, active, productApplicability }.
  /// Rides along in the same draft/confirm versioning as every other field on
  /// this row — a confirmed target is just a confirmed field group, not a
  /// separate approval workflow (plan §9.2).
  targets     String    @default("[]")
  /// JSON — { fact, evidenceUrl }[] the client stands behind. Feeds claims.
  facts       String    @default("[]")
  /// JSON — { name, domain }[] the client names as rivals.
  competitors String    @default("[]")
  /// JSON string[] — commercial goals in the client's own words.
  goals       String    @default("[]")
  /// JSON — { name, email, role }[] who may approve content/reports.
  approvers   String    @default("[]")
  /// JSON — { cms, constraints, styleNotes } publishing limits.
  publishing  String    @default("{}")
  /// Null until a human confirms. Unconfirmed rows are candidates, not facts.
  confirmedBy String?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([projectId, version])
  @@index([projectId])
}

/// A suggested field value (from extracted SiteContext) that a human looked at
/// and declined — "keep current" rather than "accept". Recorded so a later
/// recrawl producing the SAME value does not resurface it again (plan §9.2:
/// "Record rejected suggestions or override locks so they are not repeatedly
/// reintroduced unchanged"). Keyed on a hash of the normalized suggested value
/// so an actually-changed re-suggestion (the site genuinely said something
/// different this time) is not silently suppressed by an old rejection.
model BusinessProfileRejection {
  id         String   @id @default(cuid())
  projectId  String
  /// Dot-path into BusinessProfileData, e.g. "brandName", "services", "icp.segments".
  fieldPath  String
  /// sha256 of the canonicalized (sorted, JSON-stringified) rejected value.
  valueHash  String
  /// JSON snapshot of the rejected value itself, kept for audit/display only —
  /// matching is always done on valueHash, never by re-parsing this.
  value      String
  actorType  String // "operator" | "client"
  actorId    String?
  createdAt  DateTime @default(now())

  @@unique([projectId, fieldPath, valueHash])
  @@index([projectId])
}

/// An outstanding ask directed at the client ("confirm your GSC property").
model OnboardingRequest {
  id           String    @id @default(cuid())
  projectId    String
  /// gsc-access | ga4-access | confirm-profile | cms-access | brand-assets | other
  kind         String
  title        String
  detail       String?
  /// Free-text or a ClientMember userId.
  requestedOf  String?
  requestedBy  String?
  dueAt        DateTime?
  /// open | in-progress | done | waived
  status       String    @default("open")
  /// JSON string[] of WorkItem ids this request is blocking.
  blockedWork  String    @default("[]")
  resolvedAt   DateTime?
  resolvedBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId, status])
}

// ─── G05 — Report editorial lifecycle ──────────────────────────────

/// One editable/releasable version of a Report. The existing Report row stays
/// the stable identity + latest pointer; every released snapshot is a row here
/// and is frozen, so "an old report never changes" is enforced by storage.
model ReportRevision {
  id          String    @id @default(cuid())
  reportId    String
  revision    Int
  /// draft | in-review | approved | released | withdrawn | superseded
  status      String    @default("draft")
  title       String?
  /// Full frozen report payload for this revision (JSON). Written once at
  /// release and never mutated.
  snapshot    String    @default("{}")
  /// EvidenceManifest.id pinned at release.
  manifestId  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  decision    String?
  decisionNote String?
  publishedBy String?
  publishedAt DateTime?
  withdrawnAt DateTime?
  /// Set when a newer revision replaces this one.
  supersededBy String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([reportId, revision])
  @@index([reportId, status])
}

/// Public "anyone with the link" access, deliberately independent of client
/// release: revoking a public link must not un-release the report, and
/// releasing to the client must not create a public link.
model ReportShareLink {
  id         String    @id @default(cuid())
  reportId   String
  revisionId String?
  /// sha256 of the share token.
  tokenHash  String    @unique
  /// C6 §31 — bcrypt hash of the OPTIONAL client/admin-set password. Null when
  /// the link is unguessable-only (expiry + revocation still apply). A
  /// user-chosen secret, so bcrypt (not the sha256 used for the high-entropy
  /// token above) — same discipline the auth module uses for passwords.
  passwordHash String?
  createdBy  String?
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastViewedAt DateTime?
  viewCount  Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([reportId])
}

/// A send attempt. Separate from release so a bounced email never rolls back
/// the fact that the report was released.
model ReportDeliveryAttempt {
  id         String   @id @default(cuid())
  reportId   String
  revisionId String?
  /// email | link-share | manual
  channel    String   @default("email")
  recipient  String
  subject    String?
  /// queued | sent | failed — "sent" means the provider accepted it, which is
  /// not proof of inbox delivery and is never displayed as such.
  status     String   @default("queued")
  error      String?
  attemptedBy String?
  attemptedAt DateTime @default(now())

  @@index([reportId])
}

// ─── G06 — Engagements, cycles, work ───────────────────────────────

/// The commercial container: what this client bought, for how long.
model Engagement {
  id           String    @id @default(cuid())
  clientId     String
  name         String
  /// scorecard | diagnostic | sprint | retainer
  serviceTier  String    @default("retainer")
  /// active | paused | completed | cancelled
  status       String    @default("active")
  startsOn     DateTime?
  endsOn       DateTime?
  /// IANA timezone. Every due date on this engagement resolves against it,
  /// never against the viewing browser's clock.
  timezone     String    @default("UTC")
  deliveryLead String?
  /// Contracted hours per cycle, for the capacity view.
  hoursPerCycle Float?
  notes        String?
  pausedAt     DateTime?
  pauseReason  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clientId, status])
}

/// A time-boxed delivery period. Committing one freezes its scope so that
/// "we delivered 8 of 10 committed items" has a stable denominator.
model Cycle {
  id           String    @id @default(cuid())
  projectId    String
  engagementId String?
  name         String
  startsOn     DateTime
  endsOn       DateTime
  /// planning | committed | active | review | closed
  status       String    @default("planning")
  goal         String?
  committedAt  DateTime?
  committedBy  String?
  /// Count of work items at commit time — the frozen denominator.
  committedCount Int     @default(0)
  /// JSON — { at, by, reason, added[], removed[] }[] after commit.
  scopeChanges String    @default("[]")
  closedAt     DateTime?
  /// C3, Option B (docs/analysis/engagement-timeline.md §2) — optional
  /// client-facing grouping label. Purely a display concept: no lifecycle or
  /// approval meaning attaches to it, and Cycle's own status/commit
  /// machinery above is completely unaffected by whether this is set.
  /// Nullable so every pre-existing and future unphased cycle is unaffected.
  phaseId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId, status])
  @@index([engagementId])
  @@index([phaseId])
}

/// C3, Option B (docs/analysis/engagement-timeline.md §2) — a thin,
/// purely-display grouping layer above Cycle/Commitment, for the
/// client-facing "which stage of the engagement am I in" narrative that
/// Cycle's own recurring-work-period semantics don't map onto cleanly (see
/// the rejected Option A note in that doc). Deliberately carries no new
/// lifecycle or approval mechanics of its own — it inherits everything a
/// linked Cycle/Commitment already enforces. `status` here is a coarse,
/// admin-settable display hint only (not a workflow), defaulting to
/// "upcoming"; the UI may also derive a display state from linked
/// cycles/commitments where that reads better, but nothing downstream
/// gates on this field.
model Phase {
  id        String   @id @default(cuid())
  projectId String
  name      String
  /// Sequencing among a project's phases, ascending. No uniqueness
  /// constraint — ties are broken by createdAt, and reordering is a matter
  /// of rewriting this column, not a migration.
  order     Int      @default(0)
  /// upcoming | active | complete — admin-set display hint, not a lifecycle.
  status    String   @default("upcoming")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, order])
}

/// P11 — a "plan commitment": what the team intends to accomplish in a
/// period ("Publish ten useful articles"), explicitly distinct from a
/// WorkItem (who does a concrete step) and a content-schedule entry (when a
/// piece publishes — P10's job). Always scoped to one Cycle, per §6.3
/// ("extend with a stable commitment resource ... under a cycle; do not
/// create a second independent plan engine"). Progress is never stored here
/// — it is always derived at read time from linked WorkItem.status/verified
/// counts (countable commitments) or from outcomeMetricCurrent (outcome
/// commitments), so a commitment can never silently drift out of sync with
/// its evidence.
model Commitment {
  id           String    @id @default(cuid())
  projectId    String
  cycleId      String
  /// Plain-English outcome, e.g. "Publish ten useful articles for the new product".
  title        String
  /// Short reason this matters, shown next to the outcome.
  reason       String?
  /// website | content | email | ads | online-presence | other — §6.2's
  /// workstream tag. A section only renders in the UI when at least one
  /// commitment carries its tag; there is no separate "purchased services"
  /// table, so an empty tag never appears without a commitment behind it.
  workstream   String    @default("other")
  /// draft -> proposed -> agreed -> active -> completed | closed;
  /// cancelled | superseded are explicit alternatives at any open state.
  /// See COMMITMENT_TRANSITIONS in delivery-plan.types.ts.
  status       String    @default("draft")
  /// Countable target, e.g. 10 (articles). Null for a pure outcome goal.
  targetCount  Int?
  /// Unit label for targetCount, e.g. "articles".
  targetUnit   String?
  targetDate   DateTime?
  /// Outcome-style commitments (e.g. "Increase qualified visits") carry their
  /// own metric instead of / alongside a countable target. currentValue is
  /// only ever written through recordOutcomeMetric/completeCommitment — never
  /// inferred from linked WorkItems — so "outcome-goal completed" always
  /// means a human recorded the outcome, not that tasks closed.
  outcomeMetricLabel     String?
  outcomeMetricUnit      String?
  outcomeMetricBaseline  Float?
  outcomeMetricTarget    Float?
  outcomeMetricCurrent   Float?
  outcomeMetricObservedAt DateTime?
  /// Staff userId accountable for this commitment. The client view shows
  /// "Your Cailyx team" unless clientVisibleLead is explicitly set true —
  /// mirrors the portal's actor-hiding convention (see toPortalText/
  /// toPortalScopeChanges), applied here rather than reinvented.
  accountableLead      String?
  clientVisibleLead    Boolean   @default(false)
  /// JSON string[] of WorkItem ids belonging to this commitment. Progress
  /// for a countable commitment = count of these whose WorkItem.status is
  /// "verified", against targetCount — the same verification concept G06
  /// already established, never a second one.
  linkedWorkItemIds    String    @default("[]")
  /// Loose reference to relevant content/results (e.g. a content asset id or
  /// URL) — deliberately not a foreign key into the P08/P10 content-identity
  /// tables, which this phase does not own.
  contentRef           String?
  /// "Agreed" requires this recorded confirmation — an operator saving the
  /// plan is never enough on its own (§6.3).
  agreedAt             DateTime?
  agreedBy             String?
  /// JSON — { at, by, reason, previousTarget, newTarget, previousDate,
  /// newDate, requiresReconfirmation }[]. Appended, never rewritten, exactly
  /// like Cycle.scopeChanges.
  scopeChanges         String    @default("[]")
  /// Set when this commitment is superseded by a newer one rather than
  /// edited in place, so completed work is never silently erased.
  supersededBy         String?
  cancelledAt          DateTime?
  cancelReason         String?
  createdBy            String?
  /// C3, Option B — optional client-facing Phase grouping, same convention
  /// as Cycle.phaseId: nullable, additive, no effect on the status
  /// transitions or agreement mechanics above.
  phaseId              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([projectId, status])
  @@index([cycleId])
  @@index([phaseId])
}

/// A single deliverable. §7.1's minimum fields.
model WorkItem {
  id            String    @id @default(cuid())
  projectId     String
  cycleId       String?
  title         String
  description   String?
  /// fix | build | influence — design_plan §7's three work categories.
  category      String    @default("fix")
  /// technical | content | authority | research | reporting | access
  discipline    String    @default("technical")
  /// backlog | committed | active | review | blocked | verified | cancelled
  status        String    @default("backlog")
  /// low | medium | high | critical
  priority      String    @default("medium")
  assigneeId    String?
  reviewerId    String?
  dueAt         DateTime?
  estimateHours Float?
  actualHours   Float?
  /// Where the work came from: Gap.id, Finding.id, Alert.id, etc.
  sourceType    String?
  sourceId      String?
  /// JSON string[] — WorkItem ids that must finish first. Cycle checks reject
  /// a cycle in this graph.
  dependsOn     String    @default("[]")
  /// Who the client must hear from for this to move, when blocked on them.
  blockedReason String?
  blockedOn     String?
  /// Visible in the client portal. Internal notes live on a separate field,
  /// never a UI-only toggle.
  clientVisible Boolean   @default(false)
  internalNotes String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([projectId, status])
  @@index([cycleId])
  @@index([assigneeId, status])
}

/// A condition that must hold before the work counts as done.
model AcceptanceCheck {
  id          String    @id @default(cuid())
  workItemId  String
  description String
  /// pending | passed | failed
  status      String    @default("pending")
  checkedBy   String?
  checkedAt   DateTime?
  note        String?
  position    Int       @default(0)

  @@index([workItemId])
}

/// Proof the work landed. A URL alone is not proof: the run/artifact and the
/// reviewer who looked at it are recorded too.
model Verification {
  id          String    @id @default(cuid())
  workItemId  String
  /// Live URL where the change is visible.
  sourceUrl   String?
  /// The audit/measurement run that observed it.
  runId       String?
  runType     String?
  /// Exactly what was checked.
  artifact    String?
  observedAt  DateTime?
  reviewerId  String?
  /// accepted | rejected
  decision    String    @default("accepted")
  /// On reject this explains what reopened the work.
  note        String?
  createdAt   DateTime  @default(now())

  @@index([workItemId])
}

/// A dated commitment bigger than one work item.
model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  engagementId String?
  title       String
  description String?
  dueAt       DateTime?
  /// planned | at-risk | met | missed
  status      String    @default("planned")
  clientVisible Boolean @default(true)
  metAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, status])
}

/// Planned hours per person per cycle, plus leave, for the team view.
model CapacityAllocation {
  id           String   @id @default(cuid())
  userId       String
  cycleId      String?
  projectId    String?
  /// Period this allocation covers when not tied to a cycle.
  startsOn     DateTime
  endsOn       DateTime
  /// Hours the person is expected to be available.
  availableHours Float  @default(0)
  /// Hours already committed to work items.
  allocatedHours Float  @default(0)
  /// leave | holiday | reduced — null for a normal allocation.
  absenceKind  String?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, startsOn])
  @@index([cycleId])
}

// ─── G07 — Durable jobs, cadence, alerts ───────────────────────────

/// The durable ledger for a background run. Survives a worker restart, which
/// is the whole point: in-memory job state is not a job ledger.
model JobRun {
  id            String    @id @default(cuid())
  projectId     String
  /// technical-audit | seo-audit | aeo-audit | presence | serp | mentions |
  /// backlinks | gap | score | report | content-generation | onboarding
  taskKind      String
  /// Caller-supplied de-duplication key. A duplicate scheduler tick with the
  /// same key must not start a second paid run.
  idempotencyKey String?  @unique
  /// queued | running | partial | completed | failed | cancelled
  status        String    @default("queued")
  /// Human-readable current stage. No invented percentage or ETA.
  stage         String?
  attempt       Int       @default(1)
  maxAttempts   Int       @default(3)
  /// Last worker heartbeat; a stale heartbeat is how a dead run is detected.
  heartbeatAt   DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  /// JSON — run parameters as actually submitted.
  input         String    @default("{}")
  /// JSON — { created: [...ids], counts: {...} }.
  artifacts     String    @default("{}")
  error         String?
  /// Money already spent even if the run is later cancelled. Cancellation must
  /// be able to say what is unrecoverable.
  costUsd       Float     @default(0)
  costCredits   Float     @default(0)
  /// Whether cancelling can still undo the side effects.
  reversible    Boolean   @default(true)
  triggeredBy   String?
  /// manual | cadence | pipeline | retry
  trigger       String    @default("manual")
  cadenceRuleId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([projectId, taskKind, status])
  @@index([status, heartbeatAt])
}

/// One stage inside a JobRun, so a partial failure names the stage that failed
/// instead of collapsing to "failed".
model JobStep {
  id         String    @id @default(cuid())
  jobRunId   String
  name       String
  position   Int       @default(0)
  /// pending | running | succeeded | failed | skipped
  status     String    @default("pending")
  startedAt  DateTime?
  finishedAt DateTime?
  /// Items attempted vs. items that actually succeeded — the source of the
  /// "partial coverage" disclosure in the UI.
  attempted  Int       @default(0)
  succeeded  Int       @default(0)
  error      String?
  costUsd    Float     @default(0)

  @@index([jobRunId])
}

/// A recurring schedule for one task kind on one project.
model CadenceRule {
  id            String    @id @default(cuid())
  projectId     String
  taskKind      String
  /// daily | weekly | biweekly | monthly | quarterly | off
  frequency     String    @default("off")
  /// 0-6, Sunday=0. Null for daily/monthly.
  dayOfWeek     Int?
  /// 1-31. Null unless monthly/quarterly.
  dayOfMonth    Int?
  /// Local hour in `timezone`.
  hour          Int       @default(3)
  timezone      String    @default("UTC")
  enabled       Boolean   @default(false)
  /// JSON — run parameters applied on each tick.
  params        String    @default("{}")
  /// JSON string[] — capability keys that must be ready or the tick is skipped
  /// with a recorded reason rather than failing loudly every night.
  prerequisites String    @default("[]")
  /// Hard ceiling per tick.
  maxCostUsd    Float?
  lastRunAt     DateTime?
  lastJobRunId  String?
  lastStatus    String?
  lastError     String?
  nextRunAt     DateTime?
  /// Set while the parent client/engagement is paused.
  pausedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([projectId, taskKind])
  @@index([enabled, nextRunAt])
}

/// Triage state for an Alert. Kept separate from Alert so the existing
/// append-only alert feed keeps working untouched.
model AlertLifecycle {
  id            String    @id @default(cuid())
  alertId       String    @unique
  /// new | acknowledged | assigned | resolved | dismissed
  status        String    @default("new")
  acknowledgedBy String?
  acknowledgedAt DateTime?
  assigneeId    String?
  /// WorkItem opened in response.
  workItemId    String?
  resolvedBy    String?
  resolvedAt    DateTime?
  resolution    String?
  /// Stable hash of kind+project+subject, so the same condition re-firing
  /// nightly updates one row instead of spamming the feed.
  dedupeKey     String?
  occurrences   Int       @default(1)
  lastSeenAt    DateTime  @default(now())

  @@index([status])
  @@index([dedupeKey])
}

// ─── G08 — Notifications, attachments, message state ───────────────

model Notification {
  id          String    @id @default(cuid())
  /// Recipient User.id.
  userId      String
  /// work-assigned | approval-requested | report-released | run-failed |
  /// message-received | alert-raised | request-due
  kind        String
  title       String
  body        String?
  /// Deep link into the app.
  href        String?
  clientId    String?
  projectId   String?
  resourceType String?
  resourceId  String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  inApp     Boolean  @default(true)
  email     Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, kind])
}

/// Per-user read position in a client message thread. Real state, so unread
/// counts are not guessed from timestamps.
model MessageReadCursor {
  id            String   @id @default(cuid())
  userId        String
  clientId      String
  lastReadAt    DateTime
  lastReadMessageId String?
  updatedAt     DateTime @updatedAt

  @@unique([userId, clientId])
}

/// An uploaded file. `ownerScope` is what the download guard checks; the
/// storage key is never a capability by itself.
model Attachment {
  id          String    @id @default(cuid())
  clientId    String?
  projectId   String?
  /// message | work-item | report | content | onboarding-request
  contextType String
  contextId   String?
  filename    String
  mimeType    String
  sizeBytes   Int
  /// Path/key in the configured storage backend.
  storageKey  String
  /// operator-only | client-visible
  visibility  String    @default("operator-only")
  uploadedBy  String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([contextType, contextId])
  @@index([projectId])
}

// ─── G09 — Briefs, content revisions, generation jobs ──────────────

/// The approved input to generation. Generation records which brief version it
/// actually used, so "regenerate" cannot silently use different instructions.
model ContentBrief {
  id           String    @id @default(cuid())
  projectId    String
  /// P08 §13.2 stable brief-family identity, DECOUPLED from title. Versioning
  /// used to be keyed by (projectId, version, title) — renaming a brief broke
  /// its own version chain and could accidentally collide with an unrelated
  /// brief that happened to share a new title. A fresh cuid on every row that
  /// does not explicitly reuse its parent's briefFamilyId (ContentService only
  /// reuses it when forking a version of an existing family); a rename never
  /// changes it. Existing pre-P08 rows are backfilled to their own `id` — one
  /// family per legacy row, a safe no-op migration (§13.2: "existing ambiguous
  /// title-based history cannot be safely auto-merged"). See
  /// content-workspace.service.ts's `mergeBriefFamilies` for the staff tool
  /// that manually reunites legacy rows an operator recognizes as one lineage.
  briefFamilyId String   @default(cuid())
  version      Int       @default(1)
  title        String
  /// article | ad-copy | landing-page | faq | comparison | guide | case-study
  assetType    String    @default("article")
  targetQuery  String?
  /// JSON string[] — secondary queries.
  supportingQueries String @default("[]")
  audience     String?
  /// informational | commercial | transactional | navigational
  intent       String?
  angle        String?
  /// JSON string[] — required talking points.
  mustInclude  String    @default("[]")
  /// JSON string[] — Claim ids the copy may assert.
  claimIds     String    @default("[]")
  /// JSON — { url, note }[] reference sources.
  references   String    @default("[]")
  /// Gap/opportunity this brief answers.
  sourceType   String?
  sourceId     String?
  wordTarget   Int?
  language     String    @default("en")
  /// draft | approved | archived
  status       String    @default("draft")
  approvedBy   String?
  approvedAt   DateTime?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([projectId, briefFamilyId, version])
  @@index([projectId, status])
  @@index([projectId, briefFamilyId])
  @@index([projectId, title])
}

/// An immutable saved version of a piece of content. Editing writes a new row;
/// an approval points at one revision and is invalidated when a newer one
/// appears.
model ContentRevision {
  id         String   @id @default(cuid())
  /// GrowthAsset.id — the stable content identity.
  assetId    String
  revision   Int
  title      String?
  /// The body as authored/generated.
  body       String?
  /// JSON — type-specific fields (meta, slug, faq, jsonLd, ad variants).
  fields     String   @default("{}")
  briefId    String?
  briefVersion Int?
  /// generation | operator-edit | client-edit | import
  origin     String   @default("generation")
  generationItemId String?
  wordCount  Int      @default(0)
  authorId   String?
  /// Hash of body+fields, used for the edit-invalidates-approval check.
  contentHash String?
  /// P08 §13.5/§14.4 explicit sharing state. Default false (private, an
  /// internal draft/working iteration) — a client route must NEVER infer
  /// visibility implicitly from approval status alone, and must never fall
  /// back to "latest revision" for a client read. Only a revision an
  /// operator deliberately marks here is ever returned by a client-portal
  /// content read.
  clientVisible   Boolean   @default(false)
  clientVisibleAt DateTime?
  clientVisibleBy String?
  createdAt  DateTime @default(now())

  @@unique([assetId, revision])
  @@index([assetId])
  @@index([assetId, clientVisible])
}

/// A batch generation request. Holds requested vs. succeeded vs. failed so a
/// short batch is visible instead of silently looking complete.
///
/// P09 (plan §13.7, durable generation) extended this from a bookkeeping row
/// written AFTER a synchronous call into the durable unit of work itself:
/// everything the worker is allowed to use is pinned here BEFORE execution
/// starts, so editing the writing style / business profile after enqueue can
/// never change what an in-flight or already-completed job used. The worker
/// (content-generation.service.ts) resolves ONLY these pinned fields.
model GenerationJob {
  id          String    @id @default(cuid())
  projectId   String
  jobRunId    String?
  briefId     String?
  briefVersion Int?
  assetType   String
  requested   Int       @default(0)
  succeeded   Int       @default(0)
  failed      Int       @default(0)
  /// queued | running | partial | completed | failed | cancelled
  status      String    @default("queued")
  provider    String?
  model       String?
  costUsd     Float     @default(0)
  /// JSON — the exact request configuration.
  input       String    @default("{}")
  error       String?
  requestedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// P09 durability additions ────────────────────────────────────────
  /// Client-supplied dedupe key. A retry/resubmit with the same key on the
  /// same project returns the existing job/output rather than creating a
  /// second one — the concrete guard against "worker crashed after creating
  /// the revision but before acknowledging".
  idempotencyKey        String?
  actorId               String?
  /// Pinned target: null = this job creates a NEW content piece; set = this
  /// job produces a new revision on an existing GrowthAsset (P08 identity).
  contentAssetId        String?
  /// Pinned approved brief version this job was authorized against (§13.7).
  writingStyleProfileId String?
  writingStyleVersion   Int?
  /// sha256 of the pinned style's substantive fields at enqueue time — lets a
  /// caller PROVE a later edit to the active style did not leak into this job,
  /// without re-reading history.
  writingStyleFingerprint String?
  /// Pinned confirmed BusinessProfile.version (read-only reference; P02/P04
  /// owns the live row, this only pins which version was used).
  businessProfileVersion  Int?
  /// JSON string[] — source evidence record ids (claims, gap ids, etc.).
  sourceEvidenceIds       String   @default("[]")
  /// JSON — generation knobs (temperature/length/etc.), never shown to a client.
  generationSettings      String   @default("{}")
  costReservationUsd      Float    @default(0)
  /// Lease/ownership so two workers can't double-process the same job.
  leaseOwner              String?
  leaseExpiresAt          DateTime?
  attempts                Int      @default(0)
  maxAttempts             Int      @default(3)
  cancelledAt             DateTime?
  /// Set the moment a ContentRevision is created — read BEFORE creating a
  /// second one on retry, so a crash between "revision created" and "job
  /// marked succeeded" is recoverable without duplicating output.
  revisionId              String?

  @@index([projectId, status])
  @@unique([projectId, idempotencyKey])
}

/// One requested artifact inside a GenerationJob. A failed item is retryable
/// on its own, so a retry never re-pays for the items that succeeded.
model GenerationItem {
  id              String    @id @default(cuid())
  generationJobId String
  /// The topic/keyword/angle this item was for.
  subject         String?
  topicId         String?
  /// pending | succeeded | failed | skipped
  status          String    @default("pending")
  /// GrowthAsset.id produced on success.
  assetId         String?
  revisionId      String?
  error           String?
  retryable       Boolean   @default(true)
  costUsd         Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([generationJobId, status])
}

// ─── P09 — Writing style profile (plan §13.8) ──────────────────────
//
// Owned by Content (never by digital-presence). Same draft->confirmed
// versioning discipline as BusinessProfile: confirming never mutates a prior
// confirmed row, and a new suggestion (from PresenceBrandVoice) never
// overwrites the active confirmed profile — it is surfaced separately until
// a human folds it into a NEW draft/confirm.

/// A versioned, editable writing-style record for one project. Monotonic
/// version per project, exactly like BusinessProfile; `confirmedAt` null =
/// still a draft/candidate, not yet the active style generation may use.
model WritingStyleProfile {
  id            String    @id @default(cuid())
  projectId     String
  version       Int       @default(1)
  name          String    @default("Default style")
  /// Short plain-English summary, e.g. "Clear and friendly, short sentences; avoid hype."
  summary       String?
  tone          String?
  /// JSON string[]
  preferredWords String   @default("[]")
  /// JSON string[]
  avoidWords     String   @default("[]")
  /// JSON string[] — example sentences written in this voice.
  exampleSentences String @default("[]")
  ctaPreferences String?
  /// casual | conversational | neutral | formal
  formality     String    @default("neutral")
  audience      String?
  /// JSON — { [channel: string]: { tone?, notes? } }, optional per-channel deltas.
  channelDifferences String @default("{}")
  /// manual | suggested-accepted — where this draft's content came from.
  sourceType    String    @default("manual")
  /// PresenceBrandVoice.id this draft accepted/started from, if any (read-only reference).
  suggestionSourceId String?
  /// Deterministic fingerprint (sha256) of the substantive fields above, so a
  /// GenerationJob can pin "exactly this content" without copying it whole.
  fingerprint   String?
  confirmedBy   String?
  confirmedAt   DateTime?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([projectId, version])
  @@index([projectId])
  @@index([projectId, confirmedAt])
}

// ─── G10 — Approvals and claim gates ───────────────────────────────

/// A decision request bound to an exact artifact version.
model ApprovalRequest {
  id             String    @id @default(cuid())
  projectId      String
  clientId       String?
  /// report | content | plan | cycle | claim
  artifactType   String
  artifactId     String
  /// The exact revision under review. An edit that produces a newer revision
  /// invalidates this request rather than silently transferring consent.
  artifactRevision Int?
  revisionId     String?
  title          String
  detail         String?
  /// operator | client
  reviewerType   String    @default("client")
  /// Specific reviewer when required.
  requiredReviewerId String?
  requestedBy    String
  dueAt          DateTime?
  /// pending | approved | changes-requested | cancelled | invalidated
  status         String    @default("pending")
  /// Set when a newer revision superseded the artifact under review.
  invalidatedAt  DateTime?
  invalidatedReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([projectId, status])
  @@index([clientId, status])
  @@index([artifactType, artifactId])
}

/// An immutable decision. Changing your mind creates a superseding decision;
/// it never rewrites this row.
model ApprovalDecision {
  id                String   @id @default(cuid())
  approvalRequestId String
  /// approved | changes-requested
  decision          String
  comment           String?
  decidedBy         String
  /// operator | client
  decidedByType     String
  /// The revision actually seen at decision time.
  decidedRevision   Int?
  supersededBy      String?
  createdAt         DateTime @default(now())

  @@index([approvalRequestId])
}

/// Links a content/report revision to the claims it asserts, so a blocked
/// claim can gate that specific revision's publication.
model RevisionClaimLink {
  id         String   @id @default(cuid())
  revisionId String
  /// report-revision | content-revision
  revisionType String @default("content-revision")
  claimId    String
  /// Where in the body the claim appears.
  excerpt    String?
  createdAt  DateTime @default(now())

  @@unique([revisionId, claimId])
  @@index([claimId])
}

/// The outcome of one automated or human check on a revision.
model CheckResult {
  id           String   @id @default(cuid())
  /// content-revision | report-revision | work-item
  subjectType  String
  subjectId    String
  /// claim-support | source-independence | brand-accuracy | word-count |
  /// link-validity | schema-validity | extractability
  checkKind    String
  /// passed | failed | warning | skipped
  status       String
  /// Why it failed, in the reviewer's words or the checker's output.
  detail       String?
  /// JSON — structured findings.
  payload      String   @default("{}")
  checkedBy    String?
  /// automated | human
  checkedVia   String   @default("automated")
  /// The project this check ran against.
  ///
  /// Denormalized on purpose. A check's subject is a polymorphic
  /// (subjectType, subjectId) pair pointing at one of several tables, so the
  /// owning project cannot be resolved by a join — only by a subjectType →
  /// table mapping, which is exactly the kind of guess that breaks silently
  /// when a new subject type is added. Storing the scope on the row makes the
  /// read a plain indexed filter instead.
  ///
  /// Nullable because rows written before this column existed have no scope;
  /// they are only reachable through the operator-only list, which is
  /// unscoped by design.
  projectId    String?
  /// Denormalized alongside projectId, for client-scoped reads.
  clientId     String?
  createdAt    DateTime @default(now())

  @@index([subjectType, subjectId])
  @@index([projectId])
  @@index([clientId])
}

// ─── G11 — Publishing ──────────────────────────────────────────────

/// An authorized remote destination (a CMS, a social account, an ad account).
/// Each integration is separate: one "connect" button never bundles unrelated
/// permissions.
model PublishDestination {
  id           String    @id @default(cuid())
  projectId    String
  /// wordpress | webflow | ghost | contentful | linkedin | x | custom-webhook
  provider     String
  label        String
  /// The selected remote resource (site id, blog id, page id).
  resourceId   String?
  resourceLabel String?
  /// JSON — non-secret config. Credentials live in the secret store, keyed by
  /// credentialRef; they are never persisted here.
  config       String    @default("{}")
  credentialRef String?
  /// unconfigured | connected | error
  status       String    @default("unconfigured")
  lastTestedAt DateTime?
  lastError    String?
  createdBy    String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId, provider])
}

/// One attempt to push an approved revision to a destination.
model Publication {
  id            String    @id @default(cuid())
  projectId     String
  destinationId String
  assetId       String
  revisionId    String
  /// The approval that authorized this specific push.
  approvalId    String?
  /// P10 (plan §6.6) — the `ContentSchedule` placement this attempt executes.
  /// Null for a publication created straight from content detail (that path
  /// predates the calendar and is unchanged). This is the *child* side of the
  /// relationship: the placement owns the calendar event identity, and a
  /// publication is an execution record hanging off it, so N attempts can
  /// never turn one placement into N calendar events.
  scheduleId    String?
  /// draft | publish
  mode          String    @default("draft")
  scheduledFor  DateTime?
  /// pending | publishing | published | failed | cancelled
  status        String    @default("pending")
  /// Id assigned by the remote system.
  remoteId      String?
  remoteUrl     String?
  /// Separate from `status`: the push can succeed while the follow-up fetch
  /// fails to confirm the content is actually live.
  verifiedAt    DateTime?
  verifiedUrl   String?
  verifyError   String?
  error         String?
  attempt       Int       @default(1)
  publishedBy   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([projectId, status])
  @@index([assetId])
  @@index([scheduleId])
}

// ─── P10 — Content calendar: planned placements (plan §6.6) ─────────
//
// §6.1 keeps three concepts apart, and this table is deliberately none of the
// other two: a plan `Commitment` is what the team intends to accomplish, a
// `WorkItem` is who does which step and how it is verified, and a
// `ContentSchedule` is *when a specific piece should be published or sent*.
//
// It is also not a `Publication`. `Publication` creation requires a revision
// with a recorded approval (§6.6), so a planned date shown before approval
// cannot be a publication row — faking one there would be a plan that bypasses
// the approval gate. The placement is the intention; the publication is the
// execution.

/// One intended channel placement for one content piece: the *intention* half
/// of §6.6's split. Its `id` IS the calendar event identity (`scheduleId`).
model ContentSchedule {
  id            String    @id @default(cuid())
  projectId     String
  /// GrowthAsset.id — the content piece this placement is for. Required: a
  /// calendar entry with no content record behind it is an operational task
  /// (audit run, crawler check, report release, monitoring job), which §6.4
  /// explicitly excludes from this calendar and keeps on its own schedule.
  assetId       String
  /// ContentBrief.id when the piece came from a brief family (§6.6's
  /// "content piece / brief family").
  briefId       String?
  /// Loose reference to the plan `Commitment` this placement serves. Not a
  /// foreign key, for the same reason `Commitment.contentRef` is not: §6.7
  /// requires that editing a plan date never silently reschedules content and
  /// that editing a content schedule never silently moves a commitment's
  /// target. Nothing propagates in either direction, so nothing can cascade.
  commitmentId  String?
  /// article | social-post | email | ad-creative | landing-page | other —
  /// §6.4's explicitly supported content types. Stored rather than re-derived
  /// from `GrowthAsset.assetType` on every read: the piece's type can be
  /// revised later, and the placement records what was planned.
  contentType   String
  /// Where it is intended to go — a `PublishDestination.provider` id for an
  /// automatable channel, or a planning-only channel id (email, paid-ads)
  /// that has no adapter in this build. §6.6: an unsupported channel may only
  /// be planned or delivered manually, clearly labelled, with no Send/Launch
  /// action offered anywhere.
  channel       String
  /// automated | manual. `automated` is refused unless the channel has a real
  /// implemented provider AND a connected destination, so "automated" is never
  /// a label on something that cannot actually happen.
  deliveryMode  String    @default("manual")
  /// The chosen destination for an automated placement. Null for manual.
  destinationId String?
  /// The UTC instant. This is THE scheduling truth: every scope (staff
  /// project, portfolio, client) reads this one column, so the three views
  /// cannot disagree about when something is planned.
  plannedForUtc DateTime
  /// The intended local wall clock and zone, stored beside the instant so the
  /// intention can be reproduced exactly. Without these a timezone-database
  /// update would silently rewrite what a human chose.
  plannedLocalDate String
  plannedLocalTime String
  timezone      String
  /// earlier | later — which of the two instants a *repeated* fall-back local
  /// time means. Null when the reading was unambiguous. Set only when the
  /// caller disambiguated; §6.7 forbids guessing on their behalf.
  dstDisambiguation String?
  /// planned | cancelled — the only persisted lifecycle, plus the source
  /// facts. Every other state in §6.6's vocabulary (awaiting-approval, ready,
  /// scheduled, held, publishing, published, failed) is DERIVED on read from
  /// the piece's revisions, its approvals and its linked publications, so a
  /// stored state can never go stale or contradict what it describes.
  status        String    @default("planned")
  cancelledAt   DateTime?
  /// Why it was cancelled, in the operator's words. Cancellation is a state,
  /// never a delete: the row stays so history (and anything already
  /// published) survives.
  cancelReason  String?
  /// Staff owner, for §6.5's owner filter. Staff-only in every client
  /// projection (the portal shows no user ids anywhere else either).
  ownerId       String?
  /// Optimistic concurrency (§6.7): an update sends the version it read and is
  /// refused if another writer got there first.
  version       Int       @default(1)
  /// Caller-supplied dedupe key (§6.7 idempotency): a retried create with the
  /// same key returns the existing placement instead of a second one.
  idempotencyKey String?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([projectId, idempotencyKey])
  @@index([projectId, plannedForUtc])
  @@index([projectId, status])
  @@index([assetId])
  @@index([plannedForUtc])
  @@index([ownerId])
}

// ─── G12 — Budgets and spend ───────────────────────────────────────

/// A ceiling at client, project or operation level.
model BudgetPolicy {
  id           String   @id @default(cuid())
  /// client | project | operation
  scopeType    String
  scopeId      String
  /// Null on a client/project-wide policy; set to a taskKind for an
  /// operation-level cap.
  taskKind     String?
  /// Ceiling per calendar period.
  limitUsd     Float?
  limitCredits Float?
  /// day | week | month | cycle | total
  period       String   @default("month")
  /// Hard caps reject; soft caps warn and require an explicit approval.
  enforcement  String   @default("hard")
  /// Per-single-run ceiling.
  perRunCapUsd Float?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([scopeType, scopeId, taskKind, period])
}

/// Money set aside before a run starts. Reserving first is what stops two
/// concurrent requests from both passing the cap check and overspending.
model SpendReservation {
  id           String    @id @default(cuid())
  projectId    String
  taskKind     String
  jobRunId     String?
  /// Why this reservation was made, released or approved, in the requester's
  /// or approver's words. A reservation is money held aside; the reason it was
  /// released is the thing an audit asks for and there was nowhere to put it.
  note         String?
  /// Low/high estimate at reservation time.
  estimateLowUsd  Float  @default(0)
  estimateHighUsd Float  @default(0)
  reservedUsd  Float     @default(0)
  reservedCredits Float  @default(0)
  /// held | settled | released | expired
  status       String    @default("held")
  /// What actually got charged, once known.
  settledUsd   Float?
  settledCredits Float?
  settledAt    DateTime?
  expiresAt    DateTime?
  requestedBy  String?
  approvedBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId, status])
}

/// An actual charge. Units are explicit: credits and currency never mix.
model SpendEvent {
  id          String   @id @default(cuid())
  projectId   String
  clientId    String?
  taskKind    String?
  jobRunId    String?
  reservationId String?
  provider    String
  /// usd | credits
  unit        String   @default("usd")
  amount      Float
  quantity    Float?
  /// What the quantity counts ("requests", "tokens", "pages").
  quantityUnit String?
  note        String?
  occurredAt  DateTime @default(now())

  @@index([projectId, occurredAt])
  @@index([provider])
}

// ─── G13 — Comparable outcomes and snapshots ───────────────────────

/// A named, methodology-stable basis for comparison. If the query set, engine
/// or transport changes, comparability is broken and recorded as such.
model MeasurementCohort {
  id            String   @id @default(cuid())
  projectId     String
  name          String
  querySetId    String?
  querySetVersion Int?
  /// JSON string[] — engine ids included.
  engines       String   @default("[]")
  /// JSON string[] — markets included.
  markets       String   @default("[]")
  transport     String?
  /// Fingerprint of the methodology. A change here marks a break.
  methodologyHash String?
  /// The first run in this cohort, used as the baseline.
  baselineRunId String?
  baselineAt    DateTime?
  /// JSON — { at, reason, previousHash }[] methodology breaks.
  breaks        String   @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
}

/// A reporting window. Explicit start/end so a historical report reproduces
/// exactly, rather than re-deriving "last 30 days" from today's date.
model ReportPeriod {
  id         String   @id @default(cuid())
  projectId  String
  label      String
  startsOn   DateTime
  endsOn     DateTime
  timezone   String   @default("UTC")
  cohortId   String?
  /// The period this one is compared against.
  baselinePeriodId String?
  createdAt  DateTime @default(now())

  @@index([projectId, startsOn])
}

/// Exactly which source rows a report or result set was built from, pinned by
/// id. This is what makes an old report immutable in practice.
model EvidenceManifest {
  id          String   @id @default(cuid())
  projectId   String
  /// report | result-set
  subjectType String   @default("report")
  subjectId   String?
  periodId    String?
  cohortId    String?
  /// JSON — { sourceType: [ids] } for every pinned run/audit/snapshot.
  sources     String   @default("{}")
  /// JSON — { sourceType: { expected, succeeded, failedReason } } coverage.
  coverage    String   @default("{}")
  /// JSON — { sourceType: isoDate } the real freshness of each source.
  sourceDates String   @default("{}")
  scoreRunId  String?
  rubricVersion String?
  /// Sources that were expected but missing, named rather than silently absent.
  omissions   String   @default("[]")
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([subjectType, subjectId])
}

// ─── G14 — Saved views ─────────────────────────────────────────────

/// A stored filter set. Stores the query, never a cached copy of the rows it
/// returned — a saved view must not become a stale shadow of client data.
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  /// clients | projects | work | reports | leads | alerts
  surface   String
  name      String
  /// JSON — the filter/sort/column state.
  filters   String   @default("{}")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, surface])
}

// ─── G15 — Activity and audit trail ────────────────────────────────

/// Append-only. Rows are never updated or deleted by application code; a
/// resource deletion still leaves its audit record behind.
model ActivityEvent {
  id           String   @id @default(cuid())
  /// user | system | scheduler | webhook
  actorType    String   @default("user")
  actorId      String?
  actorLabel   String?
  /// created | updated | deleted | released | approved | rejected | published |
  /// sent | started | cancelled | granted | revoked | logged-in
  action       String
  resourceType String
  resourceId   String?
  resourceVersion String?
  clientId     String?
  projectId    String?
  /// Short human summary of the change. Never raw secrets, tokens or
  /// credentials, and never full message bodies.
  summary      String?
  /// JSON — redacted before/after for the fields that changed.
  changes      String   @default("{}")
  /// success | failure
  result       String   @default("success")
  /// Correlates to the HTTP request or job that caused it.
  requestId    String?
  jobRunId     String?
  /// api | ui | scheduler | webhook
  origin       String   @default("api")
  ipAddress    String?
  /// Whether a client user may see this event.
  clientVisible Boolean @default(false)
  createdAt    DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([projectId, createdAt])
  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
}

// ─── G16 — Commerce ────────────────────────────────────────────────

/// A sellable package. Price mapping lives server-side; a client-supplied
/// amount is never authoritative.
model Offer {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  /// Provider price id (e.g. Stripe price_...).
  providerPriceId String?
  amountCents  Int      @default(0)
  currency     String   @default("usd")
  /// one-time | monthly | yearly
  interval     String   @default("monthly")
  /// JSON string[] — entitlement keys this offer grants.
  entitlements String   @default("[]")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Subscription {
  id          String    @id @default(cuid())
  clientId    String
  offerId     String?
  /// Provider subscription id.
  providerId  String?   @unique
  providerCustomerId String?
  /// incomplete | trialing | active | past-due | canceled
  status      String    @default("incomplete")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAt    DateTime?
  canceledAt  DateTime?
  /// C5 (`docs/analysis/client-portal.md` §30) — when this subscription FIRST
  /// went `past-due` (set once by `StripeWebhookService.onInvoiceFailed`, not
  /// bumped on later retries of the same grace window). Cleared back to null
  /// the moment the subscription is seen active/paid again. The grace-period
  /// sweep (`billing/payment-failure-sweep.service.ts`) reads this to decide
  /// whether Stripe's own retry window (`BILLING_GRACE_PERIOD_DAYS`, default
  /// 21d — the natural default per §30, not a bespoke schedule) has elapsed
  /// without the payment resolving; if so it suspends the owning Client.
  pastDueSince DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId, status])
  @@index([status, pastDueSince])
}

/// Raw provider events, stored for idempotency. A replayed webhook matches an
/// existing providerEventId and is ignored.
model PaymentEvent {
  id              String   @id @default(cuid())
  /// Provider's own event id — the replay guard.
  providerEventId String   @unique
  provider        String   @default("stripe")
  eventType       String
  /// Whether the signature verified. Unsigned events are stored as rejected,
  /// never acted on.
  signatureValid  Boolean  @default(false)
  /// pending | processed | ignored | rejected
  status          String   @default("pending")
  clientId        String?
  subscriptionId  String?
  amountCents     Int?
  currency        String?
  /// JSON — the raw payload.
  payload         String   @default("{}")
  error           String?
  receivedAt      DateTime @default(now())
  processedAt     DateTime?

  @@index([clientId])
  @@index([status])
}

/// What a client is actually allowed to use. Granted only from a verified
/// provider event, never from a checkout-return page visit.
model Entitlement {
  id         String    @id @default(cuid())
  clientId   String
  /// Feature key, e.g. "monitoring", "full-audit".
  key        String
  /// active | expired | revoked
  status     String    @default("active")
  /// The PaymentEvent that authorized it.
  grantedByEventId String?
  subscriptionId String?
  startsAt   DateTime  @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([clientId, key])
  @@index([clientId, status])
}

// ─── G17 — Export, retention, offboarding ──────────────────────────

model ExportRequest {
  id           String    @id @default(cuid())
  /// client | project
  scopeType    String
  scopeId      String
  requestedBy  String
  /// json | csv-bundle
  format       String    @default("json")
  /// JSON string[] — which sections were requested.
  sections     String    @default("[]")
  /// queued | running | ready | failed | expired
  status       String    @default("queued")
  storageKey   String?
  sizeBytes    Int?
  /// Download link lifetime. An export is scoped and expiring, not a permalink.
  expiresAt    DateTime?
  downloadedAt DateTime?
  /// Fields deliberately left out (credentials, tokens, other clients' data).
  omittedNote  String?
  error        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([scopeType, scopeId])
}

model RetentionPolicy {
  id            String   @id @default(cuid())
  /// observations | reports | messages | job-runs | activity | attachments
  resourceType  String   @unique
  retainDays    Int?
  /// delete | anonymize | archive
  action        String   @default("archive")
  enabled       Boolean  @default(false)
  lastRunAt     DateTime?
  updatedBy     String?
  updatedAt     DateTime @updatedAt
}

/// Offboarding is previewed before it executes: the preview lists the exact
/// resources affected so nothing cascades by surprise.
model OffboardingRun {
  id          String    @id @default(cuid())
  clientId    String
  /// preview | executing | completed | failed | cancelled
  status      String    @default("preview")
  /// JSON — { resourceType: count } the preview found.
  planned     String    @default("{}")
  /// JSON — { resourceType: count } actually acted on.
  executed    String    @default("{}")
  /// Whether public share links were revoked, kept, or explicitly retained.
  shareLinkPolicy String @default("revoke")
  /// Export produced before destruction, if any.
  exportRequestId String?
  requestedBy String
  confirmedBy String?
  confirmedAt DateTime?
  completedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId])
}

// ─── G18 — Capability readiness ────────────────────────────────────

/// Observed readiness of one provider/capability. Deliberately separates "an
/// env key exists" from "a real call succeeded recently" — an enabled button
/// must mean the latter.
model CapabilityStatus {
  id            String    @id @default(cuid())
  /// Stable key, e.g. "aeo.chatgpt", "serp.dataforseo", "google.gsc".
  key           String    @unique
  label         String
  category      String?
  /// Server config is present.
  configured    Boolean   @default(false)
  /// A real call has succeeded at least once.
  verified      Boolean   @default(false)
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastError     String?
  /// Whether this is running against fixtures rather than the real provider.
  mockMode      Boolean   @default(false)
  /// JSON string[] — supported engine/provider ids.
  supports      String    @default("[]")
  /// JSON string[] — capability keys that must be ready first.
  prerequisites String    @default("[]")
  /// JSON — rate limits, max batch size, etc.
  limits        String    @default("{}")
  checkedAt     DateTime  @default(now())

  @@index([category])
}

// ─── G20 — Organization, branding, templates ───────────────────────

/// Versioned so a released report can pin the branding it was published under.
model OrganizationSettings {
  id             String   @id @default(cuid())
  version        Int      @default(1)
  displayName    String   @default("Cailyx")
  logoUrl        String?
  /// Hex, applied as a CSS custom property override.
  primaryColor   String?
  supportEmail   String?
  supportName    String?
  timezone       String   @default("UTC")
  /// Default service tier for a new engagement.
  defaultTier    String   @default("retainer")
  /// Hours a review is expected to take.
  reviewSlaHours Int      @default(48)
  /// Whether operators may create anyone-with-the-link report shares.
  allowPublicShare Boolean @default(true)
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([version])
}

/// A reusable report layout. Snapshotted into a released report so a later
/// template edit cannot retroactively change a delivered document.
model ReportTemplate {
  id          String   @id @default(cuid())
  name        String
  /// monthly | quarterly | diagnostic | scorecard
  reportType  String   @default("monthly")
  /// JSON — { key, title, include, order }[] section configuration.
  sections    String   @default("[]")
  version     Int      @default(1)
  isDefault   Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([reportType])
}

/// A reusable checklist for onboarding or a cycle. Applying it copies rows;
/// editing the template never mutates an already-committed cycle.
model ProgramTemplate {
  id          String   @id @default(cuid())
  name        String
  /// onboarding | cycle | offboarding
  kind        String   @default("cycle")
  description String?
  /// JSON — { title, category, discipline, role, estimateHours, offsetDays }[]
  items       String   @default("[]")
  version     Int      @default(1)
  active      Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, active])
}
